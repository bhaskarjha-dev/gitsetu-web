---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="404: Identity Boundary Not Found | GitSetu" 
  description="The requested path is outside of registered workspace boundaries. Return to safety with GitSetu."
>
  <Navbar />
  
  <main id="main-content" class="error-page">
    <div class="error-container container">
      <!-- Cyber Glowing 404 Badge -->
      <div class="error-badge">
        <span class="badge-dot error-dot"></span>
        <span class="badge-text">Boundary Violation • Error 404</span>
      </div>

      <h1 class="error-title">
        Workspace <span class="text-gradient">Out of Scope.</span>
      </h1>
      
      <p class="error-subtitle">
        The requested URL has no matching <code class="code-inline">includeIf</code> directive in the identity fabric. Fail-closed security has halted navigation to prevent profile crossover.
      </p>

      <!-- Interactive Simulated Terminal Box -->
      <div class="error-terminal">
        <div class="terminal-bar">
          <div class="traffic-lights">
            <span class="terminal-dot red"></span>
            <span class="terminal-dot yellow"></span>
            <span class="terminal-dot green"></span>
          </div>
          <span class="terminal-title">gitsetu guard — path-audit</span>
        </div>
        <div class="terminal-body">
          <div class="terminal-line">
            <span class="term-prompt">❯</span>
            <span class="term-cmd">gitsetu route --resolve current_path</span>
          </div>
          <div class="terminal-line term-error">
            <span>✘ [404] No registered profile matches this URI namespace.</span>
          </div>
          <div class="terminal-line term-warn">
            <span>⚡ Fail-Closed Guard: Isolation active. Zero credentials exposed.</span>
          </div>
          <div class="terminal-line term-success">
            <span>✔ Recommended action: Return to trusted root directory.</span>
          </div>
        </div>
      </div>

      <!-- Quick Action Cards Grid -->
      <div class="action-grid">
        <a href="/" class="action-card primary-action">
          <div class="action-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
          </div>
          <div class="action-details">
            <span class="action-title">Return Home</span>
            <span class="action-desc">Back to gitsetu.bhaskarjha.dev</span>
          </div>
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>

        <a href="/docs/getting-started/quickstart" class="action-card">
          <div class="action-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          </div>
          <div class="action-details">
            <span class="action-title">Quickstart Guide</span>
            <span class="action-desc">Configure identities in under 3 minutes</span>
          </div>
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>

        <a href="/docs/getting-started/installation" class="action-card">
          <div class="action-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          </div>
          <div class="action-details">
            <span class="action-title">Installation</span>
            <span class="action-desc">WinGet, Homebrew, Scoop, AUR, Nix</span>
          </div>
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>

        <a href="/docs" class="action-card">
          <div class="action-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          </div>
          <div class="action-details">
            <span class="action-title">All Documentation</span>
            <span class="action-desc">Explore 24 architecture &amp; CLI guides</span>
          </div>
          <svg class="arrow-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .error-page {
    min-height: calc(100vh - var(--nav-height));
    display: flex;
    align-items: center;
    justify-content: center;
    padding-top: calc(var(--nav-height) + 2rem);
    padding-bottom: 4rem;
    position: relative;
    overflow: hidden;
  }

  .error-container {
    max-width: 780px;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .error-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(239, 68, 68, 0.08);
    border: 1px solid rgba(239, 68, 68, 0.25);
    border-radius: var(--radius-full);
    padding: 4px 14px;
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: #fca5a5;
    margin-bottom: 1.5rem;
    backdrop-filter: blur(8px);
  }

  .error-dot {
    background: var(--color-error);
    box-shadow: 0 0 8px var(--color-error);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .error-title {
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.1;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .error-subtitle {
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    color: var(--text-secondary);
    max-width: 620px;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .code-inline {
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 6px;
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--accent-primary);
  }

  /* Error Terminal Display */
  .error-terminal {
    width: 100%;
    max-width: 640px;
    background: var(--bg-surface-1, #080808);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6);
    overflow: hidden;
    margin-bottom: 2.5rem;
    text-align: left;
    font-family: var(--font-mono);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid var(--border-subtle);
  }

  .traffic-lights {
    display: flex;
    gap: 6px;
    margin-right: 12px;
  }

  .terminal-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: #ef4444; }
  .terminal-dot.yellow { background: #f59e0b; }
  .terminal-dot.green { background: #10b981; }

  .terminal-title {
    font-size: 11px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .terminal-body {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    line-height: 1.5;
  }

  .terminal-line {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .term-prompt {
    color: var(--accent-primary);
    font-weight: 700;
  }

  .term-cmd {
    color: #ffffff;
  }

  .term-error {
    color: #f87171;
  }

  .term-warn {
    color: #fbbf24;
  }

  .term-success {
    color: #34d399;
  }

  /* Action Grid */
  .action-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    width: 100%;
    max-width: 640px;
  }

  .action-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: var(--text-primary);
    transition: all 0.2s ease;
    text-align: left;
  }

  .action-card:hover {
    border-color: var(--accent-primary);
    background: rgba(0, 196, 204, 0.05);
    transform: translateY(-2px);
  }

  .action-card.primary-action {
    background: rgba(0, 196, 204, 0.08);
    border-color: rgba(0, 196, 204, 0.3);
  }

  .action-card.primary-action:hover {
    background: rgba(0, 196, 204, 0.15);
    border-color: var(--accent-primary);
  }

  .action-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .action-details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
  }

  .action-title {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-heading);
  }

  .action-desc {
    font-size: 12px;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .arrow-icon {
    color: var(--text-muted);
    flex-shrink: 0;
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .action-card:hover .arrow-icon {
    color: var(--accent-primary);
    transform: translateX(3px);
  }

  @media (max-width: 640px) {
    .action-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
