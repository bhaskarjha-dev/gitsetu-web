---
const currentPath = '/' + Astro.url.pathname.replace(/^\/|\/$/g, '');
const isActive = (path: string) => {
  const normPath = '/' + path.replace(/^\/|\/$/g, '');
  return currentPath === normPath ? 'active' : '';
};
---

<footer class="site-footer" role="contentinfo">
  <div class="footer-container container">
    <!-- Developer Status Bar Strip -->
    <div class="footer-status-bar">
      <div class="status-group">
        <div class="status-pill brand">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 3a3 3 0 0 0-3 3v12a3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3H6a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3V6a3 3 0 0 0-3-3 3 3 0 0 0-3 3s0-3 3-3h12a3 3 0 0 0 3 3"></path></svg>
          <span>GitSetu v1.0.0 GA</span>
        </div>
        <div class="status-pill branch">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>
          <span>main*</span>
        </div>
        <div class="status-pill secure">
          <span class="pulse-dot" aria-hidden="true"></span>
          <span>Zero-Trust: Active</span>
        </div>
      </div>
      <div class="status-meta">
        <span>Pure Bash 3.2+</span>
        <span class="meta-dot">•</span>
        <span>Zero Dependencies</span>
        <span class="meta-dot">•</span>
        <span>POSIX &amp; Windows Native</span>
      </div>
    </div>

    <!-- Main Navigation Grid -->
    <div class="footer-grid">
      <div class="footer-col">
        <h3 class="col-title">Product</h3>
        <ul class="col-links">
          <li><a href="/docs/getting-started/quickstart" class={isActive('/docs/getting-started/quickstart')}>Quickstart</a></li>
          <li><a href="/docs/getting-started/installation" class={isActive('/docs/getting-started/installation')}>Installation</a></li>
          <li><a href="/docs/overview/architecture" class={isActive('/docs/overview/architecture')}>Architecture</a></li>
          <li><a href="/docs/reference/cli-commands" class={isActive('/docs/reference/cli-commands')}>CLI Reference</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="col-title">Resources</h3>
        <ul class="col-links">
          <li><a href="/docs">Documentation</a></li>
          <li><a href="https://github.com/bhaskarjha-dev/gitsetu" target="_blank" rel="noopener">GitHub Repository</a></li>
          <li><a href="/docs/reference/contributing" class={isActive('/docs/reference/contributing')}>Contributing</a></li>
          <li><a href="/docs/enterprise/product-roadmap" class={isActive('/docs/enterprise/product-roadmap')}>Roadmap</a></li>
          <li><a href="/llms.txt" target="_blank" rel="noopener">LLM API (llms.txt)</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3 class="col-title">Project</h3>
        <ul class="col-links">
          <li><a href="/docs/enterprise/security-privacy" class={isActive('/docs/enterprise/security-privacy')}>Security &amp; Privacy</a></li>
          <li><a href="https://github.com/bhaskarjha-dev/gitsetu/blob/main/LICENSE" target="_blank" rel="noopener">MIT License</a></li>
          <li><a href="/docs/reference/faq" class={isActive('/docs/reference/faq')}>FAQ</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Attribution & Copyright -->
    <div class="footer-bottom">
      <div class="bottom-brand">
        <svg width="20" height="20" viewBox="0 0 100 100" class="footer-logo" aria-hidden="true">
          <defs>
            <linearGradient id="footer-grad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" stop-color="#00c4cc" />
              <stop offset="100%" stop-color="#0ea5e9" />
            </linearGradient>
          </defs>
          <rect width="100" height="100" rx="20" fill="#0a0e17" />
          <path d="M 30 50 Q 50 20 70 50 T 70 50" fill="none" stroke="url(#footer-grad)" stroke-width="8" stroke-linecap="round" />
          <path d="M 30 70 L 30 50 M 70 70 L 70 50" stroke="url(#footer-grad)" stroke-width="8" stroke-linecap="round" />
        </svg>
        <span>Zero-dependency Git multi-identity orchestration engine.</span>
      </div>
      <div class="bottom-copyright">
        <span>© 2026 Bhaskar Jha. Distributed under the MIT License.</span>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    width: 100%;
    background-color: var(--bg-surface-1, #080808);
    border-top: 1px solid var(--border-subtle);
    padding-top: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    z-index: 10;
    color: var(--text-secondary);
  }

  .footer-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xl);
  }

  /* Status Bar Strip */
  .footer-status-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: var(--space-sm) var(--space-md);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .status-group {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 8px;
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-secondary);
  }

  .status-pill.brand {
    color: var(--text-heading);
    font-weight: 600;
  }

  .status-pill.secure {
    color: var(--color-success);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
  }

  .pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 8px var(--color-success);
    animation: pulseGlow 2s infinite ease-in-out;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .status-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
    font-size: var(--text-xs);
  }

  .meta-dot {
    opacity: 0.4;
  }

  /* Navigation Grid */
  .footer-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
  }

  .col-title {
    font-size: var(--text-sm);
    font-family: var(--font-display);
    color: var(--text-heading);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
    font-weight: 600;
  }

  .col-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .col-links a {
    color: var(--text-muted);
    font-size: var(--text-sm);
    transition: color var(--transition-fast), transform var(--transition-fast);
    display: inline-block;
    padding: 2px 0;
  }

  .col-links a:hover {
    color: var(--accent-primary);
    transform: translateX(2px);
  }

  .col-links a.active {
    color: var(--accent-primary);
    font-weight: 500;
  }

  /* Bottom Row */
  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--border-subtle);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .bottom-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .footer-logo {
    flex-shrink: 0;
  }

  /* Responsive Behavior (375px, 768px, 1440px) */
  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
  }

  @media (max-width: 600px) {
    .site-footer {
      padding-top: var(--space-xl);
      padding-bottom: var(--space-xl);
    }

    .footer-status-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
    }

    .status-meta {
      font-size: 0.72rem;
      flex-wrap: wrap;
    }

    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .col-links a {
      padding: 6px 0; /* Enhanced touch targets for mobile */
      font-size: var(--text-base);
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-sm);
    }
  }
</style>
