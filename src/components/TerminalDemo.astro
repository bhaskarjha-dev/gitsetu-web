---
import '@xterm/xterm/css/xterm.css';
---

<gitsetu-terminal>
  <div class="terminal-window" aria-label="Interactive Terminal showing GitSetu setup">
    <div class="terminal-header">
      <div class="traffic-lights">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
      </div>
      <span class="terminal-title">gitsetu — bash</span>
      
      <div class="terminal-modes">
        <button class="mode-btn active" id="mode-demo" type="button">Auto-Demo</button>
        <button class="mode-btn" id="mode-interactive" type="button">Interactive</button>
      </div>
    </div>
    
    <div class="terminal-body">
      <div id="terminal-container" style="height: 340px; width: 100%; position: relative;">
        <!-- Xterm.js will mount here -->
      </div>
    </div>
    
    <div class="terminal-hint" id="terminal-hint">
      Click terminal to take control
    </div>
  </div>
</gitsetu-terminal>

<script>
  class GitsetuTerminal extends HTMLElement {
    term: any = null;
    demoTimeout: any = null;
    processingInterval: any = null;
    abortController: AbortController | null = null;
    resizeObserver: ResizeObserver | null = null;
    
    isAutoDemo = true;
    isDemoRunning = false;
    setupState = 'IDLE';
    currentLine = '';
    profileName = '';
    
    prompt = '\x1b[1;32m~\x1b[0m \x1b[1;36m❯\x1b[0m ';

    connectedCallback() {
      // First Principle: Xterm.js strictly requires painted physical dimensions to boot.
      // We check if dimensions are already available (instant paint) or observe until ready.
      const container = this.querySelector('#terminal-container') as HTMLElement;
      if (!container) return;

      const initIfReady = () => {
        if (container.offsetWidth > 0 && container.offsetHeight > 0) {
          if (this.resizeObserver) {
            this.resizeObserver.disconnect();
            this.resizeObserver = null;
          }
          if (!this.term && !this.abortController) {
            this.setup(container);
          }
        }
      };

      if (container.offsetWidth > 0 && container.offsetHeight > 0) {
        initIfReady();
      } else {
        this.resizeObserver = new ResizeObserver(() => {
          initIfReady();
        });
        this.resizeObserver.observe(container);
      }
    }

    setup(container: HTMLElement) {
      this.initTerminal(container).then(() => {
        if (this.isAutoDemo && !this.isDemoRunning) {
          this.runAutoDemo();
        }
      });
    }

    disconnectedCallback() {
      this.cleanup();
    }

    cleanup() {
      if (this.resizeObserver) {
        this.resizeObserver.disconnect();
        this.resizeObserver = null;
      }
      if (this.abortController) {
        this.abortController.abort();
        this.abortController = null;
      }
      if (this.demoTimeout) {
        clearTimeout(this.demoTimeout);
        this.demoTimeout = null;
      }
      if (this.processingInterval) {
        clearInterval(this.processingInterval);
        this.processingInterval = null;
      }
      if (this.term) {
        this.term.dispose();
        this.term = null;
      }
      this.isDemoRunning = false;
      this.setupState = 'IDLE';
      this.currentLine = '';
      this.profileName = '';
      const container = this.querySelector('#terminal-container');
      if (container) container.innerHTML = '';
    }

    async initTerminal(container: HTMLElement) {
      const demoBtn = this.querySelector('#mode-demo') as HTMLElement;
      const interactiveBtn = this.querySelector('#mode-interactive') as HTMLElement;
      const hint = this.querySelector('#terminal-hint') as HTMLElement;
      
      this.cleanup();
      container.innerHTML = '';

      // Create new session controller AFTER cleanup
      const abortController = new AbortController();
      this.abortController = abortController;
      const currentSignal = abortController.signal;

      // Resilient dynamic import handling ESM & CJS default interop
      let TerminalClass: any;
      try {
        const mod: any = await import('@xterm/xterm');
        TerminalClass = mod.Terminal || (mod.default && (mod.default.Terminal || mod.default));
      } catch (err) {
        console.warn('Failed to load xterm module:', err);
        return;
      }

      if (!this.isConnected || currentSignal.aborted) {
        return;
      }

      this.term = new TerminalClass({
        cols: 70, // Fixed safe column count that fits the 600px container perfectly
        rows: 15,
        cursorBlink: true,
        fontFamily: 'monospace', // Fallback font until custom font loads
        fontSize: 13,
        theme: {
          background: 'transparent',
          foreground: '#ededed',
          cursor: '#00c4cc',
          black: '#000000',
          red: '#ef4444',
          green: '#10b981',
          yellow: '#f59e0b',
          blue: '#0ea5e9',
          magenta: '#a1a1aa',
          cyan: '#00c4cc',
          white: '#ffffff'
        },
        allowTransparency: true,
        disableStdin: false
      });

      this.term.open(container);
      this.term.reset();
      this.term.clearTextureAtlas();

      // Dynamically upgrade font once loaded
      if (typeof document !== 'undefined' && document.fonts) {
        document.fonts.load('13px "JetBrains Mono"').then(() => {
          if (this.term && !currentSignal.aborted) {
            this.term.options.fontFamily = '"JetBrains Mono", monospace';
            this.term.clearTextureAtlas();
          }
        }).catch(() => {});
      }

      // --- HYBRID LOGIC & MODE SWITCHING ---

      demoBtn?.addEventListener('click', () => {
        if (this.isAutoDemo) return;
        this.isAutoDemo = true;
        this.isDemoRunning = false;
        
        demoBtn.classList.add('active');
        interactiveBtn?.classList.remove('active');
        if (hint) hint.style.opacity = '1';
        
        if (this.term) {
          this.term.reset();
          this.term.clearTextureAtlas();
        }
        
        this.setupState = 'IDLE';
        this.currentLine = '';
        this.profileName = '';
        
        if (this.demoTimeout) clearTimeout(this.demoTimeout);
        if (this.processingInterval) clearInterval(this.processingInterval);
        
        this.runAutoDemo();
      }, { signal: currentSignal });

      interactiveBtn?.addEventListener('click', () => {
        if (!this.isAutoDemo) {
          if (this.term) this.term.focus();
          return;
        }
        this.isAutoDemo = false;
        this.isDemoRunning = false;
        
        demoBtn?.classList.remove('active');
        interactiveBtn.classList.add('active');
        if (hint) hint.style.opacity = '0';
        
        if (this.demoTimeout) clearTimeout(this.demoTimeout);
        if (this.processingInterval) clearInterval(this.processingInterval);
        
        if (this.term) {
          this.term.reset();
          this.term.clearTextureAtlas();
          this.term.write('\x1b[3mSandbox active. Type \x1b[33mgitsetu status\x1b[0m\x1b[3m, \x1b[33msetup\x1b[0m\x1b[3m, or \x1b[33mdoctor\x1b[0m\x1b[3m.\x1b[0m\r\n\r\n');
          this.term.write(this.prompt);
          this.term.focus();
        }
      }, { signal: currentSignal });

      container.addEventListener('click', () => {
        if (this.isAutoDemo) {
          interactiveBtn?.click();
        } else if (this.term) {
          this.term.focus();
        }
      }, { signal: currentSignal });

      // --- INTERACTIVE ENGINE ---

      this.term.onData((e: string) => {
        if (this.isAutoDemo) {
          interactiveBtn?.click();
          return;
        }
        if (!this.term) return;

        // Ignore arrow keys / escape sequences for now
        if (e === '\x1b[A' || e === '\x1b[B' || e === '\x1b[C' || e === '\x1b[D') return;

        switch (e) {
          case '\r': // Enter
            this.term.write('\r\n');
            this.handleCommand(this.currentLine.trim());
            this.currentLine = '';
            break;
          case '\x7F': // Backspace (DEL)
          case '\x08': // Backspace (BS)
            if (this.currentLine.length > 0) {
              this.currentLine = this.currentLine.substring(0, this.currentLine.length - 1);
              this.term.write('\b \b');
            }
            break;
          case '\x03': // Ctrl+C
            this.term.write('^C\r\n');
            this.currentLine = '';
            this.setupState = 'IDLE';
            if (this.processingInterval) clearInterval(this.processingInterval);
            this.term.write(this.prompt);
            break;
          default:
            if (e >= String.fromCharCode(32) && e <= String.fromCharCode(126)) {
              this.currentLine += e;
              this.term.write(e);
            }
        }
      });
    }

    async wait(ms: number): Promise<boolean> {
      return new Promise<boolean>((resolve) => { 
        if (this.abortController?.signal.aborted || !this.isAutoDemo) {
          return resolve(false);
        }
        
        let timer: any = null;

        const onAbort = () => {
          if (timer) clearTimeout(timer);
          resolve(false);
        };
        
        this.abortController?.signal.addEventListener('abort', onAbort, { once: true });
        
        timer = setTimeout(() => {
          this.abortController?.signal.removeEventListener('abort', onAbort);
          if (!this.isAutoDemo || this.abortController?.signal.aborted) {
            resolve(false);
          } else {
            resolve(true);
          }
        }, ms);

        this.demoTimeout = timer;
      });
    }

    async typeText(text: string, speed = 45): Promise<boolean> {
      for (let i = 0; i < text.length; i++) {
        if (!this.isAutoDemo || !this.term || this.abortController?.signal.aborted) {
          this.isDemoRunning = false;
          return false;
        }
        this.term.write(text.charAt(i));
        const continued = await this.wait(speed);
        if (!continued) {
          this.isDemoRunning = false;
          return false;
        }
      }
      return true;
    }

    simulateProcessing(callback: () => void) {
      if (!this.term) return;
      let dots = 0;
      this.term.write('  \x1b[36mGenerating cryptographic keys\x1b[0m');
      this.processingInterval = setInterval(() => {
        if (!this.term || this.abortController?.signal.aborted) {
          if (this.processingInterval) clearInterval(this.processingInterval);
          this.processingInterval = null;
          return;
        }
        this.term.write('.');
        dots++;
        if (dots >= 3) {
          if (this.processingInterval) clearInterval(this.processingInterval);
          this.processingInterval = null;
          this.term.write('\x1b[2K\r'); 
          callback();
        }
      }, 350);
    }

    handleCommand(cmd: string) {
      if (!this.term) return;
      const lower = cmd.toLowerCase();

      if (this.setupState === 'IDLE') {
        if (lower === 'gitsetu setup --auto' || lower === 'gitsetu init --auto' || lower === 'gitsetu setup -y' || lower === 'setup --auto' || lower === 'init --auto') {
          this.term.write('  \x1b[1;36mGitSetu Zero-Prompt Auto-Discovery v1.0.0\x1b[0m\r\n');
          this.term.write('  🔍 \x1b[36mScanning local workstation...\x1b[0m\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m Active Git Author: \x1b[33mme@bhaskarjha.dev\x1b[0m\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m Discovered 2 SSH keys in ~/.ssh/ (\x1b[33mid_ed25519_work\x1b[0m, \x1b[33mid_ed25519_personal\x1b[0m)\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m Discovered 2 workspace folders (\x1b[33m~/work\x1b[0m, \x1b[33m~/personal\x1b[0m)\r\n');
          this.term.write('  ⚡ \x1b[36mComposing & applying zero-trust blueprint...\x1b[0m\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m [work] ➔ ~/work/ (dev@company.com, ed25519_work)\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m [personal] ➔ [Global Fallback] (me@bhaskarjha.dev, ed25519_personal)\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m OpenSSH Include isolation injected\r\n');
          this.term.write('  \x1b[1;32m✨ Provisioned 2 profiles in 0.8s with zero prompts! (v1.0.0 GA)\x1b[0m\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'gitsetu setup' || lower === 'gitsetu init' || lower === 'setup' || lower === 'init') {
          this.term.write('  Profile name: ');
          this.setupState = 'PROFILE_NAME';
        } else if (lower === 'gitsetu status' || lower === 'status') {
          this.term.write('  \x1b[1;36mGitSetu Profile Registry (v1.0.0 GA)\x1b[0m\r\n');
          this.term.write('  1) [\x1b[32mwork\x1b[0m] dev@company.com\r\n');
          this.term.write('     Dir: \x1b[33m~/work\x1b[0m (Provisioned)\r\n');
          this.term.write('     Key: ~/.ssh/id_ed25519_work\r\n');
          this.term.write('  2) [\x1b[32mpersonal\x1b[0m] me@bhaskarjha.dev\r\n');
          this.term.write('     Dir: [Global Fallback]\r\n');
          this.term.write('     Key: ~/.ssh/id_ed25519_personal\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m Zero-Trust Identity Guard: \x1b[1;32mEnforced\x1b[0m\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'gitsetu doctor' || lower === 'doctor') {
          this.term.write('  \x1b[1;36mGitSetu Diagnostic Engine v1.0.0 GA\x1b[0m\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m Git 2.45+ (includeIf conditional routing)\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m OpenSSH 7.3+ (Include directive verified)\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m POSIX Shell: Bash 3.2+ compatible\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m Directory routing: Longest-match active\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m 32 regression test suites: 100% green\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m 24-phase Windows Sandbox audit: 70/70 checks passed\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'gitsetu --version' || lower === 'gitsetu -v' || lower === 'gitsetu version' || lower === 'version') {
          this.term.write('  gitsetu v1.0.0 (Day 1 General Availability)\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'gitsetu --help' || lower === 'gitsetu help' || lower === 'gitsetu' || lower === 'help') {
          this.term.write('  \x1b[1mGitSetu\x1b[0m — Zero-Dependency Git Identity Manager v1.0.0 GA\r\n');
          this.term.write('  Usage: gitsetu <command> [arguments]\r\n\r\n');
          this.term.write('  Commands:\r\n');
          this.term.write('    setup [--auto]  Interactive dashboard or zero-prompt auto-discovery\r\n');
          this.term.write('    init [--auto]   Alias for setup\r\n');
          this.term.write('    status          Inspect registered profiles and active scope\r\n');
          this.term.write('    doctor          Audit runtime dependencies and configuration\r\n');
          this.term.write('    guard           Pre-commit identity verification\r\n');
          this.term.write('    vault           AES-256 encrypted profile backup/restore\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'clear' || lower === 'cls') {
          this.term.reset();
          this.term.write(this.prompt);
        } else if (lower === 'ls' || lower === 'dir') {
          this.term.write('  personal/  work/\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'pwd') {
          this.term.write('  /home/developer\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'whoami') {
          this.term.write('  dev\r\n\r\n');
          this.term.write(this.prompt);
        } else if (cmd !== '') {
          this.term.write(`  \x1b[31mbash: command not found:\x1b[0m ${cmd}\r\n\r\n${this.prompt}`);
        } else {
          this.term.write(this.prompt);
        }
      } else if (this.setupState === 'PROFILE_NAME') {
        this.profileName = cmd || 'work';
        this.term.write(`  Git email: `);
        this.setupState = 'GIT_EMAIL';
      } else if (this.setupState === 'GIT_EMAIL') {
        this.term.write(`  Directory: `);
        this.setupState = 'DIRECTORY';
      } else if (this.setupState === 'DIRECTORY') {
        const targetDir = cmd || '~/work';
        this.setupState = 'PROCESSING';
        this.simulateProcessing(() => {
          if (!this.term) return;
          this.term.write(`  \x1b[32m✔\x1b[0m Workspace provisioned: \x1b[33m${targetDir}\x1b[0m (mkdir -p)\r\n`);
          this.term.write(`  \x1b[32m✔\x1b[0m SSH key generated: \x1b[33m~/.ssh/id_ed25519_${this.profileName}\x1b[0m\r\n`);
          this.term.write(`  \x1b[32m✔\x1b[0m Git config written: \x1b[33m~/.config/gitsetu/profiles/${this.profileName}.gitconfig\x1b[0m\r\n`);
          this.term.write(`  \x1b[32m✔\x1b[0m OpenSSH config updated: \x1b[33m~/.ssh/config\x1b[0m\r\n`);
          this.term.write(`  \x1b[32m✔\x1b[0m Profile '${this.profileName}' created successfully (v1.0.0 GA)\r\n\r\n`);
          this.term.write(this.prompt);
          this.setupState = 'IDLE';
        });
      }
    }

    async runAutoDemo() {
      if (this.isDemoRunning || !this.isAutoDemo || !this.term || this.abortController?.signal.aborted) return;
      this.isDemoRunning = true;
      this.term.write(this.prompt);
      
      const checkAndContinue = async (ms: number) => {
        if (!this.isAutoDemo || !this.term || this.abortController?.signal.aborted) return false;
        return await this.wait(ms);
      };

      if (!await checkAndContinue(1000)) { this.isDemoRunning = false; return; }
      if (!(await this.typeText('gitsetu setup', 60))) { this.isDemoRunning = false; return; }
      
      if (!await checkAndContinue(400)) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  Profile name: ');
      
      if (!await checkAndContinue(600)) { this.isDemoRunning = false; return; }
      if (!(await this.typeText('work', 80))) { this.isDemoRunning = false; return; }
      
      if (!await checkAndContinue(400)) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  Git email: ');
      
      if (!await checkAndContinue(500)) { this.isDemoRunning = false; return; }
      if (!(await this.typeText('dev@company.com', 50))) { this.isDemoRunning = false; return; }
      
      if (!await checkAndContinue(400)) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  Directory: ');
      
      if (!await checkAndContinue(500)) { this.isDemoRunning = false; return; }
      if (!(await this.typeText('~/work', 70))) { this.isDemoRunning = false; return; }
      
      if (!await checkAndContinue(500)) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  \x1b[36mGenerating cryptographic keys\x1b[0m');
      
      for (let i = 0; i < 3; i++) {
        if (!await checkAndContinue(400)) { this.isDemoRunning = false; return; }
        this.term.write('.');
      }
      
      if (!await checkAndContinue(200)) { this.isDemoRunning = false; return; }
      this.term.write('\x1b[2K\r'); // Erase line
      
      this.term.write('  \x1b[32m✔\x1b[0m Workspace provisioned: \x1b[33m~/work\x1b[0m (mkdir -p)\r\n');
      if (!await checkAndContinue(200)) { this.isDemoRunning = false; return; }

      this.term.write('  \x1b[32m✔\x1b[0m SSH key generated: \x1b[33m~/.ssh/id_ed25519_work\x1b[0m\r\n');
      if (!await checkAndContinue(200)) { this.isDemoRunning = false; return; }
      
      this.term.write('  \x1b[32m✔\x1b[0m Git config written: \x1b[33m~/.config/gitsetu/profiles/work.gitconfig\x1b[0m\r\n');
      if (!await checkAndContinue(200)) { this.isDemoRunning = false; return; }
      
      this.term.write('  \x1b[32m✔\x1b[0m OpenSSH config updated: \x1b[33m~/.ssh/config\x1b[0m\r\n');
      if (!await checkAndContinue(200)) { this.isDemoRunning = false; return; }
      
      this.term.write('  \x1b[32m✔\x1b[0m Profile \'work\' created successfully (v1.0.0 GA)\r\n\r\n');
      if (!await checkAndContinue(500)) { this.isDemoRunning = false; return; }
      
      this.term.write(this.prompt);
      this.isDemoRunning = false;

      // Clean loop after 7 seconds if still in Auto-Demo mode
      if (await checkAndContinue(7000)) {
        if (this.isAutoDemo && !this.isDemoRunning && this.term && !this.abortController?.signal.aborted) {
          this.term.reset();
          this.term.clearTextureAtlas();
          this.runAutoDemo();
        }
      }
    }
  }

  // Register the custom element once
  if (typeof window !== 'undefined' && !customElements.get('gitsetu-terminal')) {
    customElements.define('gitsetu-terminal', GitsetuTerminal);
  }
</script>

<style>
  .terminal-window {
    width: 100%;
    margin: 0 auto;
    background: rgba(5, 5, 5, 0.4);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 30px 60px -12px rgba(0, 0, 0, 1), 0 0 0 1px rgba(255, 255, 255, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    position: relative;
    text-align: left; /* Fix inherited text-align: center from Hero.astro on mobile */
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--border-subtle);
  }

  .traffic-lights {
    position: absolute;
    left: 16px;
    display: flex;
    gap: 8px;
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: #ef4444; }
  .terminal-dot.yellow { background: #f59e0b; }
  .terminal-dot.green { background: #10b981; }

  .terminal-title {
    color: var(--text-muted);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  .terminal-modes {
    position: absolute;
    right: 16px;
    display: flex;
    gap: 4px;
    background: rgba(255,255,255,0.05);
    padding: 2px;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .mode-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 10px;
    font-family: var(--font-sans);
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .mode-btn:hover {
    color: var(--text-primary);
  }

  .mode-btn.active {
    background: rgba(255,255,255,0.1);
    color: var(--text-primary);
  }

  .terminal-body {
    padding: var(--space-md);
    background: transparent;
    cursor: text;
    overflow-x: auto; /* Handle fixed 70 cols on small screens safely */
