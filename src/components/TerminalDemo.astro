---
import '@xterm/xterm/css/xterm.css';
---

<gitsetu-terminal tabindex="0" role="region" aria-label="Interactive Terminal showing GitSetu setup">
  <div class="terminal-window">
    <div class="terminal-header">
      <div class="traffic-lights" aria-hidden="true">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
      </div>
      <span class="terminal-title">gitsetu — bash</span>
      
      <div class="terminal-modes" role="toolbar" aria-label="Terminal Mode Controls">
        <button class="mode-btn active" id="mode-demo" type="button" aria-pressed="true">Auto-Demo</button>
        <button class="mode-btn" id="mode-interactive" type="button" aria-pressed="false">Interactive</button>
      </div>
    </div>
    
    <div class="terminal-body">
      <div id="terminal-container" style="height: 330px; width: 100%; position: relative; overflow: hidden;">
        <!-- Static SSR Placeholder for Instant First Paint (LCP) & Zero Initial JS -->
        <div class="terminal-placeholder" id="terminal-placeholder" aria-hidden="true">
          <div class="terminal-placeholder-line">
            <span class="ph-tilde">~</span> <span class="ph-arrow">❯</span> <span class="ph-cursor"></span>
          </div>
        </div>
      </div>
    </div>
    
    <div class="terminal-hint" id="terminal-hint" aria-live="polite">
      Click terminal or press Tab to take control
    </div>
  </div>
</gitsetu-terminal>

<script>
  import { Terminal } from '@xterm/xterm';
  import { FitAddon } from '@xterm/addon-fit';

  /**
   * GitSetu Interactive Terminal Web Component
   * Features:
   * 1. Box-Muller Gaussian human keystroke timing (mean ~65ms, stdDev >= 30.0ms + hesitation)
   * 2. ANSI color sequences (yellow prompts, green success, red Pre-Commit Guard mismatch)
   * 3. Non-destructive click & focus response (tabindex="0", active cursor, preserves buffer)
   * 4. Static bundled Xterm & FitAddon with zero dynamic fetch failures and instant auto-start
   * 5. Dynamic responsive fitting via @xterm/addon-fit across mobile and desktop
   * 6. Reduced motion accessibility (prefers-reduced-motion immediate rendering)
   */
  class GitsetuTerminal extends HTMLElement {
    term: Terminal | null = null;
    fitAddon: FitAddon | null = null;
    resizeObserver: ResizeObserver | null = null;
    demoTimeout: any = null;
    processingInterval: any = null;
    abortController: AbortController | null = null;
    
    isAutoDemo = true;
    isDemoRunning = false;
    isBooted = false;
    isBooting = false;
    pendingInteractive = false;
    
    setupState = 'IDLE';
    currentLine = '';
    profileName = '';
    
    prompt = '\x1b[1;32m~\x1b[0m \x1b[1;36m❯\x1b[0m ';
    
    // Keystroke timing history for empirical Box-Muller variance guarantee
    timingHistory: number[] = [];

    getResponsiveFontSize(): number {
      const container = this.querySelector('#terminal-container') as HTMLElement;
      const width = container ? container.getBoundingClientRect().width : this.getBoundingClientRect().width;
      if (width > 0 && width < 400) return 11;
      if (width > 0 && width < 540) return 12;
      return 13;
    }

    connectedCallback() {
      if (!this.hasAttribute('tabindex')) {
        this.setAttribute('tabindex', '0');
      }

      // Keyboard navigation (Tab focus + Enter/Space to take control)
      this.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          if (this.isBooting) {
            this.pendingInteractive = true;
          } else if (!this.isBooted) {
            this.boot(true);
          } else if (this.isAutoDemo) {
            this.pauseAutoDemoForInteraction();
          }
        }
      });

      // Capture interaction intent during boot window
      this.addEventListener('click', () => {
        if (this.isBooting) {
          this.pendingInteractive = true;
        }
      });

      // Reliable auto-start: boot immediately once layout renders container dimensions
      requestAnimationFrame(() => {
        if (this.isConnected && !this.isBooted && !this.isBooting) {
          this.boot(false);
        }
      });
    }

    disconnectedCallback() {
      this.cleanup();
    }

    cleanup() {
      if (this.resizeObserver) {
        this.resizeObserver.disconnect();
        this.resizeObserver = null;
      }
      if (this.abortController) {
        this.abortController.abort();
        this.abortController = null;
      }
      if (this.demoTimeout) {
        clearTimeout(this.demoTimeout);
        this.demoTimeout = null;
      }
      if (this.processingInterval) {
        clearInterval(this.processingInterval);
        this.processingInterval = null;
      }
      if (this.fitAddon) {
        try { this.fitAddon.dispose(); } catch {}
        this.fitAddon = null;
      }
      if (this.term) {
        try { this.term.dispose(); } catch {}
        this.term = null;
      }
      this.isBooted = false;
      this.isBooting = false;
      this.pendingInteractive = false;
      this.isDemoRunning = false;
      this.setupState = 'IDLE';
      this.currentLine = '';
      this.profileName = '';
      const container = this.querySelector('#terminal-container');
      if (container) {
        container.innerHTML = `
          <div class="terminal-placeholder" id="terminal-placeholder" aria-hidden="true">
            <div class="terminal-placeholder-line">
              <span class="ph-tilde">~</span> <span class="ph-arrow">❯</span> <span class="ph-cursor"></span>
            </div>
          </div>
        `;
      }
    }

    /**
     * Box-Muller Gaussian human typing delay generator
     * Mean ~65ms, standard deviation >= 30.0ms + natural hesitation heuristics
     */
    getNextDelay(char = '', prevChar = ''): number {
      if (typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        return 0;
      }

      // Box-Muller transformation: z0 = sqrt(-2*ln(u1)) * cos(2*pi*u2)
      const u1 = Math.max(0.0001, Math.random());
      const u2 = Math.random();
      const z0 = Math.sqrt(-2.0 * Math.log(u1)) * Math.cos(2.0 * Math.PI * u2);
      let delay = 65 + z0 * 36;

      // Human hesitation heuristics
      if (char === ' ' || char === '/') {
        delay += 85; // Word boundary & directory path pause
      } else if (char === '.' || char === '@' || char === '-' || char === '_') {
        delay += 60; // Punctuation & email domain pause
      } else if (char === '\n' || char === '\r') {
        delay += 180; // Enter / command execution pause
      } else if (char && this.timingHistory.length > 0 && this.timingHistory.length % 4 === 0) {
        delay += 55; // Natural rhythm hesitation
      }

      delay = Math.max(25, Math.min(480, Math.round(delay)));

      // Statistical variance monitoring: ensure rolling standard deviation >= 30.0ms
      this.timingHistory.push(delay);
      if (this.timingHistory.length > 30) this.timingHistory.shift();

      if (this.timingHistory.length >= 8) {
        const mean = this.timingHistory.reduce((a, b) => a + b, 0) / this.timingHistory.length;
        const variance = this.timingHistory.reduce((a, b) => a + Math.pow(b - mean, 2), 0) / this.timingHistory.length;
        const stdDev = Math.sqrt(variance);
        if (stdDev < 31.0) {
          delay = delay < mean ? Math.max(25, delay - 25) : Math.min(480, delay + 75);
          this.timingHistory[this.timingHistory.length - 1] = delay;
        }
      }

      return delay;
    }

    async wait(ms: number): Promise<boolean> {
      return new Promise<boolean>((resolve) => {
        if (this.abortController?.signal.aborted || !this.isAutoDemo) {
          return resolve(false);
        }
        let timer: any = null;
        const onAbort = () => {
          if (timer) clearTimeout(timer);
          resolve(false);
        };
        this.abortController?.signal.addEventListener('abort', onAbort, { once: true });
        timer = setTimeout(() => {
          this.abortController?.signal.removeEventListener('abort', onAbort);
          if (!this.isAutoDemo || this.abortController?.signal.aborted) {
            resolve(false);
          } else {
            resolve(true);
          }
        }, ms);
        this.demoTimeout = timer;
      });
    }

    async typeText(text: string): Promise<boolean> {
      const isReducedMotion = typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (isReducedMotion) {
        if (this.term) this.term.write(text);
        return true;
      }
      let prev = '';
      for (let i = 0; i < text.length; i++) {
        if (!this.isAutoDemo || !this.term || this.abortController?.signal.aborted) {
          this.isDemoRunning = false;
          return false;
        }
        const char = text.charAt(i);
        this.term.write(char);
        const delay = this.getNextDelay(char, prev);
        prev = char;
        const continued = await this.wait(delay);
        if (!continued) {
          this.isDemoRunning = false;
          return false;
        }
      }
      return true;
    }

    boot(startInteractive = false) {
      if (this.isBooted || this.isBooting) return;
      this.isBooting = true;

      const targetContainer = this.querySelector('#terminal-container') as HTMLElement;
      if (!targetContainer) {
        this.isBooting = false;
        return;
      }

      const abortController = new AbortController();
      this.abortController = abortController;
      const currentSignal = abortController.signal;

      try {
        // Clear targetContainer contents safely
        targetContainer.innerHTML = '';

        const initialFontSize = this.getResponsiveFontSize();

        this.term = new Terminal({
          cursorBlink: true,
          cursorStyle: startInteractive ? 'block' : 'bar',
          fontFamily: '"JetBrains Mono", monospace',
          fontSize: initialFontSize,
          lineHeight: 1.25,
          theme: {
            background: 'transparent',
            foreground: '#ededed',
            cursor: '#00c4cc',
            black: '#000000',
            red: '#ef4444',
            green: '#10b981',
            yellow: '#f59e0b',
            blue: '#0ea5e9',
            magenta: '#a1a1aa',
            cyan: '#00c4cc',
            white: '#ffffff'
          },
          allowTransparency: true,
          disableStdin: false
        });

        this.fitAddon = new FitAddon();
        this.term.loadAddon(this.fitAddon);

        this.term.open(targetContainer);

        // Fit immediately to container bounds
        try {
          this.fitAddon.fit();
        } catch {}

        // Setup dynamic ResizeObserver to keep terminal responsive across viewport adjustments
        if (typeof ResizeObserver !== 'undefined') {
          this.resizeObserver = new ResizeObserver(() => {
            if (this.term && targetContainer.clientWidth > 0) {
              requestAnimationFrame(() => {
                if (!this.term) return;
                const targetFont = this.getResponsiveFontSize();
                if (this.term.options.fontSize !== targetFont) {
                  this.term.options.fontSize = targetFont;
                }
                if (this.fitAddon) {
                  try {
                    this.fitAddon.fit();
                  } catch {}
                }
              });
            }
          });
          this.resizeObserver.observe(targetContainer);
        }

        this.isBooted = true;
        this.isBooting = false;

        // Font upgrade
        if (typeof document !== 'undefined' && document.fonts) {
          document.fonts.load(`${initialFontSize}px "JetBrains Mono"`).then(() => {
            if (this.term && !currentSignal.aborted) {
              this.term.options.fontFamily = '"JetBrains Mono", monospace';
              if (this.fitAddon && targetContainer.clientWidth > 0) {
                try { this.fitAddon.fit(); } catch {}
              }
            }
          }).catch(() => {});
        }

        this.attachTerminalEventListeners(currentSignal);

        if (startInteractive || this.pendingInteractive) {
          this.pauseAutoDemoForInteraction();
        } else if (this.isAutoDemo && !this.isDemoRunning) {
          this.runAutoDemo();
        }
      } catch (bootErr) {
        console.error('Terminal initialization error:', bootErr);
        this.isBooting = false;
      }
    }

    pauseAutoDemoForInteraction() {
      const demoBtn = this.querySelector('#mode-demo') as HTMLButtonElement;
      const interactiveBtn = this.querySelector('#mode-interactive') as HTMLButtonElement;
      const hint = this.querySelector('#terminal-hint') as HTMLElement;
      const terminalWindow = this.querySelector('.terminal-window') as HTMLElement;

      this.isAutoDemo = false;
      this.isDemoRunning = false;

      if (this.demoTimeout) {
        clearTimeout(this.demoTimeout);
        this.demoTimeout = null;
      }
      if (this.processingInterval) {
        clearInterval(this.processingInterval);
        this.processingInterval = null;
      }

      demoBtn?.classList.remove('active');
      demoBtn?.setAttribute('aria-pressed', 'false');
      interactiveBtn?.classList.add('active');
      interactiveBtn?.setAttribute('aria-pressed', 'true');
      terminalWindow?.classList.add('is-interactive');

      if (hint) {
        hint.textContent = "Sandbox active — type 'help', 'status', or 'setup'";
        hint.style.opacity = '0.9';
      }

      if (this.term) {
        this.term.options.cursorBlink = true;
        this.term.options.cursorStyle = 'block';

        // CRITICAL INTEGRITY REQUIREMENT: DO NOT call this.term.reset()!
        // Preserve visible demonstration output buffer so user context is not wiped
        this.term.write('\r\n\x1b[3mSandbox active. Type \x1b[33mgitsetu status\x1b[0m\x1b[3m, \x1b[33msetup\x1b[0m\x1b[3m, or \x1b[33mdoctor\x1b[0m\x1b[3m.\x1b[0m\r\n');
        this.term.write(this.prompt);
        this.term.focus();
      }
    }

    attachTerminalEventListeners(currentSignal: AbortSignal) {
      const demoBtn = this.querySelector('#mode-demo') as HTMLButtonElement;
      const interactiveBtn = this.querySelector('#mode-interactive') as HTMLButtonElement;
      const container = this.querySelector('#terminal-container') as HTMLElement;
      const hint = this.querySelector('#terminal-hint') as HTMLElement;
      const terminalWindow = this.querySelector('.terminal-window') as HTMLElement;

      // Auto-Demo button: ALWAYS resets and restarts the auto-demo cleanly
      demoBtn?.addEventListener('click', () => {
        this.isAutoDemo = true;
        this.isDemoRunning = false;
        terminalWindow?.classList.remove('is-interactive');

        demoBtn.classList.add('active');
        demoBtn.setAttribute('aria-pressed', 'true');
        interactiveBtn?.classList.remove('active');
        interactiveBtn?.setAttribute('aria-pressed', 'false');
        if (hint) {
          hint.textContent = 'Click terminal or press Tab to take control';
          hint.style.opacity = '0.75';
        }

        if (this.demoTimeout) {
          clearTimeout(this.demoTimeout);
          this.demoTimeout = null;
        }
        if (this.processingInterval) {
          clearInterval(this.processingInterval);
          this.processingInterval = null;
        }

        this.setupState = 'IDLE';
        this.currentLine = '';
        this.profileName = '';

        if (this.term) {
          this.term.reset();
          this.term.options.cursorStyle = 'bar';
          if (this.fitAddon) {
            try { this.fitAddon.fit(); } catch {}
          }
        }

        this.runAutoDemo();
      }, { signal: currentSignal });

      interactiveBtn?.addEventListener('click', () => {
        if (!this.isAutoDemo) {
          if (this.term) this.term.focus();
          return;
        }
        this.pauseAutoDemoForInteraction();
      }, { signal: currentSignal });

      container?.addEventListener('click', () => {
        if (this.isAutoDemo) {
          this.pauseAutoDemoForInteraction();
        } else if (this.term) {
          this.term.focus();
        }
      }, { signal: currentSignal });

      // Interactive CLI keyboard input
      this.term.onData((e: string) => {
        if (this.isAutoDemo) {
          this.pauseAutoDemoForInteraction();
          return;
        }
        if (!this.term) return;

        if (e === '\x1b[A' || e === '\x1b[B' || e === '\x1b[C' || e === '\x1b[D') return;

        switch (e) {
          case '\r':
            this.term.write('\r\n');
            this.handleCommand(this.currentLine.trim());
            this.currentLine = '';
            break;
          case '\x7F':
          case '\x08':
            if (this.currentLine.length > 0) {
              this.currentLine = this.currentLine.substring(0, this.currentLine.length - 1);
              this.term.write('\b \b');
            }
            break;
          case '\x03':
            this.term.write('^C\r\n');
            this.currentLine = '';
            this.setupState = 'IDLE';
            if (this.processingInterval) clearInterval(this.processingInterval);
            this.term.write(this.prompt);
            break;
          default:
            if (e >= String.fromCharCode(32) && e <= String.fromCharCode(126)) {
              this.currentLine += e;
              this.term.write(e);
            }
        }
      });
    }

    simulateProcessing(callback: () => void) {
      if (!this.term) return;
      let dots = 0;
      this.term.write('  \x1b[36mGenerating cryptographic keys\x1b[0m');
      this.processingInterval = setInterval(() => {
        if (!this.term || this.abortController?.signal.aborted) {
          if (this.processingInterval) clearInterval(this.processingInterval);
          this.processingInterval = null;
          return;
        }
        this.term.write('.');
        dots++;
        if (dots >= 3) {
          if (this.processingInterval) clearInterval(this.processingInterval);
          this.processingInterval = null;
          this.term.write('\x1b[2K\r');
          callback();
        }
      }, 350);
    }

    handleCommand(cmd: string) {
      if (!this.term) return;
      const lower = cmd.toLowerCase();

      if (this.setupState === 'IDLE') {
        if (lower === 'gitsetu setup --auto' || lower === 'gitsetu init --auto' || lower === 'gitsetu setup -y' || lower === 'setup --auto' || lower === 'init --auto') {
          this.term.write('  \x1b[1;36mGitSetu Zero-Prompt Auto-Discovery v1.0.0\x1b[0m\r\n');
          this.term.write('  🔍 \x1b[36mScanning local workstation...\x1b[0m\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m Active Git Author: \x1b[33mme@bhaskarjha.dev\x1b[0m\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m Discovered 2 SSH keys in ~/.ssh/ (\x1b[33mid_ed25519_work\x1b[0m, \x1b[33mid_ed25519_personal\x1b[0m)\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m Discovered 2 workspace folders (\x1b[33m~/work\x1b[0m, \x1b[33m~/personal\x1b[0m)\r\n');
          this.term.write('  ⚡ \x1b[36mComposing & applying zero-trust blueprint...\x1b[0m\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m [work] ➔ ~/work/ (dev@company.com, ed25519_work)\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m [personal] ➔ [Global Fallback] (me@bhaskarjha.dev, ed25519_personal)\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m OpenSSH Include isolation injected\r\n');
          this.term.write('     \x1b[32m✔\x1b[0m Preserved pre-existing configs & SSH keys (non-destructive)\r\n');
          this.term.write('  \x1b[1;32m✨ Provisioned 2 profiles in 0.8s with zero prompts! (v1.0.0 GA)\x1b[0m\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'gitsetu setup' || lower === 'gitsetu init' || lower === 'setup' || lower === 'init') {
          this.term.write('  \x1b[33m?\x1b[0m \x1b[1;33mProfile name:\x1b[0m ');
          this.setupState = 'PROFILE_NAME';
        } else if (lower === 'gitsetu status' || lower === 'status') {
          this.term.write('  \x1b[1;36mGitSetu Profile Registry (v1.0.0 GA)\x1b[0m\r\n');
          this.term.write('  1) [\x1b[32mwork\x1b[0m] dev@company.com\r\n');
          this.term.write('     Dir: \x1b[33m~/work\x1b[0m (Provisioned)\r\n');
          this.term.write('     Key: ~/.ssh/id_ed25519_work\r\n');
          this.term.write('  2) [\x1b[32mpersonal\x1b[0m] me@bhaskarjha.dev\r\n');
          this.term.write('     Dir: [Global Fallback]\r\n');
          this.term.write('     Key: ~/.ssh/id_ed25519_personal\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m Zero-Trust Identity Guard: \x1b[1;32mEnforced\x1b[0m\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'gitsetu guard' || lower === 'guard') {
          this.term.write('  \x1b[1;36mGitSetu Pre-Commit Identity Guard v1.0.0\x1b[0m\r\n');
          this.term.write('  \x1b[32m✔ [Pre-Commit Guard]\x1b[0m Active profile \x1b[33mwork\x1b[0m (dev@company.com). Match verified.\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'gitsetu doctor' || lower === 'doctor') {
          this.term.write('  \x1b[1;36mGitSetu Diagnostic Engine v1.0.0 GA\x1b[0m\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m Git 2.45+ (includeIf conditional routing)\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m OpenSSH 7.3+ (Include directive verified)\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m POSIX Shell: Bash 3.2+ compatible\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m Directory routing: Longest-match active\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m 36 regression test suites: 100% green\r\n');
          this.term.write('  \x1b[32m✔\x1b[0m 31-phase Windows Sandbox VM audit: 100/100 checks passed\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'gitsetu --version' || lower === 'gitsetu -v' || lower === 'gitsetu version' || lower === 'version') {
          this.term.write('  gitsetu v1.0.0 (Day 1 General Availability)\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'gitsetu --help' || lower === 'gitsetu help' || lower === 'gitsetu' || lower === 'help') {
          this.term.write('  \x1b[1mGitSetu\x1b[0m — Zero-Dependency Git Identity Manager v1.0.0 GA\r\n');
          this.term.write('  Usage: gitsetu <command> [arguments]\r\n\r\n');
          this.term.write('  Commands:\r\n');
          this.term.write('    setup [--auto]  Interactive dashboard or zero-prompt auto-discovery\r\n');
          this.term.write('    init [--auto]   Alias for setup\r\n');
          this.term.write('    status          Inspect registered profiles and active scope\r\n');
          this.term.write('    doctor          Audit runtime dependencies and configuration\r\n');
          this.term.write('    guard           Pre-commit identity verification\r\n');
          this.term.write('    vault           AES-256 encrypted profile backup/restore\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'clear' || lower === 'cls') {
          this.term.reset();
          this.term.write(this.prompt);
        } else if (lower === 'ls' || lower === 'dir') {
          this.term.write('  personal/  work/\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'pwd') {
          this.term.write('  /home/developer\r\n\r\n');
          this.term.write(this.prompt);
        } else if (lower === 'whoami') {
          this.term.write('  dev\r\n\r\n');
          this.term.write(this.prompt);
        } else if (cmd !== '') {
          this.term.write(`  \x1b[31mbash: command not found:\x1b[0m ${cmd}\r\n\r\n${this.prompt}`);
        } else {
          this.term.write(this.prompt);
        }
      } else if (this.setupState === 'PROFILE_NAME') {
        this.profileName = cmd || 'work';
        this.term.write(`  \x1b[33m?\x1b[0m \x1b[1;33mGit email:\x1b[0m `);
        this.setupState = 'GIT_EMAIL';
      } else if (this.setupState === 'GIT_EMAIL') {
        this.term.write(`  \x1b[33m?\x1b[0m \x1b[1;33mDirectory:\x1b[0m `);
        this.setupState = 'DIRECTORY';
      } else if (this.setupState === 'DIRECTORY') {
        const targetDir = cmd || '~/work';
        this.setupState = 'PROCESSING';
        this.simulateProcessing(() => {
          if (!this.term) return;
          this.term.write(`  \x1b[32m✔\x1b[0m Provisioned: \x1b[33m${targetDir}\x1b[0m (mkdir -p)\r\n`);
          this.term.write(`  \x1b[32m✔\x1b[0m Key generated: \x1b[33m~/.ssh/id_ed25519_${this.profileName}\x1b[0m\r\n`);
          this.term.write(`  \x1b[32m✔\x1b[0m Config: \x1b[33m~/.config/gitsetu/profiles/${this.profileName}.gitconfig\x1b[0m\r\n`);
          this.term.write(`  \x1b[32m✔\x1b[0m OpenSSH linked: \x1b[33m~/.ssh/config\x1b[0m\r\n`);
          this.term.write(`  \x1b[32m✔\x1b[0m Profile '${this.profileName}' active (v1.0.0 GA)\r\n\r\n`);
          this.term.write(this.prompt);
          this.setupState = 'IDLE';
        });
      }
    }

    async runAutoDemo() {
      if (this.isDemoRunning || !this.isAutoDemo || !this.term || this.abortController?.signal.aborted) return;
      this.isDemoRunning = true;

      const terminalWindow = this.querySelector('.terminal-window') as HTMLElement;
      terminalWindow?.classList.remove('is-interactive');

      this.term.write(this.prompt);

      const checkAndContinue = async (ms: number) => {
        if (!this.isAutoDemo || !this.term || this.abortController?.signal.aborted) return false;
        return await this.wait(ms);
      };

      const isReducedMotion = typeof window !== 'undefined' && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (isReducedMotion) {
        this.term.write('gitsetu setup\r\n');
        this.term.write('  \x1b[33m?\x1b[0m \x1b[1;33mProfile name:\x1b[0m work\r\n');
        this.term.write('  \x1b[33m?\x1b[0m \x1b[1;33mGit email:\x1b[0m dev@company.com\r\n');
        this.term.write('  \x1b[33m?\x1b[0m \x1b[1;33mDirectory:\x1b[0m ~/work\r\n');
        this.term.write('  \x1b[32m✔\x1b[0m Provisioned: \x1b[33m~/work\x1b[0m (mkdir -p)\r\n');
        this.term.write('  \x1b[32m✔\x1b[0m Key generated: \x1b[33m~/.ssh/id_ed25519_work\x1b[0m\r\n');
        this.term.write('  \x1b[32m✔\x1b[0m Config: \x1b[33m~/.config/gitsetu/profiles/work.gitconfig\x1b[0m\r\n');
        this.term.write('  \x1b[32m✔\x1b[0m OpenSSH linked: \x1b[33m~/.ssh/config\x1b[0m\r\n');
        this.term.write('  \x1b[31m✘ [Guard]\x1b[0m \x1b[31mdev@company.com != me@bhaskarjha.dev\x1b[0m\r\n');
        this.term.write('  \x1b[33m⚡ Guard auto-resolving identity for ~/work...\x1b[0m\r\n');
        this.term.write('  \x1b[32m✔ [Guard]\x1b[0m \x1b[1;32mAligned: dev@company.com (id_ed25519_work)\x1b[0m\r\n');
        this.term.write('  \x1b[1;32m✨ Sandbox active — commit authorized! (v1.0.0 GA)\x1b[0m\r\n\r\n');
        this.term.write(this.prompt);
        this.isDemoRunning = false;
        return;
      }

      if (!await checkAndContinue(800)) { this.isDemoRunning = false; return; }
      if (!(await this.typeText('gitsetu setup'))) { this.isDemoRunning = false; return; }

      if (!await checkAndContinue(350)) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  \x1b[33m?\x1b[0m \x1b[1;33mProfile name:\x1b[0m ');

      if (!await checkAndContinue(500)) { this.isDemoRunning = false; return; }
      if (!(await this.typeText('work'))) { this.isDemoRunning = false; return; }

      if (!await checkAndContinue(350)) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  \x1b[33m?\x1b[0m \x1b[1;33mGit email:\x1b[0m ');

      if (!await checkAndContinue(450)) { this.isDemoRunning = false; return; }
      if (!(await this.typeText('dev@company.com'))) { this.isDemoRunning = false; return; }

      if (!await checkAndContinue(350)) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  \x1b[33m?\x1b[0m \x1b[1;33mDirectory:\x1b[0m ');

      if (!await checkAndContinue(450)) { this.isDemoRunning = false; return; }
      if (!(await this.typeText('~/work'))) { this.isDemoRunning = false; return; }

      if (!await checkAndContinue(400)) { this.isDemoRunning = false; return; }
      this.term.write('\r\n  \x1b[36mGenerating cryptographic keys\x1b[0m');

      for (let i = 0; i < 3; i++) {
        if (!await checkAndContinue(350)) { this.isDemoRunning = false; return; }
        this.term.write('.');
      }

      if (!await checkAndContinue(200)) { this.isDemoRunning = false; return; }
      this.term.write('\x1b[2K\r'); // Erase line

      this.term.write('  \x1b[32m✔\x1b[0m Provisioned: \x1b[33m~/work\x1b[0m (mkdir -p)\r\n');
      if (!await checkAndContinue(180)) { this.isDemoRunning = false; return; }

      this.term.write('  \x1b[32m✔\x1b[0m Key generated: \x1b[33m~/.ssh/id_ed25519_work\x1b[0m\r\n');
      if (!await checkAndContinue(180)) { this.isDemoRunning = false; return; }

      this.term.write('  \x1b[32m✔\x1b[0m Config: \x1b[33m~/.config/gitsetu/profiles/work.gitconfig\x1b[0m\r\n');
      if (!await checkAndContinue(180)) { this.isDemoRunning = false; return; }

      this.term.write('  \x1b[32m✔\x1b[0m OpenSSH linked: \x1b[33m~/.ssh/config\x1b[0m\r\n');
      if (!await checkAndContinue(400)) { this.isDemoRunning = false; return; }

      // Pre-Commit Guard Demonstration: Red error resolving to Green success
      this.term.write('  \x1b[31m✘ [Guard]\x1b[0m \x1b[31mdev@company.com != me@bhaskarjha.dev\x1b[0m\r\n');
      if (!await checkAndContinue(500)) { this.isDemoRunning = false; return; }

      this.term.write('  \x1b[33m⚡ Guard auto-resolving identity for ~/work...\x1b[0m\r\n');
      if (!await checkAndContinue(600)) { this.isDemoRunning = false; return; }

      this.term.write('  \x1b[32m✔ [Guard]\x1b[0m \x1b[1;32mAligned: dev@company.com (id_ed25519_work)\x1b[0m\r\n');
      this.term.write('  \x1b[1;32m✨ Sandbox active — commit authorized! (v1.0.0 GA)\x1b[0m\r\n\r\n');

      if (!await checkAndContinue(600)) { this.isDemoRunning = false; return; }

      this.term.write(this.prompt);
      this.isDemoRunning = false;

      // Clean loop after 3.5 seconds if still in Auto-Demo mode
      if (await checkAndContinue(3500)) {
        if (this.isAutoDemo && !this.isDemoRunning && this.term && !this.abortController?.signal.aborted) {
          this.term.reset();
          if (this.fitAddon) {
            try { this.fitAddon.fit(); } catch {}
          }
          this.runAutoDemo();
        }
      }
    }
  }

  if (typeof window !== 'undefined') {
    if (!customElements.get('gitsetu-terminal')) {
      customElements.define('gitsetu-terminal', GitsetuTerminal);
    }
    // Handle Astro ClientRouter navigation
    document.addEventListener('astro:page-load', () => {
      const termEl = document.querySelector('gitsetu-terminal') as GitsetuTerminal | null;
      if (termEl && !termEl.isBooted && !termEl.isBooting) {
        termEl.boot(false);
      }
    });
  }
</script>

