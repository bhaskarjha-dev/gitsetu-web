---
---

<command-palette>
  <div id="cmd-palette" class="cmd-backdrop command-palette-modal" data-focus="restore" aria-hidden="true">
    <div class="cmd-modal" role="dialog" aria-modal="true" aria-label="Command Palette">
      <div class="cmd-header">
        <svg class="cmd-search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="cmd-input" class="cmd-input" role="combobox" aria-label="Search documentation, commands, and settings" aria-autocomplete="list" aria-expanded="false" aria-controls="dynamic-search-results" placeholder="Search documentation, commands, and settings..." autocomplete="off" spellcheck="false" />
        <button id="cmd-close" class="cmd-close" aria-label="Close">ESC</button>
      </div>
      <div class="cmd-body">
        <!-- Dynamic Search Results -->
        <div class="cmd-section" id="dynamic-search-section" style="display: none;">
          <ul class="cmd-results" id="dynamic-search-results" role="listbox">
            <!-- Injected via JS -->
          </ul>
        </div>

        <div class="cmd-section default-section">
          <div class="cmd-section-title">Quick Links</div>
          <ul class="cmd-results" role="listbox">
            <li>
              <a href="/docs/getting-started/installation" class="cmd-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                <span>Installation & Package Managers (9 Methods)</span>
                <kbd class="cmd-shortcut">⏎</kbd>
              </a>
            </li>
            <li>
              <a href="/docs/getting-started/quickstart" class="cmd-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                <span>Quickstart Guide</span>
              </a>
            </li>
            <li>
              <a href="/docs/core-engines/identity-routing" class="cmd-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-4l-3 9L9 3l-3 9H2"></path></svg>
                <span>Identity Routing Architecture</span>
              </a>
            </li>
            <li>
              <a href="/docs/guides/hardware-keys" class="cmd-item">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"></path></svg>
                <span>Configure FIDO2 Hardware Keys</span>
              </a>
            </li>
          </ul>
        </div>
        
        <div class="cmd-section default-section">
          <div class="cmd-section-title">Quick Install Commands</div>
          <ul class="cmd-results" role="listbox">
            <li>
              <button class="cmd-item cmd-copy-action" data-copy="curl -sL https://gitsetu.bhaskarjha.dev/install | bash" type="button">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span>Copy POSIX Installer (curl)</span>
                <kbd class="cmd-shortcut">curl</kbd>
              </button>
            </li>
            <li>
              <button class="cmd-item cmd-copy-action" data-copy="irm https://gitsetu.bhaskarjha.dev/install.ps1 | iex" type="button">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span>Copy Windows Installer (PowerShell)</span>
                <kbd class="cmd-shortcut">ps1</kbd>
              </button>
            </li>
            <li>
              <button class="cmd-item cmd-copy-action" data-copy="npx gitsetu setup --auto" type="button">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
                <span>Copy Zero-Install Command (npx)</span>
                <kbd class="cmd-shortcut">npx</kbd>
              </button>
            </li>
          </ul>
        </div>
      </div>
      <div class="cmd-footer">
        <span><kbd>↑</kbd> <kbd>↓</kbd> to navigate</span>
        <span><kbd>⏎</kbd> to select</span>
        <span><kbd>ESC</kbd> to close</span>
      </div>
    </div>
    <div id="cmd-announcer" aria-live="polite" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border-width: 0;"></div>
  </div>
</command-palette>

<script>
  class CommandPalette extends HTMLElement {
    private oramaDb: any = null;
    private oramaSearch: any = null;
    private isFetching = false;
    private backdrop: HTMLElement | null;
    private input: HTMLInputElement | null;
    private closeBtn: HTMLElement | null;
    private defaultSections: NodeListOf<HTMLElement>;
    private dynamicSection: HTMLElement | null;
    private dynamicResults: HTMLElement | null;
    private selectedIndex = -1;
    private debounceTimer: number | null = null;
    private previousActiveElement: HTMLElement | null = null;
    
    private handleKeydown: (e: KeyboardEvent) => void;
    private handleGlobalOpen: (e: Event) => void;
    private handleGlobalKeydown: (e: KeyboardEvent) => void;
    private handleBeforeSwap: () => void;
    private handlePageLoad: () => void;
    private handlePopState: () => void;

    constructor() {
      super();
      this.backdrop = this.querySelector('.cmd-backdrop');
      this.input = this.querySelector('#cmd-input');
      this.closeBtn = this.querySelector('#cmd-close');
      this.defaultSections = this.querySelectorAll('.default-section');
      this.dynamicSection = this.querySelector('#dynamic-search-section');
      this.dynamicResults = this.querySelector('#dynamic-search-results');

      this.handleKeydown = this.onKeydown.bind(this);
      this.handleGlobalOpen = this.openPalette.bind(this);
      this.handleGlobalKeydown = this.onGlobalKeydown.bind(this);
      this.handleBeforeSwap = () => {
        document.body.style.overflow = '';
        this.closePalette();
      };
      this.handlePageLoad = () => {
        if (!this.backdrop?.classList.contains('active')) {
          document.body.style.overflow = '';
        }
      };
      this.handlePopState = () => {
        document.body.style.overflow = '';
        this.closePalette();
      };
    }

    connectedCallback() {
      this.backdrop?.addEventListener('click', (e) => {
        if (e.target === this.backdrop) this.closePalette();
      });
      this.closeBtn?.addEventListener('click', () => this.closePalette());
      this.input?.addEventListener('input', (e) => this.onInput(e));

      document.addEventListener('open-command-palette', this.handleGlobalOpen);
      document.addEventListener('keydown', this.handleGlobalKeydown);

      // Astro View Transitions scroll lock protection
      document.addEventListener('astro:before-swap', this.handleBeforeSwap);
      document.addEventListener('astro:page-load', this.handlePageLoad);
      window.addEventListener('popstate', this.handlePopState);
      
      // Initialize IDs for default options
      let optionIndex = 0;
      this.defaultSections.forEach(section => {
        section.querySelectorAll('li').forEach(li => {
          li.setAttribute('role', 'option');
          li.setAttribute('id', `cmd-opt-default-${optionIndex++}`);
        });
      });

      // Delegated click listener on component: handles link navigation & copy actions
      this.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (!target) return;

        // Close palette when navigating via result link
        const link = target.closest('a');
        if (link) {
          this.closePalette();
          return;
        }

        // Delegated quick copy action (handles both static & dynamic results)
        const copyBtn = target.closest('.cmd-copy-action') as HTMLElement | null;
        if (copyBtn) {
          e.preventDefault();
          e.stopPropagation();
          const text = copyBtn.getAttribute('data-copy') || '';
          if (!text) return;

          // 1. SYNCHRONOUS UI FEEDBACK (Instantaneous at frame 0, matching DocsLayout)
          const span = copyBtn.querySelector('span');
          if (span) {
            // Guard against original text corruption on multiple rapid clicks
            if (!span.getAttribute('data-original-text')) {
              span.setAttribute('data-original-text', span.textContent || '');
            }
            const originalText = span.getAttribute('data-original-text') || '';
            span.textContent = 'Copied to clipboard!';
            copyBtn.classList.add('copied');
            copyBtn.setAttribute('aria-label', 'Copied to clipboard');

            // Clear any active reset timer on this specific button
            const activeTimer = (copyBtn as any)._copyTimer;
            if (activeTimer) {
              window.clearTimeout(activeTimer);
            }

            (copyBtn as any)._copyTimer = window.setTimeout(() => {
              span.textContent = originalText;
              copyBtn.classList.remove('copied');
              copyBtn.removeAttribute('aria-label');
              delete (copyBtn as any)._copyTimer;
            }, 2000);
          }

          // 2. Accessible announcement for screen readers
          const announcer = document.getElementById('cmd-announcer');
          if (announcer) {
            announcer.textContent = 'Copied command to clipboard';
          }

          // 3. ASYNCHRONOUS CLIPBOARD WRITE (Background non-blocking execution)
          this.copyToClipboard(text);
        }
      });

      // Pre-warm search index during idle time
      if ('requestIdleCallback' in window) {
        (window as any).requestIdleCallback(() => this.fetchSearchIndex());
      } else {
        setTimeout(() => this.fetchSearchIndex(), 400);
      }

      // Pre-warm on pointerenter on any search trigger button
      const searchTriggers = document.querySelectorAll('#search-btn, .search-btn');
      searchTriggers.forEach(btn => {
        btn.addEventListener('pointerenter', () => this.fetchSearchIndex(), { once: true });
      });
    }

    disconnectedCallback() {
      document.body.style.overflow = '';
      document.removeEventListener('open-command-palette', this.handleGlobalOpen);
      document.removeEventListener('keydown', this.handleGlobalKeydown);
      document.removeEventListener('keydown', this.handleKeydown);
      document.removeEventListener('astro:before-swap', this.handleBeforeSwap);
      document.removeEventListener('astro:page-load', this.handlePageLoad);
      window.removeEventListener('popstate', this.handlePopState);
    }

    private copyToClipboard(text: string) {
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(text).catch(() => {
          this.fallbackCopy(text);
        });
      } else {
        this.fallbackCopy(text);
      }
    }

    private fallbackCopy(text: string): boolean {
      try {
        const ta = document.createElement('textarea');
        ta.value = text;
        ta.style.position = 'fixed';
        ta.style.left = '-9999px';
        ta.style.top = '-9999px';
        ta.setAttribute('readonly', '');
        document.body.appendChild(ta);
        ta.select();
        const success = document.execCommand('copy');
        document.body.removeChild(ta);
        return success;
      } catch {
        return false;
      }
    }

    async fetchSearchIndex() {
      if (this.oramaDb || this.isFetching) return;
      this.isFetching = true;
      try {
        const res = await fetch('/search.json');
        if (!res.ok) throw new Error(`HTTP ${res.status}: ${res.statusText}`);
        const data = await res.json();
        
        const { create, insertMultiple, search } = await import('@orama/orama');
        this.oramaSearch = search;
        
        this.oramaDb = await create({
          schema: {
            id: 'string',
            title: 'string',
            category: 'string',
            slug: 'string',
            description: 'string',
            content: 'string',
            url: 'string'
          }
        });

        await insertMultiple(this.oramaDb, data);

        // Only trigger initial search if input has content and hasn't already been searched
        if (this.input && this.input.value.trim().length > 0 && !this.dynamicSection?.classList.contains('active')) {
          this.search(this.input.value.trim());
        }
      } catch (e: any) {
        console.error('Failed to fetch search index:', e);
        if (this.dynamicResults) {
          this.dynamicResults.innerHTML = `<li role="option" style="padding: 12px; color: #ef4444;">Failed to load search index</li>`;
        }
      } finally {
        this.isFetching = false;
      }
    }

    openPalette() {
      if (this.backdrop?.classList.contains('active')) return;
      this.previousActiveElement = (document.activeElement as HTMLElement) || null;
      this.fetchSearchIndex();
      this.backdrop?.classList.add('active');
      this.backdrop?.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      this.selectedIndex = -1;
      
      this.input?.setAttribute('aria-expanded', 'true');
      
      if (this.input) {
        this.input.value = '';
        this.input.focus();
        this.defaultSections.forEach(sec => (sec as HTMLElement).style.display = '');
        if (this.dynamicSection) {
          this.dynamicSection.style.display = 'none';
          this.dynamicSection.classList.remove('active');
        }
      }

      document.addEventListener('keydown', this.handleKeydown);
    }

    closePalette() {
      this.backdrop?.classList.remove('active');
      this.backdrop?.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      this.selectedIndex = -1;
      
      if (this.dynamicSection) {
        this.dynamicSection.classList.remove('active');
      }
      if (this.debounceTimer) {
        window.clearTimeout(this.debounceTimer);
        this.debounceTimer = null;
      }

      this.input?.setAttribute('aria-expanded', 'false');
      this.input?.removeAttribute('aria-activedescendant');
      if (this.input) {
        this.input.value = '';
      }
      this.input?.blur();

      // Reset any active copy button states upon palette close
      this.querySelectorAll('.cmd-copy-action.copied').forEach((btn) => {
        const span = btn.querySelector('span');
        const orig = span?.getAttribute('data-original-text');
        if (span && orig) span.textContent = orig;
        btn.classList.remove('copied');
        btn.removeAttribute('aria-label');
        const timer = (btn as any)._copyTimer;
        if (timer) {
          window.clearTimeout(timer);
          delete (btn as any)._copyTimer;
        }
      });

      document.removeEventListener('keydown', this.handleKeydown);
      
      // Strict focus restoration
      if (this.previousActiveElement && this.previousActiveElement !== document.body && typeof this.previousActiveElement.focus === 'function' && document.contains(this.previousActiveElement)) {
        this.previousActiveElement.focus();
      } else {
        const trigger = (document.getElementById('search-btn') || document.querySelector('.search-btn')) as HTMLElement;
        if (trigger && typeof trigger.focus === 'function') trigger.focus();
      }
      this.previousActiveElement = null;
    }

    onGlobalKeydown(e: KeyboardEvent) {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        this.openPalette();
      }
    }

    onKeydown(e: KeyboardEvent) {
      if (!this.backdrop?.classList.contains('active')) return;
      
      if (e.key === 'Escape') {
        e.preventDefault();
        this.closePalette();
        return;
      }

      if (e.key === 'Tab') {
        e.preventDefault();
        const focusable = Array.from(this.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])')) as HTMLElement[];
        const visibleFocusable = focusable.filter(el => {
          const style = window.getComputedStyle(el);
          return style.display !== 'none' && style.visibility !== 'hidden' && el.offsetWidth > 0;
        });
        
        if (visibleFocusable.length === 0) return;
        
        const currentIndex = visibleFocusable.indexOf(document.activeElement as HTMLElement);
        let nextIndex: number;
        if (e.shiftKey) {
          nextIndex = (currentIndex <= 0) ? visibleFocusable.length - 1 : currentIndex - 1;
        } else {
          nextIndex = (currentIndex === -1 || currentIndex >= visibleFocusable.length - 1) ? 0 : currentIndex + 1;
        }
        visibleFocusable[nextIndex].focus();
        return;
      }

      // Fast-path guard: ignore all non-navigation keys (letters, numbers, backspace, modifiers, etc.)
      // Guarantees zero DOM querying and zero array allocations during typing.
      if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp' && e.key !== 'Enter') return;

      const items = this.dynamicSection?.style.display === 'none' 
        ? Array.from(this.querySelectorAll('.default-section:not([style*="display: none"]) li:not([style*="display: none"]) .cmd-item'))
        : Array.from(this.querySelectorAll('#dynamic-search-results .cmd-item'));

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (items.length > 0) {
          this.selectedIndex = (this.selectedIndex + 1) % items.length;
          this.updateSelection(items);
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (items.length > 0) {
          this.selectedIndex = (this.selectedIndex <= 0) ? items.length - 1 : this.selectedIndex - 1;
          this.updateSelection(items);
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (this.selectedIndex >= 0 && this.selectedIndex < items.length) {
          (items[this.selectedIndex] as HTMLElement).click();
        } else if (items.length > 0) {
          (items[0] as HTMLElement).click();
        }
      }
    }

    updateSelection(items: Element[]) {
      items.forEach((item, index) => {
        const li = item.closest('li');
        if (index === this.selectedIndex) {
          item.classList.add('selected');
          if (li) {
            li.setAttribute('aria-selected', 'true');
            const id = li.getAttribute('id');
            if (id) this.input?.setAttribute('aria-activedescendant', id);
          }
          (item as HTMLElement).scrollIntoView({ block: 'nearest' });
        } else {
          item.classList.remove('selected');
          if (li) li.setAttribute('aria-selected', 'false');
        }
      });
    }

    onInput(e: Event) {
      if (this.debounceTimer) {
        window.clearTimeout(this.debounceTimer);
        this.debounceTimer = null;
      }
      
      const query = (e.target as HTMLInputElement).value.trim();
      this.debounceTimer = window.setTimeout(() => {
        this.debounceTimer = null;
        this.search(query);
      }, 150);
    }

    async search(query: string) {
      if (query.length > 0) {
        this.defaultSections.forEach(sec => (sec as HTMLElement).style.display = 'none');
        
        if (this.dynamicSection && this.dynamicResults) {
          this.dynamicSection.style.display = '';
          this.dynamicSection.classList.add('active');
          let html = '';
          
          if (!this.oramaDb) {
             this.dynamicResults.innerHTML = `<li role="option" style="padding: 12px 16px; color: var(--text-muted); font-size: 12px;">Initializing search engine...</li>`;
             return;
          }

          let searchFn = this.oramaSearch;
          if (!searchFn) {
            const oramaModule = await import('@orama/orama');
            this.oramaSearch = oramaModule.search;
            searchFn = this.oramaSearch;
          }
          const searchResult = await searchFn(this.oramaDb, {
            term: query,
            properties: '*',
            tolerance: 1,
            limit: 15
          });

          // Discard results if user typed further while async search was running
          if (this.input && this.input.value.trim() !== query) {
            return;
          }

          const titleMatches: Array<any> = [];
          const contentMatches: Array<any> = [];
          
          searchResult.hits.forEach(hit => {
            const doc = hit.document;
            if (doc.title.toLowerCase().includes(query.toLowerCase()) || doc.url.toLowerCase().includes(query.toLowerCase())) {
              titleMatches.push(doc);
            } else {
              contentMatches.push(doc);
            }
          });

          const commandMatches: Array<string> = [];
          this.defaultSections.forEach(sec => {
            const items = sec.querySelectorAll('.cmd-item');
            items.forEach(item => {
              if (item.textContent?.toLowerCase().includes(query.toLowerCase())) {
                commandMatches.push(item.parentElement?.innerHTML || '');
              }
            });
          });

          let optionIndex = 0;

          if (titleMatches.length > 0) {
            html += '<div class="cmd-section-title" style="margin-top: 12px;" role="presentation">Documentation</div>';
            html += titleMatches.map(item => `
              <li role="option" id="cmd-opt-${optionIndex++}">
                <a href="${item.url}" class="cmd-item" tabindex="-1">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                  <div style="display: flex; flex-direction: column; gap: 2px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <span style="font-weight: 500;">${item.title}</span>
                      ${item.category ? `<span class="cmd-badge">${item.category}</span>` : ''}
                    </div>
                    ${item.description ? `<span style="font-size: 11px; opacity: 0.7; line-height: 1.3;">${item.description}</span>` : ''}
                  </div>
                </a>
              </li>
            `).join('');
          }

          if (commandMatches.length > 0) {
            html += '<div class="cmd-section-title" style="margin-top: 12px;" role="presentation">Commands</div>';
            html += commandMatches.map(cmdHtml => `<li role="option" id="cmd-opt-${optionIndex++}">${cmdHtml.replace('class="cmd-item"', 'class="cmd-item" tabindex="-1"')}</li>`).join('');
          }

          if (contentMatches.length > 0) {
            html += '<div class="cmd-section-title" style="margin-top: 12px;" role="presentation">Text Mentions</div>';
            html += contentMatches.map(item => `
              <li role="option" id="cmd-opt-${optionIndex++}">
                <a href="${item.url}" class="cmd-item" tabindex="-1">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  <div style="display: flex; flex-direction: column; gap: 2px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <span style="font-weight: 500;">${item.title}</span>
                      ${item.category ? `<span class="cmd-badge">${item.category}</span>` : ''}
                    </div>
                    ${item.description ? `<span style="font-size: 11px; opacity: 0.7; line-height: 1.3;">${item.description}</span>` : `<span style="font-size: 11px; opacity: 0.7; color: var(--accent-primary);">Match found in contents</span>`}
                  </div>
                </a>
              </li>
            `).join('');
          }

          if (html === '') {
            html = `
              <li role="option" style="padding: 12px 16px; color: var(--text-muted); font-size: 12px;">
                No results found for "${query}".
              </li>
            `;
          }

          this.dynamicResults.innerHTML = html;
          
          const announcer = document.getElementById('cmd-announcer');
          if (announcer) {
            const numResults = this.dynamicResults.querySelectorAll('[role="option"]').length;
            announcer.textContent = `${numResults} results available. Use up and down arrows to review.`;
          }
          this.selectedIndex = -1;
        }
      } else {
        this.defaultSections.forEach(sec => (sec as HTMLElement).style.display = '');
        if (this.dynamicSection) {
          this.dynamicSection.style.display = 'none';
          this.dynamicSection.classList.remove('active');
        }
        
        this.defaultSections.forEach(section => {
          const items = section.querySelectorAll('.cmd-item');
          let hasVisibleItem = false;
          items.forEach(item => {
            const text = item.textContent?.toLowerCase() || '';
            const li = item.closest('li');
            if (text.includes(query)) {
              if (li) li.style.display = '';
              hasVisibleItem = true;
            } else {
              if (li) li.style.display = 'none';
            }
          });
          (section as HTMLElement).style.display = hasVisibleItem ? '' : 'none';
        });
        this.selectedIndex = -1;
      }
    }
  }

  if (!customElements.get('command-palette')) {
    customElements.define('command-palette', CommandPalette);
  }
</script>

