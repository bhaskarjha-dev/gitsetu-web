---
import TerminalDemo from './TerminalDemo.astro';
---

<section class="hero section" id="install">
  <div class="hero-container container">
    
    <div class="hero-content">
      <!-- Badge -->
      <a href="https://github.com/bhaskarjha-dev/gitsetu/releases/tag/v1.0.0" target="_blank" rel="noopener noreferrer" class="hero-badge">
        <span class="badge-dot"></span>
        <span class="badge-text">v1.0.0 GA • 36 Test Suites Passing • 9 Distribution Channels</span>
        <svg class="badge-arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
      
      <h1 class="hero-title">
        One command. All identities.<br/>
        <span class="text-gradient">Every single machine.</span>
      </h1>
      
      <p class="hero-subtitle">
        Stop pushing freelance commits with your corporate email. GitSetu automatically switches Git configs, isolated SSH keys, and credentials by directory with zero background daemons.
      </p>

      <!-- Safety Pill Callout -->
      <div class="hero-safety-pill">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="safety-icon"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><polyline points="9 12 11 14 15 10"></polyline></svg>
        <span><strong>100% Non-Destructive:</strong> Preserves existing manual configs &amp; SSH keys. Auto-discovers identities.</span>
      </div>

      <!-- Dedicated Hero CTA Row -->
      <div class="hero-cta-group">
        <a href="/docs/getting-started/quickstart" class="btn btn-primary cta-primary magnetic">
          <span>Read Docs</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="https://github.com/bhaskarjha-dev/gitsetu" target="_blank" rel="noopener noreferrer" class="btn btn-secondary cta-secondary magnetic">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          <span>GitHub</span>
          <span class="cta-badge">v1.0.0</span>
          <svg class="external-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
        <a href="/docs/core-engines/identity-routing" class="cta-tertiary">
          <span>Architecture & Security</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <!-- Elevated Full-Width Installation Station -->
      <div class="install-station">
        <!-- Station Header / Category Tabs -->
        <div class="station-header">
          <div class="category-tabs" role="tablist" aria-label="Installation Category">
            <button class="cat-tab active" data-category="direct" type="button" role="tab" aria-selected="true" aria-controls="channels-direct">
              <span class="cat-icon">⚡</span>
              <span class="cat-label">Direct / Shell</span>
            </button>
            <button class="cat-tab" data-category="pkg" type="button" role="tab" aria-selected="false" aria-controls="channels-pkg">
              <span class="cat-icon">📦</span>
              <span class="cat-label">Package Managers</span>
            </button>
            <button class="cat-tab" data-category="extensions" type="button" role="tab" aria-selected="false" aria-controls="channels-extensions">
              <span class="cat-icon">🧩</span>
              <span class="cat-label">Nix & Extensions</span>
            </button>
          </div>
        </div>

        <!-- Platform Sub-Chips per Category -->
        <div class="platform-nav" aria-label="Target Platform Channels">
          <!-- Group 1: Direct / Shell -->
          <div class="channel-group active" id="channels-direct" role="tablist">
            <button class="platform-chip active" data-channel="posix" type="button" role="tab" aria-selected="true">
              <svg class="chip-svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.62-.75 1.04-1.8 0.92-2.85-.9.04-2 .6-2.65 1.35-.58.66-.99 1.72-.88 2.74 1.01.08 2-.49 2.61-1.24z"/></svg>
              <span>macOS / Linux</span>
              <span class="chip-badge">curl</span>
            </button>
            <button class="platform-chip" data-channel="windows" type="button" role="tab" aria-selected="false">
              <svg class="chip-svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.901-1.752"/></svg>
              <span>Windows</span>
              <span class="chip-badge">PS</span>
            </button>
            <button class="platform-chip" data-channel="npx" type="button" role="tab" aria-selected="false">
              <svg class="chip-svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M0 7.334v8h6.666v1.332H12v-1.332h12v-8H0zm6.666 6.666H2.666V8.666h4v5.334zm5.334 0H9.334V8.666h2.666v5.334zm9.334 0h-4v-1.334H20V8.666h-5.334v5.334h-1.332V8.666h9.332v5.334z"/></svg>
              <span>Zero-Install</span>
              <span class="chip-badge">npx</span>
            </button>
          </div>

          <!-- Group 2: Package Managers -->
          <div class="channel-group" id="channels-pkg" role="tablist" style="display: none;">
            <button class="platform-chip" data-channel="winget" type="button" role="tab" aria-selected="false">
              <svg class="chip-svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M0 3.449L9.75 2.1v9.451H0m10.949-9.602L24 0v11.4H10.949M0 12.6h9.75v9.451L0 20.699M10.949 12.6H24V24l-12.901-1.752"/></svg>
              <span>WinGet</span>
            </button>
            <button class="platform-chip" data-channel="brew" type="button" role="tab" aria-selected="false">
              <svg class="chip-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8zM6 1v3M10 1v3M14 1v3"/></svg>
              <span>Homebrew</span>
            </button>
            <button class="platform-chip" data-channel="scoop" type="button" role="tab" aria-selected="false">
              <svg class="chip-svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              <span>Scoop</span>
            </button>
            <button class="platform-chip" data-channel="aur" type="button" role="tab" aria-selected="false">
              <svg class="chip-svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.5L1.5 21.5h21L12 2.5zm0 5.2l6.8 12.3H5.2L12 7.7z"/></svg>
              <span>Arch AUR</span>
            </button>
          </div>

          <!-- Group 3: Nix & Extensions -->
          <div class="channel-group" id="channels-extensions" role="tablist" style="display: none;">
            <button class="platform-chip" data-channel="nix" type="button" role="tab" aria-selected="false">
              <svg class="chip-svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0L1.5 6v12L12 24l10.5-6V6L12 0zm0 3.2l7.5 4.3v8.6L12 20.4l-7.5-4.3V7.5L12 3.2z"/></svg>
              <span>Nix Flake</span>
            </button>
            <button class="platform-chip" data-channel="gh" type="button" role="tab" aria-selected="false">
              <svg class="chip-svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
              <span>GitHub CLI</span>
            </button>
          </div>
        </div>

        <!-- Terminal Command Box with Syntax Highlighting -->
        <div class="terminal-command-box" id="command-box-frame">
          <div class="prompt-col" aria-hidden="true">
            <span class="terminal-prompt">❯</span>
          </div>
          <div class="code-col">
            <code class="install-code" id="install-cmd" tabindex="0" aria-label="Installation command"><span class="tok-cmd">curl</span> <span class="tok-flag">-sL</span> <span class="tok-url">https://gitsetu.bhaskarjha.dev/install</span> <span class="tok-pipe">|</span> <span class="tok-sh">bash</span></code>
          </div>
          <div class="action-col">
            <button class="station-copy-btn" id="station-copy-btn" aria-label="Copy install command" type="button">
              <span class="copy-idle">
                <svg class="copy-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span class="copy-text">Copy</span>
              </span>
              <span class="copy-success" style="display: none;">
                <svg class="check-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="copied-text">Copied!</span>
              </span>
            </button>
          </div>
        </div>

        <!-- Meta Bar & Contextual Explainer -->
        <div class="station-footer">
          <div class="footer-note" id="install-note">
            <span class="status-pulse-dot" aria-hidden="true"></span>
            <span class="note-text" id="install-note-text">POSIX one-liner. Automatically updates shell rc and installs into ~/.local/bin</span>
          </div>
          <a href="/docs/getting-started/installation" class="station-docs-link">
            <span>All 9 distribution channels</span>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
        </div>
      </div>

      <!-- Trust Badges -->
      <div class="hero-trust">
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          36 Test Suites
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          Zero Daemons
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
          Bash 3.2+ Core
        </div>
      </div>
    </div>

    <!-- Product As Demo (Shifted Top-Right) -->
    <div class="hero-visual">
      <div class="mesh-gradient"></div>
      <div class="terminal-glow"></div>
      <!-- Interactive Terminal Setup Demo -->
      <TerminalDemo />
    </div>

  </div>
</section>

<script>
  // Magnetic Buttons, Interactive Installation Station & 3D Terminal
  document.addEventListener('astro:page-load', () => {
    // 9 Distribution Channels & Commands with Syntax Highlighting HTML
    const channelData: Record<string, { cmd: string; html: string; note: string; category: string }> = {
      posix: {
        cmd: 'curl -sL https://gitsetu.bhaskarjha.dev/install | bash',
        html: '<span class="tok-cmd">curl</span> <span class="tok-flag">-sL</span> <span class="tok-url">https://gitsetu.bhaskarjha.dev/install</span> <span class="tok-pipe">|</span> <span class="tok-sh">bash</span>',
        note: 'POSIX one-liner. Automatically updates shell rc and installs into ~/.local/bin',
        category: 'direct'
      },
      windows: {
        cmd: 'irm https://gitsetu.bhaskarjha.dev/install.ps1 | iex',
        html: '<span class="tok-cmd">irm</span> <span class="tok-url">https://gitsetu.bhaskarjha.dev/install.ps1</span> <span class="tok-pipe">|</span> <span class="tok-sh">iex</span>',
        note: 'Native PowerShell one-liner. Auto-generates cmd/ps1 shims. Prerequisite: Git for Windows (winget install Git.Git).',
        category: 'direct'
      },
      npx: {
        cmd: 'npx gitsetu setup --auto',
        html: '<span class="tok-cmd">npx</span> <span class="tok-pkg">gitsetu</span> <span class="tok-arg">setup</span> <span class="tok-flag">--auto</span>',
        note: 'Zero installation needed. Runs anywhere Node 16+ is installed without global pollution.',
        category: 'direct'
      },
      winget: {
        cmd: 'winget install BhaskarJha.GitSetu',
        html: '<span class="tok-cmd">winget</span> <span class="tok-arg">install</span> <span class="tok-pkg">BhaskarJha.GitSetu</span>',
        note: 'Official WinGet identifier. Also supports "winget install GitSetu". Prerequisite: Git for Windows.',
        category: 'pkg'
      },
      brew: {
        cmd: 'brew tap bhaskarjha-dev/tap && brew install gitsetu',
        html: '<span class="tok-cmd">brew</span> <span class="tok-arg">tap</span> <span class="tok-pkg">bhaskarjha-dev/tap</span> <span class="tok-pipe">&amp;&amp;</span> <span class="tok-cmd">brew</span> <span class="tok-arg">install</span> <span class="tok-pkg">gitsetu</span>',
        note: 'Homebrew tap formula for macOS & Linux with automated bash completion.',
        category: 'pkg'
      },
      scoop: {
        cmd: 'scoop bucket add gitsetu https://github.com/bhaskarjha-dev/scoop-gitsetu && scoop install gitsetu',
        html: '<span class="tok-cmd">scoop</span> <span class="tok-arg">bucket add</span> <span class="tok-pkg">gitsetu</span> <span class="tok-url">https://github.com/bhaskarjha-dev/scoop-gitsetu</span> <span class="tok-pipe">&amp;&amp;</span> <span class="tok-cmd">scoop</span> <span class="tok-arg">install</span> <span class="tok-pkg">gitsetu</span>',
        note: 'Windows Scoop bucket installation with isolated portable shim management.',
        category: 'pkg'
      },
      aur: {
        cmd: 'yay -S gitsetu',
        html: '<span class="tok-cmd">yay</span> <span class="tok-flag">-S</span> <span class="tok-pkg">gitsetu</span>',
        note: 'Arch Linux AUR package with system bash-completion integration and PKGBUILD parity.',
        category: 'pkg'
      },
      nix: {
        cmd: 'nix run github:bhaskarjha-dev/gitsetu',
        html: '<span class="tok-cmd">nix</span> <span class="tok-arg">run</span> <span class="tok-pkg">github:bhaskarjha-dev/gitsetu</span>',
        note: 'Hermetic execution via Nix Flake with sandboxed dependencies and zero system pollution.',
        category: 'extensions'
      },
      gh: {
        cmd: 'gh extension install bhaskarjha-dev/gh-gitsetu',
        html: '<span class="tok-cmd">gh</span> <span class="tok-arg">extension install</span> <span class="tok-pkg">bhaskarjha-dev/gh-gitsetu</span>',
        note: 'Official GitHub CLI extension. Run gitsetu directly via "gh gitsetu setup".',
        category: 'extensions'
      }
    };

    let currentChannelKey = 'posix';

    const catTabs = document.querySelectorAll<HTMLButtonElement>('.cat-tab');
    const channelGroups = document.querySelectorAll<HTMLElement>('.channel-group');
    const platformChips = document.querySelectorAll<HTMLButtonElement>('.platform-chip');
    const installCmdEl = document.querySelector<HTMLElement>('#install-cmd');
    const installNoteText = document.querySelector<HTMLElement>('#install-note-text');
    const copyBtn = document.querySelector<HTMLButtonElement>('#station-copy-btn');
    const commandBoxFrame = document.querySelector<HTMLElement>('#command-box-frame');
    const copyIdle = copyBtn?.querySelector('.copy-idle') as HTMLElement;
    const copySuccess = copyBtn?.querySelector('.copy-success') as HTMLElement;
    let copyTimeout: number | null = null;

    function selectChannel(channelKey: string) {
      const data = channelData[channelKey];
      if (!data) return;
      currentChannelKey = channelKey;

      // 1. Ensure the parent category is active
      catTabs.forEach(tab => {
        const isCatActive = tab.getAttribute('data-category') === data.category;
        tab.classList.toggle('active', isCatActive);
        tab.setAttribute('aria-selected', isCatActive ? 'true' : 'false');
      });

      // 2. Show corresponding channel group
      channelGroups.forEach(group => {
        const isGroupActive = group.id === `channels-${data.category}`;
        group.classList.toggle('active', isGroupActive);
        group.style.display = isGroupActive ? 'flex' : 'none';
      });

      // 3. Highlight active platform chip
      platformChips.forEach(chip => {
        const isChipActive = chip.getAttribute('data-channel') === channelKey;
        chip.classList.toggle('active', isChipActive);
        chip.setAttribute('aria-selected', isChipActive ? 'true' : 'false');
      });

      // 4. Update command HTML & contextual note
      if (installCmdEl) {
        installCmdEl.innerHTML = data.html;
      }
      if (installNoteText) {
        installNoteText.textContent = data.note;
      }
    }

    // Category click handler
    catTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const cat = tab.getAttribute('data-category');
        if (!cat) return;

        // Find the first platform chip in this category
        const firstChip = document.querySelector<HTMLButtonElement>(`#channels-${cat} .platform-chip`);
        if (firstChip) {
          const ch = firstChip.getAttribute('data-channel');
          if (ch) selectChannel(ch);
        }
      });
    });

    // Platform chip click handler
    platformChips.forEach(chip => {
      chip.addEventListener('click', () => {
        const ch = chip.getAttribute('data-channel');
        if (ch) selectChannel(ch);
      });
    });

    // Copy Button interaction with checkmark feedback & pulse
    copyBtn?.addEventListener('click', async () => {
      const data = channelData[currentChannelKey];
      const textToCopy = data ? data.cmd : (installCmdEl?.textContent?.trim() || '');

      if (copyTimeout) clearTimeout(copyTimeout);

      const markCopied = () => {
        if (copyIdle) copyIdle.style.display = 'none';
        if (copySuccess) copySuccess.style.display = 'inline-flex';
        commandBoxFrame?.classList.add('copied-pulse');

        copyTimeout = window.setTimeout(() => {
          if (copyIdle) copyIdle.style.display = 'inline-flex';
          if (copySuccess) copySuccess.style.display = 'none';
          commandBoxFrame?.classList.remove('copied-pulse');
          copyTimeout = null;
        }, 2000);
      };

      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(textToCopy);
          markCopied();
        } else {
          throw new Error('Clipboard API unavailable');
        }
      } catch {
        const textArea = document.createElement('textarea');
        textArea.value = textToCopy;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        try {
          document.execCommand('copy');
          markCopied();
        } catch (e) {
          console.error('Failed to copy', e);
        } finally {
          document.body.removeChild(textArea);
        }
      }
    });

    // Keyboard arrow navigation for tabs & chips
    const handleTabKeyNav = (e: KeyboardEvent, tabs: NodeListOf<HTMLButtonElement>) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const tabList = Array.from(tabs);
        const currentIndex = tabList.findIndex(t => t === document.activeElement || t.classList.contains('active'));
        const nextIndex = e.key === 'ArrowRight' 
          ? (currentIndex + 1) % tabList.length
          : (currentIndex - 1 + tabList.length) % tabList.length;
        tabList[nextIndex]?.focus();
        tabList[nextIndex]?.click();
      }
    };

    catTabs.forEach(tab => {
      tab.addEventListener('keydown', (e) => handleTabKeyNav(e, catTabs));
    });

    channelGroups.forEach(group => {
      const chipsInGroup = group.querySelectorAll<HTMLButtonElement>('.platform-chip');
      chipsInGroup.forEach(chip => {
        chip.addEventListener('keydown', (e) => handleTabKeyNav(e, chipsInGroup));
      });
    });

    // Smart OS Auto-detection
    if (typeof navigator !== 'undefined') {
      const ua = (navigator.userAgent || '').toLowerCase();
      const platform = (navigator.platform || '').toLowerCase();
      if (ua.includes('win') || platform.includes('win')) {
        selectChannel('windows');
      } else if (ua.includes('mac') || platform.includes('mac')) {
        selectChannel('posix');
      } else {
        selectChannel('posix');
      }
    }

    // Magnetic Buttons (with rAF throttling and reduced motion check)
    const isReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!isReducedMotion) {
      const magneticEls = document.querySelectorAll('.magnetic');
      magneticEls.forEach((el) => {
        const htmlEl = el as HTMLElement;
        let isThrottled = false;
        htmlEl.addEventListener('mousemove', (e) => {
          if (isThrottled) return;
          isThrottled = true;
          requestAnimationFrame(() => {
            const rect = htmlEl.getBoundingClientRect();
            const x = e.clientX - rect.left - rect.width / 2;
            const y = e.clientY - rect.top - rect.height / 2;
            htmlEl.style.transform = `translate(${x * 0.1}px, ${y * 0.1}px)`;
            isThrottled = false;
          });
        }, { passive: true });
        htmlEl.addEventListener('mouseleave', () => {
          htmlEl.style.transform = 'translate(0px, 0px)';
        });
      });

      // 3D Tilt for Terminal Demo
      const heroVisual = document.querySelector('.hero-visual') as HTMLElement;
      const terminalNode = document.querySelector('gitsetu-terminal') as HTMLElement;
      
      if (heroVisual && terminalNode) {
        let isTiltThrottled = false;
        heroVisual.addEventListener('mousemove', (e) => {
          if (isTiltThrottled) return;
          isTiltThrottled = true;
          requestAnimationFrame(() => {
            const rect = heroVisual.getBoundingClientRect();
            if (rect.width > 0 && rect.height > 0) {
              const x = e.clientX - rect.left;
              const y = e.clientY - rect.top;
              const centerX = rect.width / 2;
              const centerY = rect.height / 2;
              const rotateX = ((y - centerY) / centerY) * -2;
              const rotateY = ((x - centerX) / centerX) * 2;
              terminalNode.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
            }
            isTiltThrottled = false;
          });
        }, { passive: true });
        
        heroVisual.addEventListener('mouseleave', () => {
          terminalNode.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg)`;
        });
      }
    }
  });
</script>

