---
import TerminalDemo from './TerminalDemo.astro';
---

<section class="hero section" id="install">
  <div class="hero-container container">
    
    <div class="hero-content">
      <!-- Badge -->
      <div class="hero-badge">
        <span class="badge-dot"></span>
        <span class="badge-text">v1.0.0 — Day 1 General Availability</span>
      </div>
      
      <h1 class="hero-title">
        The Zero-Trust <br/>
        <span class="text-gradient">Identity Guard</span> for Git.
      </h1>
      
      <p class="hero-subtitle">
        Stop leaking credentials and committing to the wrong profiles. GitSetu cryptographically sandboxes your work, personal, and client identities with zero background processes.
      </p>

      <!-- CTA & Command -->
      <div class="hero-actions">
        <div class="install-container">
          <!-- Category Pills -->
          <div class="install-categories" role="tablist" aria-label="Installation Category">
            <button class="cat-pill active" data-category="direct" type="button" role="tab" aria-selected="true" aria-controls="channels-direct">
              <span class="cat-icon">⚡</span> Direct / Shell
            </button>
            <button class="cat-pill" data-category="pkg" type="button" role="tab" aria-selected="false" aria-controls="channels-pkg">
              <span class="cat-icon">📦</span> Package Managers
            </button>
            <button class="cat-pill" data-category="extensions" type="button" role="tab" aria-selected="false" aria-controls="channels-extensions">
              <span class="cat-icon">🧩</span> Nix & Extensions
            </button>
          </div>

          <!-- Channel Tabs per Category -->
          <div class="channel-groups">
            <!-- Group 1: Direct & Shell -->
            <div class="channel-group active" id="channels-direct" role="tablist" aria-label="Direct Installation Channels">
              <button class="channel-tab active" data-channel="posix" type="button" role="tab" aria-selected="true">
                <span class="tab-badge">macOS/Linux</span>curl
              </button>
              <button class="channel-tab" data-channel="windows" type="button" role="tab" aria-selected="false">
                <span class="tab-badge">Windows</span>PowerShell
              </button>
              <button class="channel-tab" data-channel="npx" type="button" role="tab" aria-selected="false">
                <span class="tab-badge">Zero-Install</span>npx
              </button>
            </div>

            <!-- Group 2: Package Managers -->
            <div class="channel-group" id="channels-pkg" role="tablist" aria-label="Package Manager Channels" style="display: none;">
              <button class="channel-tab" data-channel="winget" type="button" role="tab" aria-selected="false">
                <span class="tab-badge">Windows</span>WinGet
              </button>
              <button class="channel-tab" data-channel="brew" type="button" role="tab" aria-selected="false">
                <span class="tab-badge">macOS</span>Homebrew
              </button>
              <button class="channel-tab" data-channel="scoop" type="button" role="tab" aria-selected="false">
                <span class="tab-badge">Windows</span>Scoop
              </button>
              <button class="channel-tab" data-channel="aur" type="button" role="tab" aria-selected="false">
                <span class="tab-badge">Arch</span>AUR
              </button>
            </div>

            <!-- Group 3: Nix & Extensions -->
            <div class="channel-group" id="channels-extensions" role="tablist" aria-label="Hermetic and Extension Channels" style="display: none;">
              <button class="channel-tab" data-channel="nix" type="button" role="tab" aria-selected="false">
                <span class="tab-badge">Hermetic</span>Nix Flake
              </button>
              <button class="channel-tab" data-channel="gh" type="button" role="tab" aria-selected="false">
                <span class="tab-badge">CLI</span>GitHub CLI
              </button>
            </div>
          </div>

          <!-- Command Box with Terminal Indicator -->
          <copy-button class="install-block group magnetic">
            <span class="terminal-prompt" aria-hidden="true">❯</span>
            <code class="install-command" id="install-cmd" tabindex="0">curl -sL https://gitsetu.bhaskarjha.dev/install | bash</code>
            <button class="copy-btn" aria-label="Copy install command" type="button">
              <svg class="copy-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
              <svg class="check-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><polyline points="20 6 9 17 4 12"/></svg>
            </button>
          </copy-button>

          <!-- Contextual Explainer & Deep Link -->
          <div class="install-meta">
            <div class="install-note" id="install-note">
              <span class="note-dot"></span>
              <span id="install-note-text">POSIX one-liner. Automatically updates shell rc and installs into ~/.local/bin</span>
            </div>
            <a href="/docs/getting-started/installation" class="install-docs-link">
              All 9 channels <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </a>
          </div>
        </div>

        <a href="/docs/getting-started/quickstart" class="btn btn-primary magnetic">
          Read Docs 
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <!-- Trust Badges -->
      <div class="hero-trust">
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          Zero Trust
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
          FIDO2 Ready
        </div>
        <div class="trust-item">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
          Bash 3.2 Core
        </div>
      </div>
    </div>

    <!-- Product As Demo (Shifted Top-Right) -->
    <div class="hero-visual">
      <div class="mesh-gradient"></div>
      <div class="terminal-glow"></div>
      <!-- Interactive Terminal Setup Demo -->
      <TerminalDemo />
    </div>

  </div>
</section>

<script>
  class CopyButton extends HTMLElement {
    private timeoutId: number | null = null;

    connectedCallback() {
      const copyBtn = this.querySelector('.copy-btn') as HTMLButtonElement;
      const installCmd = this.querySelector('.install-command') as HTMLElement;
      const copyIcon = this.querySelector('.copy-icon') as HTMLElement;
      const checkIcon = this.querySelector('.check-icon') as HTMLElement;

      copyBtn?.addEventListener('click', async () => {
        if (this.timeoutId) {
          clearTimeout(this.timeoutId);
        }
        
        try {
          await navigator.clipboard.writeText(installCmd?.textContent?.trim() || '');
          if (copyIcon) copyIcon.style.display = 'none';
          if (checkIcon) checkIcon.style.display = 'block';
          
          this.timeoutId = window.setTimeout(() => {
            if (copyIcon) copyIcon.style.display = 'block';
            if (checkIcon) checkIcon.style.display = 'none';
            this.timeoutId = null;
          }, 2000);
        } catch {
          const range = document.createRange();
          if (installCmd) range.selectNodeContents(installCmd);
          window.getSelection()?.removeAllRanges();
          window.getSelection()?.addRange(range);
        }
      });
    }
  }

  if (!customElements.get('copy-button')) {
    customElements.define('copy-button', CopyButton);
  }

  // Magnetic Buttons & 3D Magnetic Terminal
  document.addEventListener('astro:page-load', () => {
    // 9 Distribution Channels & Commands
    const channelData: Record<string, { cmd: string; note: string; category: string }> = {
      posix: {
        cmd: 'curl -sL https://gitsetu.bhaskarjha.dev/install | bash',
        note: 'POSIX one-liner. Automatically updates shell rc and installs into ~/.local/bin',
        category: 'direct'
      },
      windows: {
        cmd: 'irm https://gitsetu.bhaskarjha.dev/install.ps1 | iex',
        note: 'Native PowerShell one-liner. Auto-generates cmd/ps1 shims and adds to PATH.',
        category: 'direct'
      },
      npx: {
        cmd: 'npx gitsetu setup --auto',
        note: 'Zero installation needed. Runs anywhere Node 16+ is installed without global pollution.',
        category: 'direct'
      },
      winget: {
        cmd: 'winget install BhaskarJha.GitSetu',
        note: 'Microsoft Windows Package Manager (v1.6.0 portable alias). Native execution in any shell.',
        category: 'pkg'
      },
      brew: {
        cmd: 'brew tap bhaskarjha-dev/tap && brew install gitsetu',
        note: 'Homebrew tap formula for macOS & Linux with automated bash completion.',
        category: 'pkg'
      },
      scoop: {
        cmd: 'scoop bucket add gitsetu https://github.com/bhaskarjha-dev/scoop-bucket && scoop install gitsetu',
        note: 'Windows Scoop bucket installation with isolated portable shim management.',
        category: 'pkg'
      },
      aur: {
        cmd: 'yay -S gitsetu',
        note: 'Arch Linux AUR package with system bash-completion integration and PKGBUILD parity.',
        category: 'pkg'
      },
      nix: {
        cmd: 'nix run github:bhaskarjha-dev/gitsetu',
        note: 'Hermetic execution via Nix Flake with sandboxed dependencies and zero system pollution.',
        category: 'extensions'
      },
      gh: {
        cmd: 'gh extension install bhaskarjha-dev/gh-gitsetu',
        note: 'Official GitHub CLI extension. Run gitsetu directly via "gh gitsetu setup".',
        category: 'extensions'
      }
    };

    const catPills = document.querySelectorAll<HTMLButtonElement>('.cat-pill');
    const channelGroups = document.querySelectorAll<HTMLElement>('.channel-group');
    const channelTabs = document.querySelectorAll<HTMLButtonElement>('.channel-tab');
    const installCmdEl = document.querySelector<HTMLElement>('#install-cmd');
    const installNoteText = document.querySelector<HTMLElement>('#install-note-text');

    function selectChannel(channelKey: string) {
      const data = channelData[channelKey];
      if (!data) return;

      // 1. Ensure the parent category is active
      catPills.forEach(pill => {
        const isCatActive = pill.getAttribute('data-category') === data.category;
        pill.classList.toggle('active', isCatActive);
        pill.setAttribute('aria-selected', isCatActive ? 'true' : 'false');
      });

      // 2. Show corresponding channel group
      channelGroups.forEach(group => {
        const isGroupActive = group.id === `channels-${data.category}`;
        group.classList.toggle('active', isGroupActive);
        group.style.display = isGroupActive ? 'flex' : 'none';
      });

      // 3. Highlight active channel tab
      channelTabs.forEach(tab => {
        const isTabActive = tab.getAttribute('data-channel') === channelKey;
        tab.classList.toggle('active', isTabActive);
        tab.setAttribute('aria-selected', isTabActive ? 'true' : 'false');
      });

      // 4. Update command text & contextual note
      if (installCmdEl) {
        installCmdEl.textContent = data.cmd;
      }
      if (installNoteText) {
        installNoteText.textContent = data.note;
      }
    }

    // Category click handler
    catPills.forEach(pill => {
      pill.addEventListener('click', () => {
        const cat = pill.getAttribute('data-category');
        if (!cat) return;

        // Find the first channel in this category
        const firstChannelTab = document.querySelector<HTMLButtonElement>(`#channels-${cat} .channel-tab`);
        if (firstChannelTab) {
          const ch = firstChannelTab.getAttribute('data-channel');
          if (ch) selectChannel(ch);
        }
      });
    });

    // Channel tab click handler
    channelTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const ch = tab.getAttribute('data-channel');
        if (ch) selectChannel(ch);
      });
    });

    // Keyboard arrow navigation for tabs
    const handleTabKeyNav = (e: KeyboardEvent, tabs: NodeListOf<HTMLButtonElement>) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const tabList = Array.from(tabs);
        const currentIndex = tabList.findIndex(t => t === document.activeElement || t.classList.contains('active'));
        const nextIndex = e.key === 'ArrowRight' 
          ? (currentIndex + 1) % tabList.length
          : (currentIndex - 1 + tabList.length) % tabList.length;
        tabList[nextIndex]?.focus();
        tabList[nextIndex]?.click();
      }
    };

    catPills.forEach(pill => {
      pill.addEventListener('keydown', (e) => handleTabKeyNav(e, catPills));
    });

    channelGroups.forEach(group => {
      const tabsInGroup = group.querySelectorAll<HTMLButtonElement>('.channel-tab');
      tabsInGroup.forEach(tab => {
        tab.addEventListener('keydown', (e) => handleTabKeyNav(e, tabsInGroup));
      });
    });

    // Smart OS Auto-detection
    if (typeof navigator !== 'undefined') {
      const ua = (navigator.userAgent || '').toLowerCase();
      const platform = (navigator.platform || '').toLowerCase();
      if (ua.includes('win') || platform.includes('win')) {
        selectChannel('windows');
      } else if (ua.includes('mac') || platform.includes('mac')) {
        selectChannel('posix');
      } else {
        selectChannel('posix');
      }
    }

    // Magnetic Buttons
    const magneticEls = document.querySelectorAll('.magnetic');
    magneticEls.forEach((el) => {
      const htmlEl = el as HTMLElement;
      htmlEl.addEventListener('mousemove', (e) => {
        const rect = htmlEl.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        htmlEl.style.transform = `translate(${x * 0.1}px, ${y * 0.1}px)`;
      });
      htmlEl.addEventListener('mouseleave', () => {
        htmlEl.style.transform = 'translate(0px, 0px)';
      });
    });

    const heroVisual = document.querySelector('.hero-visual') as HTMLElement;
    const terminalNode = document.querySelector('gitsetu-terminal') as HTMLElement;
    
    if (heroVisual && terminalNode) {
      heroVisual.addEventListener('mousemove', (e) => {
        const rect = heroVisual.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        
        const rotateX = ((y - centerY) / centerY) * -10;
        const rotateY = ((x - centerX) / centerX) * 10;
        
        terminalNode.style.transform = `perspective(1000px) rotateX(${rotateX}deg) rotateY(${rotateY}deg) scale3d(1.02, 1.02, 1.02)`;
      });
      
      heroVisual.addEventListener('mouseleave', () => {
        terminalNode.style.transform = `perspective(1000px) rotateX(0deg) rotateY(0deg) scale3d(1, 1, 1)`;
      });
    }
  });
</script>

<style>
  @keyframes heroEntrance {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero {
    padding-top: calc(var(--nav-height) + var(--space-2xl));
    padding-bottom: calc(var(--space-4xl) + 40px);
    position: relative;
  }

  /* Fluid Container Architecture */
  .hero-container {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: var(--space-3xl);
    align-items: start;
    position: relative;
    z-index: 10;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    animation: heroEntrance 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-full);
    padding: var(--space-xs) var(--space-md);
    font-size: var(--text-sm);
    color: var(--text-primary);
    margin-bottom: var(--space-xl);
    backdrop-filter: blur(10px);
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 10px var(--color-success);
    animation: pulse 3s ease-in-out infinite;
  }

  .hero-title {
    /* Using clamp for true fluid typography */
    font-size: clamp(2rem, 8vw, 4.5rem);
    margin-bottom: var(--space-lg);
    line-height: 1.05;
  }

  .hero-subtitle {
    margin-bottom: var(--space-2xl);
    font-size: var(--text-lg);
    color: #d4d4d8;
    max-width: 95%;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-bottom: var(--space-2xl);
    width: 100%;
  }

  .install-container {
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
    min-width: 280px;
    max-width: 540px;
  }

  /* Category pills */
  .install-categories {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-full);
    width: fit-content;
  }

  .cat-pill {
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all var(--transition-fast);
  }

  .cat-pill:hover {
    color: var(--text-primary);
  }

  .cat-pill.active {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-heading);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    font-weight: 600;
  }

  .cat-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  /* Channel Groups */
  .channel-groups {
    display: flex;
    align-items: center;
  }

  .channel-group {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .channel-tab {
    background: transparent;
    border: 1px solid transparent;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: all var(--transition-fast);
  }

  .channel-tab:hover {
    color: var(--text-primary);
    border-color: var(--border-subtle);
  }

  .channel-tab.active {
    background: rgba(0, 196, 204, 0.12);
    border-color: rgba(0, 196, 204, 0.3);
    color: var(--accent-primary);
    font-weight: 600;
  }

  .tab-badge {
    font-size: 0.65rem;
    opacity: 0.6;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-family: var(--font-sans);
  }

  /* Terminal prompt symbol */
  .terminal-prompt {
    color: var(--accent-primary);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    user-select: none;
    font-weight: 700;
  }

  /* Install Meta & Contextual Note */
  .install-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.75rem;
    padding: 2px 4px;
  }

  .install-note {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-secondary);
    font-size: 0.75rem;
    line-height: 1.4;
    max-width: 70%;
  }

  .note-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-primary);
    box-shadow: 0 0 6px var(--accent-primary);
    flex-shrink: 0;
  }

  .install-docs-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent-primary);
    font-weight: 500;
    font-size: 0.75rem;
    white-space: nowrap;
    text-decoration: none;
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .install-docs-link:hover {
    color: var(--accent-secondary);
    transform: translateX(2px);
  }

  copy-button.install-block {
    background: var(--bg-code);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    display: flex;
    align-items: center;
    min-width: 0;
    width: 100%;
    gap: var(--space-md);
    transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94), border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  copy-button.install-block:hover {
    border-color: var(--border-accent);
    box-shadow: var(--shadow-glow);
  }

  .install-command {
    display: block;
    flex: 1;
    min-width: 0;
    color: var(--text-primary);
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    text-align: left;
  }
  .install-command::-webkit-scrollbar { display: none; }

  .copy-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 4px;
    transition: color var(--transition-fast);
  }
  .copy-btn:hover { color: var(--text-primary); }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    background: var(--gradient-accent);
    color: #000000;
    padding: 12px 24px;
    border-radius: var(--radius-md);
    font-weight: 700;
    box-shadow: 0 0 20px var(--accent-glow-strong);
    transition: transform 0.2s cubic-bezier(0.25, 0.46, 0.45, 0.94), box-shadow var(--transition-fast);
  }
  .btn-primary:hover {
    box-shadow: 0 0 30px var(--accent-primary);
  }

  .hero-trust {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: center;
    gap: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--text-secondary);
    font-family: var(--font-mono);
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    position: relative;
    padding: 6px 12px;
    border-radius: var(--radius-full);
    background: rgba(255,255,255,0.02);
    border: 1px solid var(--border-subtle);
    overflow: hidden;
  }

  .trust-item::after {
    content: '';
    position: absolute;
    top: 0; left: -100%; width: 50%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
    transition: left 0.5s ease-in-out;
  }
  .trust-item:hover::after {
