---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const navPrefix = isHome ? '' : '/';

// Desktop Primary Navigation (High-Intent Focus)
const navItems = [
  { label: 'How It Works', href: `${navPrefix}#how-it-works`, targetId: 'how-it-works' },
  { label: 'Features', href: `${navPrefix}#features`, targetId: 'features' },
  { label: 'Compare', href: `${navPrefix}#compare`, targetId: 'compare' },
  { label: 'Docs', href: '/docs', targetId: 'docs', isPage: true }
];

// Complete Section Navigation for Mobile Drawer
const mobileNavItems = [
  { label: 'How It Works', href: `${navPrefix}#how-it-works`, targetId: 'how-it-works' },
  { label: 'Features', href: `${navPrefix}#features`, targetId: 'features' },
  { label: 'Compare', href: `${navPrefix}#compare`, targetId: 'compare' },
  { label: 'Philosophy', href: `${navPrefix}#philosophy`, targetId: 'philosophy' },
  { label: 'Roadmap', href: `${navPrefix}#roadmap`, targetId: 'roadmap' }
];

const isActive = (path: string) => {
  if (path === '/') return pathname === '/' ? 'active' : '';
  return pathname === path || pathname.startsWith(path + '/') ? 'active' : '';
};
---

<header class="navbar" id="navbar">
  <div class="nav-container">
    <div class="nav-brand">
      <a href="/" aria-label="GitSetu Home">
        <picture>
          <source srcset="/logo.webp" type="image/webp" />
          <img src="/logo.png" alt="GitSetu" class="brand-logo" width="24" height="24" loading="eager" decoding="async" />
        </picture>
        GitSetu
        <span class="brand-badge">v1.0.0</span>
      </a>
    </div>

    <nav class="nav-menu" aria-label="Primary navigation">
      <ul class="nav-links">
        {navItems.map(item => (
          <li>
            <a 
              href={item.href} 
              data-section={item.targetId}
              class={item.isPage ? isActive(item.href) : ''}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <!-- Command Palette Trigger -->
      <button class="cmd-palette-btn" id="search-btn" aria-label="Search documentation and commands">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <span class="cmd-text">Search...</span>
        <kbd id="cmd-key">⌘K</kbd>
      </button>

      <a href="https://github.com/bhaskarjha-dev/gitsetu" target="_blank" rel="noopener" class="github-link" aria-label="GitHub Repository">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
      </a>
      <a href="/docs/getting-started/quickstart" class="btn btn-primary nav-cta">Get Started</a>
      <button class="mobile-nav-toggle" aria-expanded="false" aria-controls="mobile-menu" aria-label="Toggle mobile menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown Panel -->
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" aria-hidden="true">
    <div class="mobile-menu-inner">
      <div class="mobile-group-title">Navigation</div>
      <div class="mobile-nav-group">
        {mobileNavItems.map(item => (
          <a href={item.href} data-section={item.targetId} class="mobile-nav-link">
            <span class="mobile-nav-bullet" aria-hidden="true"></span>
            <span>{item.label}</span>
          </a>
        ))}
      </div>

      <div class="mobile-group-title">Resources</div>
      <div class="mobile-nav-group">
        <a href="/docs" class={`mobile-nav-link ${isActive('/docs')}`}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          <span>Documentation</span>
          <span class="mobile-link-badge">Docs</span>
        </a>
        <a href="https://github.com/bhaskarjha-dev/gitsetu" target="_blank" rel="noopener" class="mobile-nav-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg>
          <span>GitHub Repository</span>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="margin-left: auto; opacity: 0.5;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
        </a>
        <a href="/docs/getting-started/quickstart" class="mobile-nav-link">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          <span>Get Started (Quickstart)</span>
          <span class="mobile-link-badge" style="background: rgba(0, 196, 204, 0.15); color: var(--accent-primary); border-color: rgba(0, 196, 204, 0.3);">Start</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Mobile Backdrop Overlay -->
  <div class="mobile-menu-backdrop" id="mobile-menu-backdrop" aria-hidden="true"></div>
</header>

<script>
  class NavbarManager extends HTMLElement {
    private scrollHandler: (() => void) | null = null;
    private navbar: HTMLElement | null = null;
    private searchBtn: HTMLElement | null = null;
    private mobileToggle: HTMLElement | null = null;
    private mobileMenu: HTMLElement | null = null;
    private handleSearchClick: (() => void) | null = null;
    private handleToggleClick: (() => void) | null = null;
    private handleMenuLinkClick: (() => void) | null = null;
    private sectionObserver: IntersectionObserver | null = null;
    private hashUpdateTimer: number | null = null;
    private handleBeforeSwap: (() => void) | null = null;

    connectedCallback() {
      this.navbar = document.getElementById('navbar');
      this.scrollHandler = () => {
        if (window.scrollY > 20) {
          this.navbar?.classList.add('scrolled');
        } else {
          this.navbar?.classList.remove('scrolled');
        }
      };

      window.addEventListener('scroll', this.scrollHandler, { passive: true });
      this.scrollHandler();

      this.searchBtn = document.getElementById('search-btn');
      const cmdKey = document.getElementById('cmd-key');
      
      if (navigator.platform.toUpperCase().indexOf('MAC') < 0 && cmdKey) {
        cmdKey.textContent = 'Ctrl+K';
      }

      this.handleSearchClick = () => {
        document.dispatchEvent(new CustomEvent('open-command-palette'));
      };
      this.searchBtn?.addEventListener('click', this.handleSearchClick);

      this.mobileToggle = document.querySelector('.mobile-nav-toggle');
      this.mobileMenu = document.getElementById('mobile-menu');
      const backdrop = document.getElementById('mobile-menu-backdrop');
      const getBackgroundElements = () => Array.from(document.querySelectorAll('main, footer, .site-footer')) as HTMLElement[];

      const closeMenu = () => {
        this.mobileMenu?.classList.remove('active');
        this.mobileMenu?.setAttribute('aria-hidden', 'true');
        this.mobileToggle?.setAttribute('aria-expanded', 'false');
        this.navbar?.classList.remove('menu-open');
        backdrop?.classList.remove('active');
        document.body.style.overflow = '';
        getBackgroundElements().forEach(el => el.removeAttribute('inert'));
      };

      const openMenu = () => {
        this.mobileMenu?.classList.add('active');
        this.mobileMenu?.setAttribute('aria-hidden', 'false');
        this.mobileToggle?.setAttribute('aria-expanded', 'true');
        this.navbar?.classList.add('menu-open');
        backdrop?.classList.add('active');
        document.body.style.overflow = 'hidden';
        getBackgroundElements().forEach(el => el.setAttribute('inert', ''));
      };

      this.handleToggleClick = () => {
        const isExpanded = this.mobileToggle?.getAttribute('aria-expanded') === 'true';
        if (isExpanded) {
          closeMenu();
        } else {
          openMenu();
        }
      };
      this.mobileToggle?.addEventListener('click', this.handleToggleClick);
      backdrop?.addEventListener('click', closeMenu);

      // Auto-close mobile menu when any navigation link is clicked
      this.handleMenuLinkClick = () => {
        closeMenu();
      };
      this.mobileMenu?.querySelectorAll('a').forEach(a => {
        a.addEventListener('click', this.handleMenuLinkClick!);
      });

      // Close on Escape key
      const handleEscape = (e: KeyboardEvent) => {
        if (e.key === 'Escape' && this.mobileMenu?.classList.contains('active')) {
          closeMenu();
        }
      };
      window.addEventListener('keydown', handleEscape);

      // Initialize Landing Scrollspy
      this.setupScrollspy();

      this.handleBeforeSwap = () => {
        this.cleanupScrollspy();
      };
      document.addEventListener('astro:before-swap', this.handleBeforeSwap, { once: true });
    }

    private setupScrollspy() {
      const sections = Array.from(document.querySelectorAll('main section[id]')) as HTMLElement[];
      if (sections.length === 0) return;

      const navLinks = Array.from(document.querySelectorAll('.nav-links a[data-section], .mobile-menu a[data-section]')) as HTMLAnchorElement[];
      if (navLinks.length === 0) return;

      const setActiveSection = (activeId: string | null) => {
        navLinks.forEach(link => {
          const targetSection = link.getAttribute('data-section');
          const isMatch = !!activeId && (
            targetSection === activeId || 
            (targetSection === 'how-it-works' && (activeId === 'capabilities' || activeId === 'how-it-works')) ||
            (targetSection === 'compare' && (activeId === 'comparison' || activeId === 'compare' || activeId === 'syntax-compare'))
          );
          if (isMatch) {
            link.classList.add('active');
            link.setAttribute('aria-current', 'location');
          } else {
            link.classList.remove('active');
            link.removeAttribute('aria-current');
          }
        });

        // Non-intrusive URL hash sync without scroll jumps
        if (activeId && window.location.pathname === '/') {
          if (this.hashUpdateTimer) {
            window.clearTimeout(this.hashUpdateTimer);
          }
          this.hashUpdateTimer = window.setTimeout(() => {
            const currentHash = window.location.hash.replace('#', '');
            if (currentHash !== activeId && activeId !== 'install') {
              history.replaceState(null, '', `#${activeId}`);
            } else if (activeId === 'install' && currentHash) {
              history.replaceState(null, '', window.location.pathname);
            }
          }, 250);
        }
      };

      this.sectionObserver = new IntersectionObserver((entries) => {
        const visibleEntries = entries.filter(e => e.isIntersecting);
        if (visibleEntries.length > 0) {
          visibleEntries.sort((a, b) => {
            return Math.abs(a.boundingClientRect.top) - Math.abs(b.boundingClientRect.top);
          });
          const bestId = visibleEntries[0].target.getAttribute('id');
          if (bestId) {
            setActiveSection(bestId);
          }
        } else if (window.scrollY < 120) {
          setActiveSection(null);
        }
      }, {
        rootMargin: '-20% 0px -50% 0px',
        threshold: [0, 0.2, 0.5, 0.8]
      });

      sections.forEach(sec => this.sectionObserver?.observe(sec));
    }

    private cleanupScrollspy() {
      if (this.sectionObserver) {
        this.sectionObserver.disconnect();
        this.sectionObserver = null;
      }
      if (this.hashUpdateTimer) {
        window.clearTimeout(this.hashUpdateTimer);
        this.hashUpdateTimer = null;
      }
    }

    disconnectedCallback() {
      if (this.scrollHandler) {
        window.removeEventListener('scroll', this.scrollHandler);
        this.scrollHandler = null;
      }
      if (this.searchBtn && this.handleSearchClick) {
        this.searchBtn.removeEventListener('click', this.handleSearchClick);
        this.handleSearchClick = null;
      }
      if (this.mobileToggle && this.handleToggleClick) {
        this.mobileToggle.removeEventListener('click', this.handleToggleClick);
        this.handleToggleClick = null;
      }
      if (this.mobileMenu && this.handleMenuLinkClick) {
        this.mobileMenu.querySelectorAll('a').forEach(a => {
          a.removeEventListener('click', this.handleMenuLinkClick!);
        });
        this.handleMenuLinkClick = null;
      }
      this.cleanupScrollspy();
      document.querySelectorAll('main, footer, .site-footer').forEach(el => el.removeAttribute('inert'));
      if (this.handleBeforeSwap) {
        document.removeEventListener('astro:before-swap', this.handleBeforeSwap);
        this.handleBeforeSwap = null;
      }
      this.navbar = null;
      this.searchBtn = null;
      this.mobileToggle = null;
      this.mobileMenu = null;
    }
  }

  if (!customElements.get('navbar-manager')) {
    customElements.define('navbar-manager', NavbarManager);
  }
</script>

<navbar-manager></navbar-manager>

<style>
  .navbar {
    position: fixed;
    top: var(--space-md);
    left: 0;
    right: 0;
    margin-inline: auto;
    width: min(var(--max-width), calc(100% - 2rem));
    height: 60px;
    /* Base Glassmorphism */
    background: rgba(8, 8, 12, 0.55);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-full);
    z-index: 100;
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    /* Liquid highlight edge */
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.1), 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .navbar.menu-open,
  .navbar:has(.mobile-menu.active) {
    overflow: visible;
  }

  /* Refined Shrunk Floating Capsule on Scroll */
  .navbar.scrolled {
    top: 10px;
    width: min(1040px, calc(100% - 3.5rem));
    height: 52px;
    background: rgba(6, 6, 9, 0.88);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-color: rgba(0, 196, 204, 0.3);
    box-shadow: inset 0 1px 1px rgba(255, 255, 255, 0.18), 0 20px 40px rgba(0, 0, 0, 0.9), 0 0 24px rgba(0, 196, 204, 0.15);
  }

  .nav-container {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(0.75rem, 2vw, 1.5rem);
    width: 100%;
    transition: padding 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .navbar.scrolled .nav-container {
    padding: 0 clamp(0.6rem, 1.6vw, 1.25rem);
  }

  .navbar.scrolled .brand-logo {
    width: 21px;
    height: 21px;
  }

  .navbar.scrolled .nav-brand a {
    font-size: 1.05rem;
  }

  .navbar.scrolled .brand-badge {
    font-size: 0.65rem;
    padding: 1px 6px;
  }

  .navbar.scrolled .nav-links {
    gap: clamp(0.2rem, 0.9vw, 0.85rem);
    margin-left: clamp(0.5rem, 1.5vw, 1.5rem);
  }

  .navbar.scrolled .nav-links a {
    padding: 4px clamp(6px, 0.8vw, 11px);
    font-size: 0.82rem;
  }

  .navbar.scrolled .cmd-palette-btn {
    padding: 5px 10px;
    font-size: 0.82rem;
  }

  .navbar.scrolled .nav-cta {
    padding: 6px 15px;
    font-size: 0.82rem;
  }

  .nav-brand a {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-heading);
    font-weight: 700;
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
    position: relative;
    white-space: nowrap;
    text-decoration: none;
    flex-shrink: 0;
  }
  .nav-brand a::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    box-shadow: 0 0 20px var(--accent-glow);
    opacity: 0;
    transition: opacity var(--transition-base);
    z-index: -1;
  }
  .nav-brand a:hover::after {
    opacity: 1;
  }

  .brand-logo {
    display: block;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .brand-badge {
    font-size: 0.68rem;
    font-weight: 600;
    font-family: var(--font-mono, monospace);
    color: var(--accent-primary);
    background: rgba(0, 196, 204, 0.12);
    border: 1px solid rgba(0, 196, 204, 0.3);
    padding: 2px 7px;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
    line-height: 1.2;
    margin-left: 2px;
    white-space: nowrap;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: clamp(0.4rem, 1.2vw, 1.25rem);
    list-style: none;
    margin-left: clamp(0.75rem, 2vw, 2rem);
  }

  .nav-links a {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none !important;
    padding: 6px clamp(8px, 1vw, 14px);
    border-radius: var(--radius-full);
    transition: all var(--transition-fast);
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .nav-links a:hover {
    color: var(--text-heading);
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-links a.active {
    color: var(--accent-primary);
    background: rgba(0, 196, 204, 0.1);
    border-color: rgba(0, 196, 204, 0.3);
    box-shadow: 0 0 12px rgba(0, 196, 204, 0.15);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: clamp(0.5rem, 1vw, 0.85rem);
    margin-left: auto;
    flex-shrink: 0;
  }

  /* Command Palette Button */
  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .cmd-palette-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-full);
    padding: 6px 12px;
    color: var(--text-primary);
    font-size: var(--text-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .cmd-palette-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    color: var(--text-heading);
    border-color: var(--border-accent);
    box-shadow: 0 0 10px var(--accent-glow);
  }
  .cmd-palette-btn:focus-visible {
    outline: none;
    border-color: var(--border-accent);
    box-shadow: 0 0 0 1px rgba(0, 196, 204, 0.4), 0 0 12px var(--accent-glow);
  }
  .cmd-palette-btn kbd {
    margin-left: 6px;
    background: linear-gradient(120deg, rgba(0,0,0,0.6) 25%, rgba(0, 196, 204, 0.3) 50%, rgba(0,0,0,0.6) 75%);
    background-size: 200% 100%;
    animation: shimmer 3s infinite linear;
    border: 1px solid var(--border-card);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-secondary);
  }

  .github-link {
    display: flex;
    align-items: center;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
    flex-shrink: 0;
  }
  .github-link:hover {
    color: var(--text-primary);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px 16px;
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: all var(--transition-fast);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .btn-outline {
    color: var(--text-primary);
    border: 1px solid var(--border-card);
    background: rgba(255, 255, 255, 0.03);
  }

  .btn-outline:hover {
    border-color: var(--border-accent);
    color: var(--accent-primary);
    background: var(--accent-glow);
    box-shadow: 0 0 15px var(--accent-glow);
  }

  .btn-outline.active {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
    background: rgba(0, 196, 204, 0.12);
    box-shadow: 0 0 15px var(--accent-glow);
  }

  .btn-primary {
    background: var(--accent-primary);
    color: #000;
    font-weight: 600;
    border: 1px solid var(--accent-primary);
    box-shadow: 0 0 16px var(--accent-glow);
  }

