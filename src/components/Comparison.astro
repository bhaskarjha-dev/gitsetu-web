---
const comparisonData = [
  { feature: 'Zero runtime dependencies', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: 'Zero-prompt auto-discovery (--auto)', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: 'Preserves existing manual configs & SSH keys', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: 'Standard clone URLs (no custom Host aliases)', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: 'Pre-commit identity guard', gitsetu: '✅', gitego: '⚡', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: 'Native includeIf sandboxing', gitsetu: '✅', gitego: '✅', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: 'Auto-provisioned workspaces (mkdir -p)', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: 'Longest-prefix match routing', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: 'Automated SSH key generation', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: 'Zero-Trust SSH Isolation (ADR 0002)', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: 'Per-profile Credential Broker', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '⚡', gcm: '✅' },
  { feature: 'GPG & SSH commit signing', gitsetu: '✅', gitego: '❌', karn: '⚡', gh: '❌', gcm: '❌' },
  { feature: 'FIDO2 / YubiKey Support', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: '9 Distribution Channels (npx, brew, winget, etc.)', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '⚡', gcm: '⚡' },
  { feature: 'Standalone monolith bundle (no git clone)', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: '36 Automated Test Suites (Clean-Room + Sandbox VM)', gitsetu: '✅', gitego: '❌', karn: '❌', gh: '❌', gcm: '❌' },
  { feature: 'Runtime', gitsetu: 'Bash 3.2', gitego: 'Go', karn: 'Go', gh: 'Go', gcm: '.NET' }
];

const getCellClass = (val: string) => {
  if (val === '✅') return 'success';
  if (val === '⚡') return 'warning';
  if (val === '❌') return 'neutral';
  return 'runtime-val';
};

const getCellLabel = (val: string) => {
  if (val === '✅') return 'Supported';
  if (val === '⚡') return 'Partial';
  if (val === '❌') return 'Not supported';
  return undefined;
};
---

<section class="comparison section reveal" id="compare">
  <div id="comparison" style="position: absolute; top: -80px;"></div>
  <div class="container">
    <h2 class="section-title">How GitSetu compares.</h2>
    <p class="section-subtitle">Verified v1.0.0 GA specification against competing ecosystem tools.</p>

    <div class="table-container" tabindex="0" role="region" aria-label="Ecosystem feature comparison table">
      <table class="compare-table">
        <thead>
          <tr>
            <th scope="col" class="feature-col">Feature</th>
            <th scope="col" class="gitsetu-col">GitSetu</th>
            <th scope="col">gitego</th>
            <th scope="col">karn</th>
            <th scope="col">gh CLI</th>
            <th scope="col">GCM</th>
          </tr>
        </thead>
        <tbody>
          {comparisonData.map((row) => (
            <tr>
              <th scope="row" class="feature-cell">{row.feature}</th>
              <td class="gitsetu-cell">
                <span class={getCellClass(row.gitsetu)} aria-label={getCellLabel(row.gitsetu)}>
                  {row.gitsetu}
                </span>
              </td>
              <td class="competitor-cell">
                <span class={getCellClass(row.gitego)} aria-label={getCellLabel(row.gitego)}>
                  {row.gitego}
                </span>
              </td>
              <td class="competitor-cell">
                <span class={getCellClass(row.karn)} aria-label={getCellLabel(row.karn)}>
                  {row.karn}
                </span>
              </td>
              <td class="competitor-cell">
                <span class={getCellClass(row.gh)} aria-label={getCellLabel(row.gh)}>
                  {row.gh}
                </span>
              </td>
              <td class="competitor-cell">
                <span class={getCellClass(row.gcm)} aria-label={getCellLabel(row.gcm)}>
                  {row.gcm}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="legend">
      <span><span class="success">✅</span> Full support</span>
      <span><span class="warning">⚡</span> Partial (e.g. GPG but no SSH)</span>
      <span><span class="neutral">❌</span> None</span>
    </div>
  </div>
</section>

<style>
  .comparison {
    background: var(--bg-secondary);
  }

  .table-container {
    width: 100%;
    overflow-x: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-card);
    background: var(--bg-primary);
  }

  .compare-table {
    width: 100%;
    border-collapse: collapse;
    text-align: center;
    white-space: nowrap;
  }

  .compare-table th {
    padding: var(--space-lg) var(--space-md);
    font-weight: 600;
    color: var(--text-heading);
    border-bottom: 1px solid var(--border-card);
    background: var(--bg-tertiary);
  }

  .compare-table td {
    padding: var(--space-md);
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text-secondary);
  }

  .compare-table tr:last-child td {
    border-bottom: none;
  }

  .compare-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .feature-col, .feature-cell {
    text-align: left;
    position: sticky;
    left: 0;
    background: var(--bg-primary);
    z-index: 10;
  }

  .compare-table th.feature-col {
    background: var(--bg-tertiary);
  }

  .compare-table tbody tr:hover .feature-cell {
    background: var(--bg-tertiary);
  }

  .feature-cell {
    font-weight: 500;
    color: var(--text-primary);
  }

  .gitsetu-col, .gitsetu-cell {
    background: rgba(0, 196, 204, 0.05);
    font-weight: 600;
  }

  .gitsetu-col {
    color: var(--accent-primary) !important;
  }

  .compare-table tbody tr:hover .gitsetu-cell {
    background: rgba(0, 196, 204, 0.1);
  }

  .competitor-cell {
    opacity: 0.8;
  }

  /* Specific styling for the Runtime row to not look like emojis */
  .compare-table tr:last-child td span {
    font-size: var(--text-sm);
    opacity: 1;
  }

  .success {
    color: var(--color-success);
  }

  .warning {
    color: var(--color-warning);
  }

  .neutral {
    opacity: 0.3;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xl);
    margin-top: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .legend span span {
    margin-right: 4px;
  }

  @media (max-width: 768px) {
    .compare-table th, .compare-table td {
      padding: var(--space-xs) var(--space-sm);
      font-size: var(--text-xs);
    }
  }

  @media (max-width: 600px) {
    .feature-col, .feature-cell {
      max-width: 140px;
      min-width: 120px;
      white-space: normal;
      word-break: break-word;
      line-height: 1.3;
      padding: 8px 6px;
      box-shadow: 2px 0 6px rgba(0, 0, 0, 0.4);
    }

    .compare-table th, .compare-table td {
      padding: 8px 8px;
    }

    .legend {
      flex-direction: column;
      align-items: center;
      gap: var(--space-sm);
    }
  }
</style>
