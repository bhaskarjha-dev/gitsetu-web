<visual-capabilities>
<section class="capabilities-section section reveal" id="capabilities">
  <div class="capabilities-container container">
    <div class="capabilities-header reveal delay-100">
      <h2 class="section-title">Visualizing <span class="accent-text">Zero-Trust</span></h2>
      <p class="section-subtitle">How GitSetu cryptographically separates your identities without relying on fragile global state.</p>
    </div>

    <div class="visualizer-stage reveal delay-200">
      
      <!-- Interactive Terminal Directory Switcher -->
      <div class="stage-switcher" role="tablist" aria-label="Simulate Directory Traversal">
        <span class="switcher-prompt" aria-hidden="true">terminal:~$</span>
        <div class="switcher-buttons">
          <button class="switcher-btn active" id="btn-work" role="tab" aria-selected="true" aria-controls="work-node" data-target="work">
            <span class="folder-icon">📁</span>
            <span class="btn-cmd">cd ~/work/acme</span>
            <span class="active-dot" aria-hidden="true"></span>
          </button>
          <button class="switcher-btn" id="btn-personal" role="tab" aria-selected="false" aria-controls="personal-node" data-target="personal">
            <span class="folder-icon">📁</span>
            <span class="btn-cmd">cd ~/projects/oss</span>
            <span class="active-dot" aria-hidden="true"></span>
          </button>
        </div>
      </div>

      <!-- Central Hub / Core Engine -->
      <div class="core-node" aria-label="GitSetu Zero-Daemon Core Engine">
        <div class="pulse-ring"></div>
        <div class="node-inner">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          <div class="core-text">
            <span class="core-title">GitSetu Core</span>
            <span class="core-tag">Zero-Daemon Engine</span>
          </div>
        </div>
      </div>

      <!-- Connection Lines -->
      <svg class="connection-lines" width="100%" height="100%" aria-hidden="true">
        <!-- Work Path -->
        <path id="work-line" class="line-path work-path" d="" />
        <!-- Personal Path -->
        <path id="personal-line" class="line-path personal-path" d="" />
      </svg>
      
      <!-- Data Orbs -->
      <div class="data-orb work-orb" aria-hidden="true"></div>
      <div class="data-orb personal-orb" aria-hidden="true"></div>

      <!-- Work Environment Card -->
      <div class="env-card work-card is-active" id="work-node" role="tabpanel" tabindex="0" data-env="work" aria-label="Work Profile Environment">
        <div class="card-status-badge">
          <span class="status-dot"></span>
          <span class="status-label">ACTIVE IDENTITY</span>
        </div>
        <div class="card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
          <span class="card-dir">~/work/acme</span>
        </div>
        <div class="card-body">
          <div class="card-row">
            <span class="row-label">Author</span>
            <span class="row-val">eng@acme.corp</span>
          </div>
          <div class="card-row">
            <span class="row-label">SSH Key</span>
            <span class="row-val">Hardware FIDO2 (YubiKey)</span>
          </div>
          <div class="card-row">
            <span class="row-label">Isolation</span>
            <span class="row-val text-emerald">Strict /dev/null Shield</span>
          </div>
        </div>
      </div>

      <!-- Personal Environment Card -->
      <div class="env-card personal-card is-shielded" id="personal-node" role="tabpanel" tabindex="0" data-env="personal" aria-label="Personal Profile Environment">
        <div class="card-status-badge">
          <span class="status-dot"></span>
          <span class="status-label">SHIELDED (INACTIVE)</span>
        </div>
        <div class="card-header">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          <span class="card-dir">~/projects/oss</span>
        </div>
        <div class="card-body">
          <div class="card-row">
            <span class="row-label">Author</span>
            <span class="row-val">me@bhaskarjha.dev</span>
          </div>
          <div class="card-row">
            <span class="row-label">SSH Key</span>
            <span class="row-val">id_ed25519 (Personal)</span>
          </div>
          <div class="card-row">
            <span class="row-label">Isolation</span>
            <span class="row-val text-muted">Zero Crossover</span>
          </div>
        </div>
      </div>

      <!-- Interactive Context Strip & Architectural Guarantees -->
      <div class="stage-footer">
        <div class="live-explanation" id="live-explanation">
          <span class="exp-icon" aria-hidden="true">💡</span>
          <span class="exp-text" id="exp-text">
            <strong>In this folder:</strong> Every <code>git commit</code> automatically signs as <strong>eng@acme.corp</strong> using your corporate hardware key. Your personal keys are locked out.
          </span>
        </div>

        <div class="stage-badges">
          <div class="guarantee-badge" title="No background process or daemon">
            <span class="badge-icon">🍃</span>
            <span>0 KB Resident RAM</span>
          </div>
          <div class="guarantee-badge" title="Sub-millisecond native Git resolution">
            <span class="badge-icon">⚡</span>
            <span>&lt; 1.8ms Switch Time</span>
          </div>
          <div class="guarantee-badge" title="Fail-closed pre-commit guard">
            <span class="badge-icon">🛡️</span>
            <span>Zero Credential Leaks</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
</visual-capabilities>

<style>
  .capabilities-container {
    width: 100%;
  }

  .visualizer-stage {
    position: relative;
    width: 100%;
    min-height: 560px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-xl);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-xl) var(--space-xl) var(--space-lg);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4), inset 0 0 100px var(--accent-glow);
  }

  /* Ambient Grid Background */
  .visualizer-stage::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    background-position: center;
    z-index: 0;
    opacity: 0.5;
    pointer-events: none;
  }

  /* --- Top Terminal Switcher Bar --- */
  .stage-switcher {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid var(--border-subtle);
    padding: 6px 10px;
    border-radius: var(--radius-full);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
  }

  .switcher-prompt {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--accent-primary);
    font-weight: 600;
    padding-left: 6px;
    user-select: none;
  }

  .switcher-buttons {
    display: flex;
    gap: 6px;
  }

  .switcher-btn {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 8px;
    transition: all var(--transition-fast);
  }

  .switcher-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-heading);
    border-color: rgba(255, 255, 255, 0.2);
  }

  .switcher-btn:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 2px;
  }

  .switcher-btn.active {
    background: rgba(0, 196, 204, 0.15);
    color: var(--accent-primary);
    border-color: var(--accent-primary);
    box-shadow: 0 0 16px var(--accent-glow);
    font-weight: 600;
  }

  .switcher-btn[data-target="personal"].active {
    background: rgba(167, 139, 250, 0.15);
    color: #c4b5fd;
    border-color: #a78bfa;
    box-shadow: 0 0 16px rgba(167, 139, 250, 0.25);
  }

  .active-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .switcher-btn.active .active-dot {
    opacity: 1;
    box-shadow: 0 0 6px currentColor;
  }

  /* --- Central Core Engine Hub --- */
  .core-node {
    position: absolute;
    top: 48%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 10;
  }

  .node-inner {
    background: rgba(18, 18, 18, 0.9);
    border: 1px solid var(--border-accent);
    padding: 12px 20px;
    border-radius: var(--radius-full);
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--accent-primary);
    box-shadow: 0 0 30px var(--accent-glow-strong);
    position: relative;
    z-index: 2;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .core-text {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .core-title {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-heading);
    letter-spacing: -0.01em;
  }

  .core-tag {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--accent-primary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .pulse-ring {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    height: 100%;
    border-radius: var(--radius-full);
    border: 2px solid var(--accent-primary);
    animation: ping 3s cubic-bezier(0, 0, 0.2, 1) infinite;
    z-index: 1;
    opacity: 0.4;
  }

  @keyframes ping {
    75%, 100% {
      transform: translate(-50%, -50%) scale(1.8);
      opacity: 0;
    }
  }

  /* --- SVG Connection Lines --- */
  .connection-lines {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .line-path {
    fill: none;
    stroke: var(--border-subtle);
    stroke-width: 2;
    transition: stroke 0.4s ease, stroke-width 0.4s ease, opacity 0.4s ease;
  }

  .work-path {
    stroke: var(--accent-primary);
    opacity: 0.8;
  }

  .personal-path {
    stroke: #a78bfa;
    opacity: 0.25;
  }

  .personal-active .work-path {
    opacity: 0.25;
    stroke: var(--border-subtle);
  }

  .personal-active .personal-path {
    opacity: 0.8;
    stroke: #a78bfa;
  }

  /* --- Data Orbs --- */
  .data-orb {
    position: absolute;
    top: 0; left: 0;
    width: 12px; height: 12px;
    border-radius: 50%;
    offset-distance: 0%;
    z-index: 4;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .data-orb.active {
    opacity: 1;
  }

  .work-orb {
    background: var(--accent-primary);
    box-shadow: 0 0 15px var(--accent-primary), 0 0 30px var(--accent-primary);
    offset-path: var(--work-path);
    animation: flowOrb 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  .personal-orb {
    background: #c4b5fd;
    box-shadow: 0 0 15px #a78bfa, 0 0 30px #a78bfa;
    offset-path: var(--personal-path);
    animation: flowOrb 2.2s cubic-bezier(0.4, 0, 0.2, 1) infinite 0.5s;
    opacity: 0.3;
  }

  .personal-active .personal-orb {
    opacity: 1;
  }

  .personal-active .work-orb {
    opacity: 0.2;
  }

  @keyframes flowOrb {
    0% { offset-distance: 0%; opacity: 0; transform: scale(0.5); }
    15% { opacity: 1; transform: scale(1); }
    85% { opacity: 1; transform: scale(1); }
    100% { offset-distance: 100%; opacity: 0; transform: scale(1.8); }
  }

  /* --- Environment Cards --- */
  .env-card {
    position: absolute;
    width: 290px;
    background: rgba(14, 14, 16, 0.85);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-lg);
    z-index: 5;
    padding: 14px 16px;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    outline: none;
  }

  .env-card:hover {
    transform: translateY(-3px);
  }

  .env-card:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: 4px;
  }

  .work-card {
    top: 22%;
    left: 8%;
  }

  .personal-card {
    bottom: 22%;
    right: 8%;
  }

  /* Active vs Shielded States */
  .env-card.is-active {
    border-color: var(--accent-primary);
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 25px var(--accent-glow-strong);
    opacity: 1;
  }

  .personal-card.is-active {
    border-color: #a78bfa;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.6), 0 0 25px rgba(167, 139, 250, 0.25);
  }

  .env-card.is-shielded {
    opacity: 0.45;
    border-style: dashed;
    border-color: rgba(255, 255, 255, 0.12);
    box-shadow: none;
  }

  .env-card.is-shielded:hover {
    opacity: 0.75;
    border-color: rgba(255, 255, 255, 0.25);
  }

  /* Card Inner Elements */
  .card-status-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.05em;
    margin-bottom: 8px;
  }

  .work-card.is-active .card-status-badge {
    color: var(--accent-primary);
  }

  .personal-card.is-active .card-status-badge {
    color: #c4b5fd;
  }

  .env-card.is-shielded .card-status-badge {
    color: var(--text-muted);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .env-card.is-active .status-dot {
    box-shadow: 0 0 8px currentColor;
    animation: beaconPulse 2s infinite;
  }

  @keyframes beaconPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-heading);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 10px;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .card-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .row-label {
    color: var(--text-muted);
  }

  .row-val {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .text-emerald {
    color: var(--color-success);
  }

  .text-muted {
    color: var(--text-muted);
  }

  /* --- Bottom Stage Footer (Live Context & Badges) --- */
  .stage-footer {
    position: relative;
    z-index: 10;
    width: 100%;
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .live-explanation {
    background: rgba(0, 0, 0, 0.7);
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-lg);
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    transition: border-color 0.3s ease;
  }

  .personal-active .live-explanation {
    border-color: rgba(167, 139, 250, 0.4);
  }

  .exp-icon {
    font-size: 16px;
    flex-shrink: 0;
  }

  .exp-text {
    font-size: 13px;
    color: var(--text-primary);
    line-height: 1.45;
  }

  .exp-text strong {
    color: var(--text-heading);
  }

  .exp-text code {
    font-family: var(--font-mono);
    background: rgba(255, 255, 255, 0.08);
    padding: 1px 5px;
    border-radius: 4px;
    font-size: 12px;
    color: var(--accent-primary);
  }

  .personal-active .exp-text code {
    color: #c4b5fd;
  }

  .stage-badges {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .guarantee-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-secondary);
    transition: all var(--transition-fast);
  }

  .guarantee-badge:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-heading);
  }

  .badge-icon {
    font-size: 12px;
  }

  /* --- Responsive Layout (< 800px) --- */
  @media (max-width: 800px) {
    .visualizer-stage {
      min-height: auto;
      padding: var(--space-lg) var(--space-md);
      gap: var(--space-xl);
    }

    .stage-switcher {
      width: 100%;
      flex-direction: column;
      border-radius: var(--radius-md);
      padding: var(--space-sm);
    }

    .switcher-buttons {
      width: 100%;
      flex-direction: column;
    }

    .switcher-btn {
      width: 100%;
      justify-content: center;
    }

    .core-node, .env-card {
      position: relative;
      top: auto;
      left: auto;
      right: auto;
      bottom: auto;
      transform: none;
      width: 100%;
      max-width: 320px;
      margin: 0 auto;
    }

    .connection-lines {
      opacity: 0.6;
    }

    .live-explanation {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
    }

    .stage-badges {
      flex-direction: column;
      width: 100%;
    }

    .guarantee-badge {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  interface FolderExplanation {
    text: string;
  }

  const FOLDER_EXPLANATIONS: Record<string, string> = {
    work: '<strong>In this folder:</strong> Every <code>git commit</code> automatically signs as <strong>eng@acme.corp</strong> using your corporate hardware key. Your personal keys are locked out.',
    personal: '<strong>In this folder:</strong> Every <code>git commit</code> seamlessly uses <strong>me@bhaskarjha.dev</strong>. Corporate credentials and tokens cannot be accessed.'
  };

  class VisualCapabilities extends HTMLElement {
    private resizeObserver: ResizeObserver | null = null;
    private activeEnv: string = 'work';

    connectedCallback() {
      const stage = this.querySelector('.visualizer-stage');
      if (!stage) return;
      
      this.resizeObserver = new ResizeObserver(() => this.drawLines());
      this.resizeObserver.observe(stage);

      this.setupInteractiveSwitcher();
      this.setEnvironment(this.activeEnv);
    }

    disconnectedCallback() {
      if (this.resizeObserver) {
        this.resizeObserver.disconnect();
        this.resizeObserver = null;
      }
    }

    private setupInteractiveSwitcher() {
      // Switcher Buttons
      const buttons = this.querySelectorAll('.switcher-btn');
      buttons.forEach((btn) => {
        const target = btn.getAttribute('data-target');
        if (!target) return;

        btn.addEventListener('click', () => {
          this.setEnvironment(target);
        });
      });

      // Cards also act as interactive targets
      const cards = this.querySelectorAll('.env-card');
      cards.forEach((card) => {
        const env = card.getAttribute('data-env');
        if (!env) return;

        card.addEventListener('click', () => {
          this.setEnvironment(env);
        });

        card.addEventListener('keydown', (e: Event) => {
          const ke = e as KeyboardEvent;
          if (ke.key === 'Enter' || ke.key === ' ') {
            ke.preventDefault();
            this.setEnvironment(env);
          }
        });
      });
    }

    private setEnvironment(env: string) {
      this.activeEnv = env;
      const stage = this.querySelector('.visualizer-stage');
      if (!stage) return;

      const isPersonal = env === 'personal';
      stage.classList.toggle('personal-active', isPersonal);

      // Update Switcher Buttons
      const btnWork = this.querySelector('#btn-work');
      const btnPersonal = this.querySelector('#btn-personal');

      if (btnWork) {
        btnWork.classList.toggle('active', !isPersonal);
        btnWork.setAttribute('aria-selected', String(!isPersonal));
      }
      if (btnPersonal) {
        btnPersonal.classList.toggle('active', isPersonal);
        btnPersonal.setAttribute('aria-selected', String(isPersonal));
      }

      // Update Cards (Active vs Shielded)
      const workCard = this.querySelector('#work-node');
      const personalCard = this.querySelector('#personal-node');

      if (workCard) {
        workCard.classList.toggle('is-active', !isPersonal);
        workCard.classList.toggle('is-shielded', isPersonal);
        const badgeLabel = workCard.querySelector('.status-label');
        if (badgeLabel) {
          badgeLabel.textContent = !isPersonal ? 'ACTIVE IDENTITY' : 'SHIELDED (INACTIVE)';
        }
      }

      if (personalCard) {
        personalCard.classList.toggle('is-active', isPersonal);
        personalCard.classList.toggle('is-shielded', !isPersonal);
        const badgeLabel = personalCard.querySelector('.status-label');
        if (badgeLabel) {
          badgeLabel.textContent = isPersonal ? 'ACTIVE IDENTITY' : 'SHIELDED (INACTIVE)';
        }
      }

      // Update Live Explanation Text
      const expText = this.querySelector('#exp-text');
      if (expText && FOLDER_EXPLANATIONS[env]) {
        expText.innerHTML = FOLDER_EXPLANATIONS[env];
      }
    }

    drawLines() {
      const core = this.querySelector('.core-node');
      const work = this.querySelector('.work-card');
      const personal = this.querySelector('.personal-card');
      const svg = this.querySelector('.connection-lines');
      const workPath = this.querySelector('.work-path');
      const personalPath = this.querySelector('.personal-path');
      
      if (!core || !work || !personal || !svg || !workPath || !personalPath) return;

      const svgRect = svg.getBoundingClientRect();
      const cRect = core.getBoundingClientRect();
      const wRect = work.getBoundingClientRect();
      const pRect = personal.getBoundingClientRect();

      // Center coordinates relative to SVG
      const cx = cRect.left + cRect.width / 2 - svgRect.left;
      const cy = cRect.top + cRect.height / 2 - svgRect.top;
      
      const wx = wRect.left + wRect.width / 2 - svgRect.left;
      const wy = wRect.top + wRect.height / 2 - svgRect.top;
      
      const px = pRect.left + pRect.width / 2 - svgRect.left;
      const py = pRect.top + pRect.height / 2 - svgRect.top;

      const isMobile = window.innerWidth <= 800;

      if (isMobile) {
        const cBottom = cRect.bottom - svgRect.top;
        const wTop = wRect.top - svgRect.top;
        const pTop = pRect.top - svgRect.top;

        const wPathStr = `M ${cx} ${cBottom} L ${wx} ${wTop}`;
        const bypassX = Math.min(svgRect.width - 12, (wRect.right - svgRect.left) + 20);
        const pPathStr = `M ${cx + 15} ${cy} C ${bypassX} ${cy + 25}, ${bypassX} ${wy - 40}, ${bypassX} ${wy} C ${bypassX} ${wy + 40}, ${px + 20} ${pTop - 25}, ${px} ${pTop}`;

        workPath.setAttribute('d', wPathStr);
        personalPath.setAttribute('d', pPathStr);

        document.documentElement.style.setProperty('--work-path', `path('${wPathStr}')`);
        document.documentElement.style.setProperty('--personal-path', `path('${pPathStr}')`);
      } else {
        const wPathStr = `M ${cx} ${cy} C ${cx} ${wy}, ${wx} ${cy}, ${wx} ${wy}`;
        const pPathStr = `M ${cx} ${cy} C ${cx} ${py}, ${px} ${cy}, ${px} ${py}`;

        workPath.setAttribute('d', wPathStr);
        personalPath.setAttribute('d', pPathStr);

        document.documentElement.style.setProperty('--work-path', `path('${wPathStr}')`);
        document.documentElement.style.setProperty('--personal-path', `path('${pPathStr}')`);
      }

      this.querySelectorAll('.data-orb').forEach((orb) => orb.classList.add('active'));
    }
  }

  if (typeof window !== 'undefined' && !customElements.get('visual-capabilities')) {
    customElements.define('visual-capabilities', VisualCapabilities);
  }
</script>
