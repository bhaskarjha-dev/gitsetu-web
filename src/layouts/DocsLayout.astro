---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';

const { frontmatter } = Astro.props;
const currentPath = '/' + Astro.url.pathname.replace(/^\/|\/$/g, '');
const slug = currentPath.replace(/^\//, '');
const ogImageUrl = `https://gitsetu.bhaskarjha.dev/og/${slug || 'index'}.png`;

// Canonical doc list for sequential prev/next pagination across all 24 pages
const docPages = [
  { href: '/docs/overview/introduction', title: 'Introduction', category: 'Platform Overview' },
  { href: '/docs/overview/architecture', title: 'Architecture', category: 'Platform Overview' },
  { href: '/docs/overview/comparisons', title: 'Ecosystem Comparisons', category: 'Platform Overview' },
  { href: '/docs/overview/manifesto', title: 'Design Manifesto', category: 'Platform Overview' },
  { href: '/docs/getting-started/introduction', title: 'Getting Started', category: 'Getting Started' },
  { href: '/docs/getting-started/installation', title: 'Installation', category: 'Getting Started' },
  { href: '/docs/getting-started/quickstart', title: 'Quickstart', category: 'Getting Started' },
  { href: '/docs/core-engines/identity-routing', title: 'Identity Routing', category: 'Core Engines' },
  { href: '/docs/core-engines/ssh-orchestrator', title: 'SSH Orchestrator', category: 'Core Engines' },
  { href: '/docs/core-engines/credential-broker', title: 'Credential Broker', category: 'Core Engines' },
  { href: '/docs/core-engines/precommit-guard', title: 'Pre-Commit Guard', category: 'Core Engines' },
  { href: '/docs/guides/shell-prompt', title: 'Shell Prompt Integration', category: 'Guides' },
  { href: '/docs/guides/hardware-keys', title: 'Hardware Keys (FIDO2)', category: 'Guides' },
  { href: '/docs/guides/wsl-integration', title: 'WSL Integration', category: 'Guides' },
  { href: '/docs/guides/vault-backups', title: 'Vault Backups', category: 'Guides' },
  { href: '/docs/enterprise/security-privacy', title: 'Security & Privacy', category: 'Enterprise & Vision' },
  { href: '/docs/enterprise/product-roadmap', title: 'Product Roadmap', category: 'Enterprise & Vision' },
  { href: '/docs/reference/cli-commands', title: 'CLI Commands', category: 'Reference & Support' },
  { href: '/docs/reference/troubleshooting', title: 'Troubleshooting', category: 'Reference & Support' },
  { href: '/docs/reference/faq', title: 'FAQ', category: 'Reference & Support' },
  { href: '/docs/reference/manual-qa', title: 'Manual QA Playbook', category: 'Reference & Support' },
  { href: '/docs/reference/contributing', title: 'Contributing Guide', category: 'Reference & Support' },
  { href: '/docs/adr/0001-dual-ssh-routing-strategy', title: 'ADR 0001: Dual SSH Routing', category: 'Architecture Decisions' },
  { href: '/docs/adr/0002-ssh-config-include-directive', title: 'ADR 0002: OpenSSH Include Pivot', category: 'Architecture Decisions' }
];

const normalizedCurrent = (currentPath === '/docs' || currentPath === '/docs/index' || currentPath === '/docs/overview/introduction') ? '/docs/overview/introduction' : currentPath;
const currentIndex = docPages.findIndex(p => p.href === normalizedCurrent);
const prevPage = currentIndex > 0 ? docPages[currentIndex - 1] : null;
const nextPage = (currentIndex >= 0 && currentIndex < docPages.length - 1) ? docPages[currentIndex + 1] : null;

// Helper for deterministic active link matching
const isActive = (path: string) => {
  const normPath = '/' + path.replace(/^\/|\/$/g, '');
  return (normalizedCurrent === normPath || (normalizedCurrent === '/docs/overview/introduction' && (normPath === '/docs' || normPath === '/docs/overview/introduction'))) ? 'active' : '';
};

// Breadcrumb Category calculation
const pathSegments = currentPath.split('/').filter(Boolean);
const activeCategory = pathSegments.length > 1 ? pathSegments[1] : 'overview';

const categoryMap: Record<string, string> = {
  'overview': 'Platform Overview',
  'getting-started': 'Getting Started',
  'core-engines': 'Core Engines',
  'guides': 'Guides',
  'enterprise': 'Enterprise & Vision',
  'reference': 'Reference & Support',
  'adr': 'Architecture Decisions'
};
const categoryName = categoryMap[activeCategory] || activeCategory.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

// Compute direct GitHub edit URL based on current path
const docSourceFileMap: Record<string, string> = {
  '/docs': 'docs/overview/introduction.md',
  '/docs/overview/introduction': 'docs/overview/introduction.md',
  '/docs/overview/architecture': 'docs/overview/architecture.md',
  '/docs/overview/comparisons': 'docs/overview/comparisons.md',
  '/docs/overview/manifesto': 'docs/overview/manifesto.md',
  '/docs/getting-started/introduction': 'docs/getting-started/introduction.md',
  '/docs/getting-started/installation': 'docs/getting-started/installation.md',
  '/docs/getting-started/quickstart': 'docs/getting-started/quickstart.md',
  '/docs/core-engines/identity-routing': 'docs/core-engines/identity-routing.md',
  '/docs/core-engines/ssh-orchestrator': 'docs/core-engines/ssh-orchestrator.md',
  '/docs/core-engines/credential-broker': 'docs/core-engines/credential-broker.md',
  '/docs/core-engines/precommit-guard': 'docs/core-engines/precommit-guard.md',
  '/docs/guides/shell-prompt': 'docs/guides/shell-prompt.md',
  '/docs/guides/hardware-keys': 'docs/guides/hardware-keys.md',
  '/docs/guides/wsl-integration': 'docs/guides/wsl-integration.md',
  '/docs/guides/vault-backups': 'docs/guides/vault-backups.md',
  '/docs/enterprise/security-privacy': 'docs/enterprise/security-privacy.md',
  '/docs/enterprise/product-roadmap': 'docs/enterprise/product-roadmap.md',
  '/docs/reference/cli-commands': 'docs/reference/cli-commands.md',
  '/docs/reference/troubleshooting': 'docs/reference/troubleshooting.md',
  '/docs/reference/faq': 'docs/reference/faq.md',
  '/docs/reference/manual-qa': 'docs/MANUAL_QA.md',
  '/docs/reference/contributing': 'CONTRIBUTING.md',
  '/docs/adr/0001-dual-ssh-routing-strategy': 'docs/adr/0001-dual-ssh-routing-strategy.md',
  '/docs/adr/0002-ssh-config-include-directive': 'docs/adr/0002-ssh-config-include-directive.md'
};

const sourceFile = docSourceFileMap[normalizedCurrent] || (normalizedCurrent ? `${normalizedCurrent.replace(/^\/docs\/?/, 'docs/')}.md` : 'docs/overview/introduction.md');
const editUrl = `https://github.com/bhaskarjha-dev/gitsetu/edit/main/${sourceFile}`;
---

<!DOCTYPE html>
<html lang="en" style="color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={frontmatter.description || "GitSetu Documentation"} />
    <title>{frontmatter.title} | GitSetu Docs</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={`https://gitsetu.bhaskarjha.dev${normalizedCurrent === '/docs/overview/introduction' ? '/docs' : normalizedCurrent}`} />
    
    <!-- Fonts: Preconnect & Non-Blocking Async Loading with display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
    </noscript>
    <ClientRouter />

    <!-- Dynamic Open Graph & Twitter -->
    <meta property="og:title" content={`${frontmatter.title} | GitSetu Docs`} />
    <meta property="og:description" content={frontmatter.description || "GitSetu Documentation"} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:url" content={`https://gitsetu.bhaskarjha.dev${normalizedCurrent === '/docs/overview/introduction' ? '/docs' : normalizedCurrent}`} />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${frontmatter.title} | GitSetu Docs`} />
    <meta name="twitter:description" content={frontmatter.description || "GitSetu Documentation"} />
    <meta name="twitter:image" content={ogImageUrl} />
    
    <!-- JSON-LD Semantic Web -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "@id": `https://gitsetu.bhaskarjha.dev${normalizedCurrent}#article`,
      "url": `https://gitsetu.bhaskarjha.dev${normalizedCurrent}`,
      "headline": frontmatter.title,
      "description": frontmatter.description || "GitSetu Documentation",
      "inLanguage": "en",
      "mainEntityOfPage": `https://gitsetu.bhaskarjha.dev${normalizedCurrent}`,
      "author": {
        "@type": "Person",
        "name": "Bhaskar Jha"
      },
      "publisher": {
        "@type": "Organization",
        "name": "GitSetu",
        "url": "https://gitsetu.bhaskarjha.dev"
      }
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "@id": `https://gitsetu.bhaskarjha.dev${normalizedCurrent}#breadcrumbs`,
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://gitsetu.bhaskarjha.dev" },
        { "@type": "ListItem", "position": 2, "name": "Docs", "item": "https://gitsetu.bhaskarjha.dev/docs" },
        ...(categoryName ? [{ "@type": "ListItem", "position": 3, "name": categoryName, "item": `https://gitsetu.bhaskarjha.dev/docs#${activeCategory}` }] : []),
        { "@type": "ListItem", "position": categoryName ? 4 : 3, "name": frontmatter.title, "item": `https://gitsetu.bhaskarjha.dev${normalizedCurrent}` }
      ]
    })} />

    <script defer data-domain="gitsetu.bhaskarjha.dev" src="https://plausible.io/js/script.js"></script>

    <!-- Inline styles to ensure critical media queries and table rules are present directly in static HTML -->
    <style is:inline>
      /* Responsive Table Overflow */
      .markdown-body table {
        display: block;
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-collapse: collapse;
        margin-bottom: var(--space-lg);
      }
      @media (max-width: 768px) {
        .docs-sidebar.mobile-drawer {
          transform: translateX(-100%);
          visibility: hidden;
        }
      }
    </style>
  </head>
  <body>
    <!-- Skip to main content bypass link -->
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <global-manager>
      <!-- Persistent Noise Overlay -->
      <div class="noise-overlay"></div>
      <CommandPalette />

      <Navbar />

      <!-- Mobile Menu Bar Toggle Button -->
      <div class="mobile-menu-bar">
        <button id="mobile-menu-btn" class="mobile-toggle docs-mobile-menu-btn" type="button" aria-label="Toggle documentation menu" aria-expanded="false" aria-controls="docs-sidebar">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
          <span>Documentation Menu</span>
        </button>
      </div>

      <!-- Mobile Drawer Backdrop Overlay -->
      <div id="docs-drawer-backdrop" class="drawer-backdrop" aria-hidden="true"></div>
      
      <div class="docs-container container">
        <!-- Sidebar Navigation -->
        <aside id="docs-sidebar" class="docs-sidebar mobile-drawer" aria-label="Documentation navigation">
          <div class="sidebar-content" id="sidebar-content">
            <div class="sidebar-inner">
              <nav class="sidebar-nav">
                <!-- Command Palette Trigger Button -->
                <button id="docs-sidebar-search-btn" class="search-btn" type="button" aria-label="Search documentation" onclick="document.dispatchEvent(new CustomEvent('open-command-palette'))">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  <span>Search docs...</span>
                  <kbd id="docs-cmd-key">⌘K</kbd>
                </button>

                <!-- Category 1: Platform Overview -->
                <details class="nav-group" data-category="overview" open={activeCategory === 'overview' ? true : undefined}>
                  <summary class="nav-heading">
                    <span>Platform Overview</span>
                    <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </summary>
                  <ul>
                    <li><a href="/docs" class={isActive('/docs')} aria-current={isActive('/docs') ? 'page' : undefined}>Introduction</a></li>
                    <li><a href="/docs/overview/architecture" class={isActive('/docs/overview/architecture')} aria-current={isActive('/docs/overview/architecture') ? 'page' : undefined}>Architecture</a></li>
                    <li><a href="/docs/overview/comparisons" class={isActive('/docs/overview/comparisons')} aria-current={isActive('/docs/overview/comparisons') ? 'page' : undefined}>Ecosystem Comparisons</a></li>
                    <li><a href="/docs/overview/manifesto" class={isActive('/docs/overview/manifesto')} aria-current={isActive('/docs/overview/manifesto') ? 'page' : undefined}>Design Manifesto</a></li>
                  </ul>
                </details>

                <!-- Category 2: Getting Started -->
                <details class="nav-group" data-category="getting-started" open={activeCategory === 'getting-started' ? true : undefined}>
                  <summary class="nav-heading">
                    <span>Getting Started</span>
                    <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </summary>
                  <ul>
                    <li><a href="/docs/getting-started/introduction" class={isActive('/docs/getting-started/introduction')} aria-current={isActive('/docs/getting-started/introduction') ? 'page' : undefined}>Introduction</a></li>
                    <li><a href="/docs/getting-started/installation" class={isActive('/docs/getting-started/installation')} aria-current={isActive('/docs/getting-started/installation') ? 'page' : undefined}>Installation</a></li>
                    <li><a href="/docs/getting-started/quickstart" class={isActive('/docs/getting-started/quickstart')} aria-current={isActive('/docs/getting-started/quickstart') ? 'page' : undefined}>Quickstart</a></li>
                  </ul>
                </details>

                <!-- Category 3: Core Engines -->
                <details class="nav-group" data-category="core-engines" open={activeCategory === 'core-engines' ? true : undefined}>
                  <summary class="nav-heading">
                    <span>Core Engines</span>
                    <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </summary>
                  <ul>
                    <li><a href="/docs/core-engines/identity-routing" class={isActive('/docs/core-engines/identity-routing')} aria-current={isActive('/docs/core-engines/identity-routing') ? 'page' : undefined}>Identity Routing</a></li>
                    <li><a href="/docs/core-engines/ssh-orchestrator" class={isActive('/docs/core-engines/ssh-orchestrator')} aria-current={isActive('/docs/core-engines/ssh-orchestrator') ? 'page' : undefined}>SSH Orchestrator</a></li>
                    <li><a href="/docs/core-engines/credential-broker" class={isActive('/docs/core-engines/credential-broker')} aria-current={isActive('/docs/core-engines/credential-broker') ? 'page' : undefined}>Credential Broker</a></li>
                    <li><a href="/docs/core-engines/precommit-guard" class={isActive('/docs/core-engines/precommit-guard')} aria-current={isActive('/docs/core-engines/precommit-guard') ? 'page' : undefined}>Pre-Commit Guard</a></li>
                  </ul>
                </details>

                <!-- Category 4: Guides -->
                <details class="nav-group" data-category="guides" open={activeCategory === 'guides' ? true : undefined}>
                  <summary class="nav-heading">
                    <span>Guides</span>
                    <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </summary>
                  <ul>
                    <li><a href="/docs/guides/shell-prompt" class={isActive('/docs/guides/shell-prompt')} aria-current={isActive('/docs/guides/shell-prompt') ? 'page' : undefined}>Shell Prompt Integration</a></li>
                    <li><a href="/docs/guides/hardware-keys" class={isActive('/docs/guides/hardware-keys')} aria-current={isActive('/docs/guides/hardware-keys') ? 'page' : undefined}>Hardware Keys (FIDO2)</a></li>
                    <li><a href="/docs/guides/wsl-integration" class={isActive('/docs/guides/wsl-integration')} aria-current={isActive('/docs/guides/wsl-integration') ? 'page' : undefined}>WSL Integration</a></li>
                    <li><a href="/docs/guides/vault-backups" class={isActive('/docs/guides/vault-backups')} aria-current={isActive('/docs/guides/vault-backups') ? 'page' : undefined}>Vault Backups</a></li>
                  </ul>
                </details>

                <!-- Category 5: Enterprise & Vision -->
                <details class="nav-group" data-category="enterprise" open={activeCategory === 'enterprise' ? true : undefined}>
                  <summary class="nav-heading">
                    <span>Enterprise & Vision</span>
                    <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </summary>
                  <ul>
                    <li><a href="/docs/enterprise/security-privacy" class={isActive('/docs/enterprise/security-privacy')} aria-current={isActive('/docs/enterprise/security-privacy') ? 'page' : undefined}>Security & Privacy</a></li>
                    <li><a href="/docs/enterprise/product-roadmap" class={isActive('/docs/enterprise/product-roadmap')} aria-current={isActive('/docs/enterprise/product-roadmap') ? 'page' : undefined}>Product Roadmap</a></li>
                  </ul>
                </details>

                <!-- Category 6: Reference & Support -->
                <details class="nav-group" data-category="reference" open={activeCategory === 'reference' ? true : undefined}>
                  <summary class="nav-heading">
                    <span>Reference & Support</span>
                    <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </summary>
                  <ul>
                    <li><a href="/docs/reference/cli-commands" class={isActive('/docs/reference/cli-commands')} aria-current={isActive('/docs/reference/cli-commands') ? 'page' : undefined}>CLI Commands</a></li>
                    <li><a href="/docs/reference/troubleshooting" class={isActive('/docs/reference/troubleshooting')} aria-current={isActive('/docs/reference/troubleshooting') ? 'page' : undefined}>Troubleshooting</a></li>
                    <li><a href="/docs/reference/faq" class={isActive('/docs/reference/faq')} aria-current={isActive('/docs/reference/faq') ? 'page' : undefined}>FAQ</a></li>
                    <li><a href="/docs/reference/manual-qa" class={isActive('/docs/reference/manual-qa')} aria-current={isActive('/docs/reference/manual-qa') ? 'page' : undefined}>Manual QA Playbook</a></li>
                    <li><a href="/docs/reference/contributing" class={isActive('/docs/reference/contributing')} aria-current={isActive('/docs/reference/contributing') ? 'page' : undefined}>Contributing Guide</a></li>
                  </ul>
                </details>

                <!-- Category 7: Architecture Decisions (ADR - final category) -->
                <details class="nav-group" data-category="adr" open={activeCategory === 'adr' ? true : undefined}>
                  <summary class="nav-heading">
                    <span>Architecture Decisions (ADR)</span>
                    <svg class="chevron-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                  </summary>
                  <ul>
                    <li><a href="/docs/adr/0001-dual-ssh-routing-strategy" class={isActive('/docs/adr/0001-dual-ssh-routing-strategy')} aria-current={isActive('/docs/adr/0001-dual-ssh-routing-strategy') ? 'page' : undefined}>ADR 0001: Dual SSH Routing</a></li>
                    <li><a href="/docs/adr/0002-ssh-config-include-directive" class={isActive('/docs/adr/0002-ssh-config-include-directive')} aria-current={isActive('/docs/adr/0002-ssh-config-include-directive') ? 'page' : undefined}>ADR 0002: OpenSSH Include Pivot</a></li>
                  </ul>
                </details>
              </nav>
            </div>
          </div>
        </aside>
        
        <!-- Main Content -->
        <main id="main-content" class="docs-content markdown-body">
          {currentPath !== '/docs' && (
            <nav class="docs-breadcrumbs" aria-label="Breadcrumbs">
              <a href="/docs">Docs</a>
              {categoryName && (
                <>
                  <span class="crumb-separator">/</span>
                  <span class="crumb-category">{categoryName}</span>
                </>
              )}
              <span class="crumb-separator">/</span>
              <span class="crumb-current" aria-current="page">{frontmatter.title}</span>
            </nav>
          )}
          <slot />

          <!-- Sequential Prev / Next Pagination Cards -->
          <nav class="docs-pagination prev-next-nav" aria-label="Document pagination">
            {prevPage ? (
              <a href={prevPage.href} class="pagination-card pagination-prev" rel="prev">
                <div class="pagination-direction">
                  <svg class="pagination-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                  <span>Previous</span>
                </div>
                <div class="pagination-title">{prevPage.title}</div>
              </a>
            ) : <div class="pagination-spacer" />}

            {nextPage ? (
              <a href={nextPage.href} class="pagination-card pagination-next" rel="next">
                <div class="pagination-direction">
                  <span>Next</span>
                  <svg class="pagination-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                </div>
                <div class="pagination-title">{nextPage.title}</div>
              </a>
            ) : <div class="pagination-spacer" />}
          </nav>
          
          <div class="docs-footer">
            <a href={editUrl} target="_blank" rel="noopener noreferrer" class="edit-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              Edit this page on GitHub
            </a>
          </div>
        </main>

        <!-- Table of Contents Pane -->
        <aside class="docs-toc" aria-label="Table of contents">
          <div class="toc-inner">
            <h4 class="toc-heading">On this page</h4>
            <ul class="toc-list" id="toc-list">
              <li class="toc-placeholder">No headings found.</li>
            </ul>
          </div>
        </aside>
      </div>

      <Footer />
    </global-manager>

    <script>
      let tocObserver: IntersectionObserver | null = null;
      let activeHeadingId = '';

      const setupTOC = () => {
        const tocList = document.getElementById('toc-list');
        const headings = Array.from(document.querySelectorAll('.markdown-body h2, .markdown-body h3')) as HTMLElement[];
        
        if (!tocList) return;

        if (headings.length === 0) {
          tocList.innerHTML = '<li class="toc-placeholder">No headings found.</li>';
          return;
        }

        tocList.innerHTML = '';
        headings.forEach(heading => {
          let headingTitle = '';
          heading.childNodes.forEach(node => {
            if (node.nodeType === Node.TEXT_NODE) {
              headingTitle += node.textContent;
            } else if (node.nodeType === Node.ELEMENT_NODE && !(node as HTMLElement).classList.contains('heading-anchor')) {
              headingTitle += (node as HTMLElement).innerText || node.textContent;
            }
          });
          headingTitle = headingTitle.trim();

          if (!heading.id) {
            heading.id = headingTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || '';
          }
          const li = document.createElement('li');
          li.className = heading.tagName.toLowerCase() === 'h3' ? 'toc-sub' : '';
          const a = document.createElement('a');
          a.href = '#' + heading.id;
          a.textContent = headingTitle || heading.id;
          li.appendChild(a);
          tocList.appendChild(li);
        });

        const updateActiveToc = (targetId: string) => {
          if (!targetId || targetId === activeHeadingId) return;
          activeHeadingId = targetId;
          const links = tocList.querySelectorAll('a');
          links.forEach(link => {
            if (link.getAttribute('href') === `#${targetId}`) {
              link.classList.add('active');
            } else {
              link.classList.remove('active');
            }
          });
        };

        tocObserver?.disconnect();
        tocObserver = new IntersectionObserver((entries) => {
          // Find intersecting headings
          const visible = entries.filter(e => e.isIntersecting);
          if (visible.length > 0) {
            // Pick topmost visible heading
            updateActiveToc(visible[0].target.id);
          }
        }, {
          rootMargin: '0px 0px -65% 0px',
          threshold: 0
        });

        headings.forEach(h => tocObserver?.observe(h));

        // Initial check: if window is near the top, highlight the very first heading
        if (window.scrollY < 100 && headings.length > 0) {
          updateActiveToc(headings[0].id);
        }
      };

      const setupHeadingAnchors = () => {
        const headings = Array.from(document.querySelectorAll('.markdown-body h2, .markdown-body h3')) as HTMLElement[];
        
        headings.forEach(heading => {
          if (heading.querySelector('.heading-anchor')) return;

          let headingTitle = '';
          heading.childNodes.forEach(node => {
            if (node.nodeType === Node.TEXT_NODE) {
              headingTitle += node.textContent;
            } else if (node.nodeType === Node.ELEMENT_NODE && !(node as HTMLElement).classList.contains('heading-anchor')) {
              headingTitle += (node as HTMLElement).innerText || node.textContent;
            }
          });
          headingTitle = headingTitle.trim();

          if (!heading.id) {
            heading.id = headingTitle.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '') || '';
          }
          const headingId = heading.id;
          if (!headingId) return;

          const anchor = document.createElement('a');
          anchor.className = 'heading-anchor';
          anchor.href = `#${headingId}`;
          anchor.setAttribute('aria-label', `Direct link to section ${headingTitle}`);
          anchor.setAttribute('title', 'Copy link to this section');
          anchor.innerHTML = `
            <span class="anchor-hash" aria-hidden="true">#</span>
            <span class="anchor-copied-tooltip" role="status" aria-live="polite">Link copied!</span>
          `;

          let resetTimer: any = null;

          anchor.addEventListener('click', () => {
            const url = new URL(window.location.href);
            url.hash = headingId;
            const fullUrl = url.toString();

            const fallbackCopyText = (text: string) => {
              try {
                const ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.left = '-9999px';
                ta.style.top = '-9999px';
                ta.setAttribute('readonly', '');
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
              } catch {}
            };

            if (navigator.clipboard && window.isSecureContext) {
              navigator.clipboard.writeText(fullUrl).catch(() => {
                fallbackCopyText(fullUrl);
              });
            } else {
              fallbackCopyText(fullUrl);
            }

            anchor.classList.add('copied');
            const announcer = document.getElementById('cmd-announcer');
            if (announcer) {
              announcer.textContent = `Direct link to ${headingTitle} copied to clipboard`;
            }

            if (resetTimer) clearTimeout(resetTimer);
            resetTimer = setTimeout(() => {
              anchor.classList.remove('copied');
            }, 1800);
          });

          heading.appendChild(anchor);
        });
      };

      const scrollActiveSidebarItem = (behavior: ScrollBehavior = 'smooth') => {
        const sidebar = document.getElementById('docs-sidebar');
        if (!sidebar) return;

        const activeLink = sidebar.querySelector('.sidebar-nav a.active') as HTMLElement | null;
        if (!activeLink) return;

        const parentDetails = activeLink.closest('details.nav-group') as HTMLDetailsElement | null;
        if (parentDetails && !parentDetails.open) {
          parentDetails.open = true;
        }

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const actualBehavior = prefersReducedMotion ? 'auto' : behavior;

        requestAnimationFrame(() => {
          const sidebarRect = sidebar.getBoundingClientRect();
          const linkRect = activeLink.getBoundingClientRect();

          const isComfortablyVisible = (
            linkRect.top >= sidebarRect.top + 30 &&
            linkRect.bottom <= sidebarRect.bottom - 30
          );

          if (!isComfortablyVisible) {
            const targetTop = sidebar.scrollTop + (linkRect.top - sidebarRect.top) - (sidebar.clientHeight / 3);
            sidebar.scrollTo({
              top: Math.max(0, targetTop),
              behavior: actualBehavior
            });
          }
        });
      };

      const setupCodeCopyButtons = () => {
        const preBlocks = document.querySelectorAll('.markdown-body pre');
        preBlocks.forEach(pre => {
          if (pre.querySelector('.copy-code-btn')) return;

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'copy-btn copy-code-btn';
          btn.setAttribute('aria-label', 'Copy code to clipboard');
          btn.innerHTML = `
            <svg class="copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            <span class="copy-text">Copy</span>
          `;

          let resetTimer: any = null;

          const fallbackCopy = (text: string) => {
            try {
              const ta = document.createElement('textarea');
              ta.value = text;
              ta.style.position = 'fixed';
              ta.style.left = '-9999px';
              ta.style.top = '-9999px';
              ta.setAttribute('readonly', '');
              document.body.appendChild(ta);
              ta.select();
              document.execCommand('copy');
              document.body.removeChild(ta);
            } catch {}
          };

          btn.addEventListener('click', () => {
            const codeEl = pre.querySelector('code');
            const codeText = (codeEl ? codeEl.innerText : pre.innerText).trim();

            btn.classList.add('copied');
            btn.setAttribute('aria-label', 'Copied to clipboard');
            const textSpan = btn.querySelector('.copy-text');
            if (textSpan) textSpan.textContent = 'Copied!';

            if (resetTimer) clearTimeout(resetTimer);
            resetTimer = setTimeout(() => {
              btn.classList.remove('copied');
              btn.setAttribute('aria-label', 'Copy code to clipboard');
              if (textSpan) textSpan.textContent = 'Copy';
            }, 2000);

            if (navigator.clipboard && window.isSecureContext) {
              navigator.clipboard.writeText(codeText).catch(() => {
                fallbackCopy(codeText);
              });
            } else {
              fallbackCopy(codeText);
            }
          });

          pre.appendChild(btn);
        });
      };

      let drawerAbortController: AbortController | null = null;

      const updatePlatformKeys = () => {
        const docsCmdKey = document.getElementById('docs-cmd-key');
        if (navigator.platform.toUpperCase().indexOf('MAC') < 0 && docsCmdKey) {
          docsCmdKey.textContent = 'Ctrl+K';
        }
      };

      const setupMobileDrawer = () => {
        if (drawerAbortController) {
          drawerAbortController.abort();
        }
        drawerAbortController = new AbortController();
        const { signal } = drawerAbortController;

        const menuBtn = document.getElementById('mobile-menu-btn');
        const sidebar = document.getElementById('docs-sidebar');
        const backdrop = document.getElementById('docs-drawer-backdrop');

        if (!menuBtn || !sidebar || !backdrop) return;

        const openDrawer = () => {
          sidebar.classList.add('active');
          backdrop.classList.add('active');
          backdrop.setAttribute('aria-hidden', 'false');
          menuBtn.setAttribute('aria-expanded', 'true');
          document.body.style.overflow = 'hidden';
          scrollActiveSidebarItem('auto');
          const firstFocusable = (Array.from(sidebar.querySelectorAll('a, button, input, summary, [tabindex]:not([tabindex="-1"])')) as HTMLElement[]).find(el => el.offsetWidth > 0 && el.offsetHeight > 0);
          firstFocusable?.focus();
        };

        const closeDrawer = () => {
          sidebar.classList.remove('active');
          backdrop.classList.remove('active');
          backdrop.setAttribute('aria-hidden', 'true');
          menuBtn.setAttribute('aria-expanded', 'false');
          document.body.style.overflow = '';
          menuBtn.focus();
        };

        menuBtn.addEventListener('click', () => {
          const isOpen = sidebar.classList.contains('active');
          if (isOpen) closeDrawer(); else openDrawer();
        }, { signal });

        backdrop.addEventListener('click', closeDrawer, { signal });

        sidebar.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', closeDrawer, { signal });
        });

        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && sidebar.classList.contains('active')) {
            closeDrawer();
          }
        }, { signal });

        sidebar.addEventListener('keydown', (e: KeyboardEvent) => {
          if (!sidebar.classList.contains('active')) return;
          if (e.key === 'Tab') {
            const focusables = (Array.from(
              sidebar.querySelectorAll('a, button, input, summary, [tabindex]:not([tabindex="-1"])')
            ) as HTMLElement[]).filter(el => el.offsetWidth > 0 && el.offsetHeight > 0);
            if (focusables.length === 0) return;
            const first = focusables[0];
            const last = focusables[focusables.length - 1];
            if (e.shiftKey) {
              if (document.activeElement === first || !sidebar.contains(document.activeElement)) {
                e.preventDefault();
                last.focus();
              }
            } else {
              if (document.activeElement === last || !sidebar.contains(document.activeElement)) {
                e.preventDefault();
                first.focus();
              }
            }
          }
        }, { signal });

        document.addEventListener('keydown', (e: KeyboardEvent) => {
          if (!sidebar.classList.contains('active')) return;
          if (e.key === 'Tab' && !sidebar.contains(document.activeElement)) {
            const focusables = (Array.from(
              sidebar.querySelectorAll('a, button, input, summary, [tabindex]:not([tabindex="-1"])')
            ) as HTMLElement[]).filter(el => el.offsetWidth > 0 && el.offsetHeight > 0);
            if (focusables.length === 0) return;
            e.preventDefault();
            if (e.shiftKey) {
              focusables[focusables.length - 1].focus();
            } else {
              focusables[0].focus();
            }
          }
        }, { signal });
      };

      const setupSidebarPersistence = () => {
        const STORAGE_KEY = 'gitsetu-docs-sidebar-state';
        let savedState: Record<string, boolean> = {};
        try {
          savedState = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
        } catch {}

        const details = document.querySelectorAll('aside details.nav-group');
        details.forEach(detail => {
          const el = detail as HTMLDetailsElement;
          const cat = el.dataset.category;
          // Apply saved state if not active category
          if (cat && savedState[cat] !== undefined && !el.hasAttribute('open')) {
            el.open = savedState[cat];
          }

          el.addEventListener('toggle', () => {
            if (cat) {
              savedState[cat] = el.open;
              try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(savedState));
              } catch {}
            }
          });
        });
      };

      document.addEventListener('astro:page-load', () => {
        updatePlatformKeys();
        setupTOC();
        setupHeadingAnchors();
        setupCodeCopyButtons();
        setupMobileDrawer();
        setupSidebarPersistence();
        scrollActiveSidebarItem('smooth');
      });

      document.addEventListener('astro:before-swap', () => {
        tocObserver?.disconnect();
        tocObserver = null;
        drawerAbortController?.abort();
        drawerAbortController = null;
        document.body.style.overflow = '';
      });
    </script>
  </body>
</html>

