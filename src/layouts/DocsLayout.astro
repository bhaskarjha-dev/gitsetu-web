---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CommandPalette from '../components/CommandPalette.astro';

const { frontmatter } = Astro.props;
const currentPath = '/' + Astro.url.pathname.replace(/^\/|\/$/g, '');
const slug = currentPath.replace(/^\//, '');
const ogImageUrl = `https://gitsetu.bhaskarjha.dev/og/${slug || 'index'}.png`;

// Helper for deterministic active link matching
const isActive = (path: string) => {
  const normPath = '/' + path.replace(/^\/|\/$/g, '');
  return currentPath === normPath ? 'active' : '';
};

// Breadcrumb Category calculation
const pathSegments = currentPath.split('/').filter(Boolean);
let categoryName = '';
if (pathSegments.length > 2) {
  const rawCategory = pathSegments[1];
  const categoryMap: Record<string, string> = {
    'overview': 'Platform Overview',
    'getting-started': 'Getting Started',
    'core-engines': 'Core Engines',
    'guides': 'Guides',
    'enterprise': 'Enterprise & Vision',
    'adr': 'Architecture Decisions',
    'reference': 'Reference & Support'
  };
  categoryName = categoryMap[rawCategory] || rawCategory.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
}

// Compute edit URL based on current path
const editUrl = `https://github.com/bhaskarjha-dev/gitsetu/tree/main/docs`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="GitSetu Documentation" />
    <title>{frontmatter.title} | GitSetu Docs</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <ClientRouter />

    <!-- Dynamic Open Graph -->
    <meta property="og:title" content={`${frontmatter.title} | GitSetu Docs`} />
    <meta property="og:description" content={frontmatter.description || "GitSetu Documentation"} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:image" content={ogImageUrl} />
    
    <!-- JSON-LD Semantic Web -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": frontmatter.title,
      "description": frontmatter.description || "GitSetu Documentation",
      "author": {
        "@type": "Person",
        "name": "Bhaskar Jha"
      }
    })} />

    <script defer data-domain="gitsetu.bhaskarjha.dev" src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <global-manager>
      <!-- Persistent Noise Overlay -->
      <div class="noise-overlay"></div>
      <CommandPalette />
      <Navbar />
      
      <div class="docs-container container">
        <!-- Sidebar Navigation -->
        <aside class="docs-sidebar">
          <button id="docs-mobile-menu-btn" class="docs-mobile-menu-btn" aria-expanded="false" aria-controls="sidebar-content">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
            Documentation Menu
          </button>
          <div class="sidebar-content" id="sidebar-content">
            <div class="sidebar-inner">
              <nav class="sidebar-nav">
            <!-- Optional Command Palette Mockup Trigger -->
            <button class="search-btn" onclick="document.dispatchEvent(new CustomEvent('open-command-palette'))">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              <span>Search docs...</span>
              <kbd>⌘K</kbd>
            </button>

            <div class="nav-group">
              <h3 class="nav-heading">Platform Overview</h3>
              <ul>
                <li><a href="/docs" class={isActive('/docs')}>Introduction</a></li>
                <li><a href="/docs/overview/architecture" class={isActive('/docs/overview/architecture')}>Architecture</a></li>
                <li><a href="/docs/overview/comparisons" class={isActive('/docs/overview/comparisons')}>Ecosystem Comparisons</a></li>
                <li><a href="/docs/overview/manifesto" class={isActive('/docs/overview/manifesto')}>Design Manifesto</a></li>
              </ul>
            </div>
            <div class="nav-group">
              <h3 class="nav-heading">Getting Started</h3>
              <ul>
                <li><a href="/docs/getting-started/introduction" class={isActive('/docs/getting-started/introduction')}>Introduction</a></li>
                <li><a href="/docs/getting-started/installation" class={isActive('/docs/getting-started/installation')}>Installation</a></li>
                <li><a href="/docs/getting-started/quickstart" class={isActive('/docs/getting-started/quickstart')}>Quickstart</a></li>
              </ul>
            </div>
            <div class="nav-group">
              <h3 class="nav-heading">Core Engines</h3>
              <ul>
                <li><a href="/docs/core-engines/identity-routing" class={isActive('/docs/core-engines/identity-routing')}>Identity Routing</a></li>
                <li><a href="/docs/core-engines/ssh-orchestrator" class={isActive('/docs/core-engines/ssh-orchestrator')}>SSH Orchestrator</a></li>
                <li><a href="/docs/core-engines/credential-broker" class={isActive('/docs/core-engines/credential-broker')}>Credential Broker</a></li>
                <li><a href="/docs/core-engines/precommit-guard" class={isActive('/docs/core-engines/precommit-guard')}>Pre-Commit Guard</a></li>
              </ul>
            </div>
            <div class="nav-group">
              <h3 class="nav-heading">Guides</h3>
              <ul>
                <li><a href="/docs/guides/shell-prompt" class={isActive('/docs/guides/shell-prompt')}>Shell Prompt Integration</a></li>
                <li><a href="/docs/guides/hardware-keys" class={isActive('/docs/guides/hardware-keys')}>Hardware Keys (FIDO2)</a></li>
                <li><a href="/docs/guides/wsl-integration" class={isActive('/docs/guides/wsl-integration')}>WSL Integration</a></li>
                <li><a href="/docs/guides/vault-backups" class={isActive('/docs/guides/vault-backups')}>Vault Backups</a></li>
              </ul>
            </div>
            <div class="nav-group">
              <h3 class="nav-heading">Enterprise & Vision</h3>
              <ul>
                <li><a href="/docs/enterprise/security-privacy" class={isActive('/docs/enterprise/security-privacy')}>Security & Privacy</a></li>
                <li><a href="/docs/enterprise/product-roadmap" class={isActive('/docs/enterprise/product-roadmap')}>Product Roadmap</a></li>
              </ul>
            </div>
            <div class="nav-group">
              <h3 class="nav-heading">Architecture Decisions</h3>
              <ul>
                <li><a href="/docs/adr/0001-dual-ssh-routing-strategy" class={isActive('/docs/adr/0001-dual-ssh-routing-strategy')}>ADR 0001: Dual SSH Routing</a></li>
                <li><a href="/docs/adr/0002-ssh-config-include-directive" class={isActive('/docs/adr/0002-ssh-config-include-directive')}>ADR 0002: OpenSSH Include Pivot</a></li>
              </ul>
            </div>
            <div class="nav-group">
              <h3 class="nav-heading">Reference & Support</h3>
              <ul>
                <li><a href="/docs/reference/cli-commands" class={isActive('/docs/reference/cli-commands')}>CLI Commands</a></li>
                <li><a href="/docs/reference/troubleshooting" class={isActive('/docs/reference/troubleshooting')}>Troubleshooting</a></li>
                <li><a href="/docs/reference/faq" class={isActive('/docs/reference/faq')}>FAQ</a></li>
                <li><a href="/docs/reference/manual-qa" class={isActive('/docs/reference/manual-qa')}>Manual QA Playbook</a></li>
                <li><a href="/docs/reference/contributing" class={isActive('/docs/reference/contributing')}>Contributing Guide</a></li>
              </ul>
            </div>
          </nav>
            </div>
          </div>
        </aside>
        
        <!-- Main Content -->
        <main class="docs-content markdown-body">
          {currentPath !== '/docs' && (
            <nav class="docs-breadcrumbs" aria-label="Breadcrumbs">
              <a href="/docs">Docs</a>
              {categoryName && (
                <>
                  <span class="crumb-separator">/</span>
                  <span class="crumb-category">{categoryName}</span>
                </>
              )}
              <span class="crumb-separator">/</span>
              <span class="crumb-current" aria-current="page">{frontmatter.title}</span>
            </nav>
          )}
          <slot />
          
          <div class="docs-footer">
            <a href={editUrl} target="_blank" rel="noopener noreferrer" class="edit-link">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
              Edit this page on GitHub
            </a>
          </div>
        </main>

        <!-- Optional Table of Contents Pane (Fluid 3-column) -->
        <aside class="docs-toc">
          <div class="toc-inner">
            <h4 class="toc-heading">On this page</h4>
            <ul class="toc-list" id="toc-list">
              <!-- Dynamically populated via script below if needed, or left empty as a placeholder for structural balance -->
              <li class="toc-placeholder">No headings found.</li>
            </ul>
          </div>
        </aside>
      </div>

      <Footer />
    </global-manager>

    <script>
      let toggleHandler: (() => void) | null = null;
      let linkHandlers: Array<{ el: Element; handler: () => void }> = [];
      let docsMenuBtn: HTMLElement | null = null;

      document.addEventListener('astro:page-load', () => {
        // Simple TOC generator for h2 and h3
        const tocList = document.getElementById('toc-list');
        const headings = document.querySelectorAll('.markdown-body h2, .markdown-body h3');
        
        if (headings.length > 0 && tocList) {
          tocList.innerHTML = '';
          headings.forEach(heading => {
            if (!heading.id) {
              heading.id = heading.textContent?.toLowerCase().replace(/[^a-z0-9]+/g, '-') || '';
            }
            const li = document.createElement('li');
            li.className = heading.tagName.toLowerCase() === 'h3' ? 'toc-sub' : '';
            const a = document.createElement('a');
            a.href = '#' + heading.id;
            a.textContent = heading.textContent;
            li.appendChild(a);
            tocList.appendChild(li);
          });
        }

        // Docs Mobile Menu Toggle
        docsMenuBtn = document.getElementById('docs-mobile-menu-btn');
        const sidebarContent = document.getElementById('sidebar-content');
        
        if (docsMenuBtn && sidebarContent) {
          toggleHandler = () => {
            const isActive = sidebarContent.classList.toggle('active');
            docsMenuBtn?.setAttribute('aria-expanded', String(isActive));
          };
          docsMenuBtn.addEventListener('click', toggleHandler);

          // Auto-close docs menu when clicking a link inside it
          sidebarContent.querySelectorAll('a').forEach(a => {
            const h = () => {
              sidebarContent.classList.remove('active');
              docsMenuBtn?.setAttribute('aria-expanded', 'false');
            };
            a.addEventListener('click', h);
            linkHandlers.push({ el: a, handler: h });
          });
        }
      });

      document.addEventListener('astro:before-swap', () => {
        if (docsMenuBtn && toggleHandler) {
          docsMenuBtn.removeEventListener('click', toggleHandler);
        }
        linkHandlers.forEach(({ el, handler }) => {
          el.removeEventListener('click', handler);
        });
        linkHandlers = [];
        toggleHandler = null;
        docsMenuBtn = null;
      });
    </script>
  </body>
</html>

<style is:global>
  /* Fluid Architecture for Docs */
  .docs-container {
    display: grid;
    /* 3 column layout: 250px sidebar, 1fr content, 200px toc */
    grid-template-columns: 250px minmax(0, 1fr) 200px;
    gap: var(--space-2xl);
    padding-top: calc(var(--nav-height) + var(--space-xl));
    padding-bottom: var(--space-4xl);
    align-items: start;
    min-height: 100vh;
  }

  /* Sidebar styling */
  .docs-sidebar {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-xl));
    /* Allow sidebar to scroll internally if very tall, without forcing the whole page */
    max-height: calc(100vh - var(--nav-height) - var(--space-2xl));
    overflow-y: auto;
    padding-right: var(--space-md);
    /* Hide scrollbar visually but allow scroll */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .docs-sidebar::-webkit-scrollbar {
    display: none;
  }

  .docs-mobile-menu-btn {
    display: none;
  }

  .search-btn {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    width: 100%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-sm) var(--space-md);
    color: var(--text-secondary);
    font-size: var(--text-sm);
    cursor: pointer;
    margin-bottom: var(--space-xl);
    transition: all var(--transition-fast);
  }
  .search-btn:hover {
    background: rgba(255, 255, 255, 0.08);
    color: var(--text-heading);
    border-color: var(--border-card);
  }
  .search-btn kbd {
    margin-left: auto;
    background: var(--bg-primary);
    border: 1px solid var(--border-subtle);
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 10px;
    font-family: var(--font-mono);
  }

  .nav-group {
    margin-bottom: var(--space-xl);
  }

  .nav-heading {
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: var(--space-sm);
  }

  .sidebar-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-nav li {
    margin-bottom: 2px;
  }

  .sidebar-nav a {
    display: block;
    padding: 6px var(--space-sm);
    color: var(--text-secondary);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
    font-size: var(--text-sm);
    margin-left: calc(var(--space-sm) * -1);
    border-left: 2px solid transparent;
  }

  .sidebar-nav a:hover {
    color: var(--text-heading);
    background: rgba(255, 255, 255, 0.03);
    border-left-color: rgba(255, 255, 255, 0.1);
  }

  .sidebar-nav a.active {
    color: var(--text-heading);
    background: rgba(255, 255, 255, 0.05);
    font-weight: 500;
    border-left-color: var(--accent-primary);
  }

  /* Content area */
  .docs-content {
    min-width: 0; /* Prevents grid blowout */
    container-type: inline-size;
  }

  /* Breadcrumbs */
  .docs-breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    font-family: var(--font-mono);
    color: var(--text-muted);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-xs);
  }

  .docs-breadcrumbs a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .docs-breadcrumbs a:hover {
    color: var(--accent-primary);
  }

  .crumb-separator {
    color: var(--border-subtle);
    user-select: none;
  }

  .crumb-category {
    color: var(--text-muted);
  }

  .crumb-current {
    color: var(--accent-primary);
    font-weight: 500;
  }

  global-manager {
    display: contents;
  }

  .docs-footer {
    margin-top: var(--space-4xl);
    padding-top: var(--space-xl);
    border-top: 1px solid var(--border-subtle);
  }

  .edit-link {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    color: var(--text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .edit-link:hover {
    color: var(--text-heading);
  }

  /* Table of Contents */
  .docs-toc {
    position: sticky;
    top: calc(var(--nav-height) + var(--space-xl));
    max-height: calc(100vh - var(--nav-height) - var(--space-2xl));
    overflow-y: auto;
  }

  .toc-inner {
    border-left: 1px solid var(--border-subtle);
    padding-left: var(--space-md);
  }

  .toc-heading {
    font-size: var(--text-sm);
    font-weight: 600;
    margin-bottom: var(--space-sm);
    color: var(--text-heading);
  }

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-list li {
    margin-bottom: 8px;
  }
  
  .toc-list li.toc-sub {
    padding-left: var(--space-md);
  }

  .toc-list a {
    color: var(--text-secondary);
    font-size: 13px;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .toc-list a:hover {
    color: var(--text-heading);
  }

  .toc-placeholder {
    color: var(--text-muted);
    font-size: 13px;
    font-style: italic;
  }

  /* Container Query responsive adjustments */
  @media (max-width: 1024px) {
    .docs-container {
      grid-template-columns: 220px minmax(0, 1fr); /* Hide TOC on medium screens */
    }
    .docs-toc {
      display: none;
    }
  }

  @media (max-width: 768px) {
    .docs-container {
      grid-template-columns: 1fr;
    }
    .docs-sidebar {
      position: relative;
      top: 0;
      max-height: none;
      border-right: none;
      border-bottom: 1px solid var(--border-subtle);
      padding-right: 0;
      padding-bottom: var(--space-lg);
      margin-bottom: var(--space-lg);
    }
    .docs-mobile-menu-btn {
      display: flex;
      align-items: center;
      gap: var(--space-sm);
      width: 100%;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: var(--space-md);
      color: var(--text-primary);
      font-size: var(--text-base);
      font-weight: 600;
      cursor: pointer;
    }
    .sidebar-content {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows var(--transition-base), margin-top var(--transition-base);
      margin-top: 0;
    }
    .sidebar-inner {
      overflow: hidden;
    }
    .sidebar-content.active {
      grid-template-rows: 1fr;
      margin-top: var(--space-lg);
    }
  }

  /* Markdown Typography overrides (Fluid) */
  .markdown-body h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-lg);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--border-subtle);
  }

  .markdown-body h2 {
    font-size: var(--text-2xl);
    margin-top: var(--space-3xl);
    margin-bottom: var(--space-md);
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--border-subtle);
  }

  .markdown-body h3 {
    font-size: var(--text-xl);
    margin-top: var(--space-2xl);
    margin-bottom: var(--space-sm);
  }

  .markdown-body p {
    margin-bottom: var(--space-lg);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .markdown-body ul, .markdown-body ol {
    margin-bottom: var(--space-lg);
    padding-left: var(--space-xl);
    color: var(--text-secondary);
  }

  .markdown-body li {
    margin-bottom: var(--space-xs);
    line-height: 1.6;
  }

  .markdown-body a {
    color: var(--text-heading);
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.2);
    text-underline-offset: 2px;
  }

  .markdown-body a:hover {
    text-decoration-color: var(--text-heading);
  }

  .markdown-body code {
    background: var(--bg-code);
    padding: 0.2em 0.4em;
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: 0.85em;
    color: var(--text-heading);
    border: 1px solid var(--border-subtle);
  }

  .markdown-body pre {
    background: var(--bg-secondary);
    padding: var(--space-lg) var(--space-lg) var(--space-md) var(--space-lg);
    border-radius: var(--radius-lg);
    overflow-x: auto;
    margin-bottom: var(--space-lg);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    position: relative;
    padding-top: 40px; /* Space for macos dots */
  }

  .markdown-body pre::before {
    content: '';
    position: absolute;
    top: 14px;
    left: 16px;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 18px 0 0 #f59e0b, 36px 0 0 #10b981;
  }

  .markdown-body pre code {
    background: transparent;
    padding: 0;
    color: inherit;
    font-size: var(--text-sm);
    border: none;
  }

  /* Standard Blockquote Styling */
  .markdown-body blockquote {
    padding: var(--space-md) var(--space-lg);
    margin-bottom: var(--space-lg);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    background: rgba(255, 255, 255, 0.02);
    border-left: 4px solid var(--accent-primary);
  }

  .markdown-body table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-lg);
  }

  .markdown-body th, .markdown-body td {
    padding: var(--space-sm);
    border: 1px solid var(--border-subtle);
    text-align: left;
    color: var(--text-secondary);
  }

  .markdown-body th {
    background: var(--bg-tertiary);
    color: var(--text-heading);
    font-weight: 600;
  }

  .markdown-body img {
    max-width: 100%;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }
</style>
