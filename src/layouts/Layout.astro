---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import CommandPalette from '../components/CommandPalette.astro';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = 'GitSetu — Zero-Dependency Git Identity Manager',
  description = 'Manage multiple Git identities automatically. SSH keys, credentials, and commit signing — all in pure Bash 3.2. Zero dependencies.',
  canonical = 'https://gitsetu.bhaskarjha.dev'
} = Astro.props;
---

<!doctype html>
<html lang="en" style="color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- OpenGraph & Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://gitsetu.bhaskarjha.dev/og-image.png" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://gitsetu.bhaskarjha.dev/og-image.png" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Critical CSS for FOWT Elimination & Progressive Reveal Fallback -->
    <style is:inline>
      html, body {
        background-color: var(--bg-primary, #000000);
        color: var(--text-primary, #ededed);
      }
      @media (max-width: 768px) {
        html { -webkit-text-size-adjust: 100%; }
      }
      @media (max-width: 375px) {
        html { -webkit-text-size-adjust: 100%; }
      }
    </style>
    <noscript>
      <style>
        .reveal {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>

    <!-- Fonts: Preconnect & Non-Blocking Async Loading with display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" />
    </noscript>
    <ClientRouter />
    
    <!-- JSON-LD Semantic Web -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "@id": "https://gitsetu.bhaskarjha.dev/#website",
        "url": "https://gitsetu.bhaskarjha.dev",
        "name": "GitSetu",
        "description": "Zero-dependency Git multi-identity orchestration engine",
        "inLanguage": "en"
      }
    </script>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "@id": "https://gitsetu.bhaskarjha.dev/#software",
        "name": "GitSetu",
        "operatingSystem": "POSIX (Linux, macOS, WSL)",
        "applicationCategory": "DeveloperApplication",
        "softwareVersion": "1.0.0",
        "softwareRequirements": "Bash 3.2+",
        "offers": {
          "@type": "Offer",
          "price": "0.00",
          "priceCurrency": "USD"
        },
        "description": "Zero-dependency orchestration engine that automatically routes SSH keys and credentials based on your directory. Enforces Zero-Trust identity for developers.",
        "url": "https://gitsetu.bhaskarjha.dev",
        "downloadUrl": "https://gitsetu.bhaskarjha.dev/install"
      }
    </script>

    <script defer data-domain="gitsetu.bhaskarjha.dev" src="https://plausible.io/js/script.js"></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <global-manager>
      <!-- Persistent Noise Overlay -->
      <div class="noise-overlay"></div>
      <slot />
      <CommandPalette />
    </global-manager>
    
    <script>
      class GlobalManager extends HTMLElement {
        private revealObserver: IntersectionObserver | null = null;
        private mouseMovePending = false;
        
        private handleMousemove = (e: MouseEvent) => {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (this.mouseMovePending) return;
          this.mouseMovePending = true;
          requestAnimationFrame(() => {
            const x = (e.clientX / window.innerWidth) * 100;
            const y = (e.clientY / window.innerHeight) * 100;
            document.body.style.setProperty('--mouse-x', `${x}%`);
            document.body.style.setProperty('--mouse-y', `${y}%`);
            this.mouseMovePending = false;
          });
        };

        private initRevealObserver = () => {
          if (this.revealObserver) {
            this.revealObserver.disconnect();
          }

          const revealElements = this.querySelectorAll('.reveal');
          this.revealObserver = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
              if (entry.isIntersecting) {
                entry.target.classList.add('active');
              }
            });
          }, {
            root: null,
            threshold: 0.05,
            rootMargin: "0px 0px 50px 0px"
          });

          revealElements.forEach(el => this.revealObserver?.observe(el));
        };

        connectedCallback() {
          // Spotlight Logic with rAF throttling
          document.addEventListener('mousemove', this.handleMousemove, { passive: true });

          // Global Reveal on Scroll
          this.initRevealObserver();

          // Re-bind when navigating with ClientRouter
          document.addEventListener('astro:page-load', this.initRevealObserver);
        }

        disconnectedCallback() {
          document.removeEventListener('mousemove', this.handleMousemove);
          document.removeEventListener('astro:page-load', this.initRevealObserver);
          if (this.revealObserver) {
            this.revealObserver.disconnect();
            this.revealObserver = null;
          }
        }
      }

      if (typeof window !== 'undefined' && !customElements.get('global-manager')) {
        customElements.define('global-manager', GlobalManager);
      }
    </script>
    <style>
      global-manager {
        display: contents; /* Does not affect layout flow */
      }
    </style>
  </body>
</html>
